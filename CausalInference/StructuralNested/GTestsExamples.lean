module

public import CausalInference.StructuralNested.GTests

/-!
# Roots of the log-rank g-statistic in small samples

Two samples of uncensored data `(T^c, T^e)` showing how the log-rank g-statistic
`ψ ↦ logRank (U(ψ) of the experimental arm) (U(ψ) of the control arm)` behaves in finite samples
(TSD 24, Section 4.2.1: "there may be multiple values for ψ that result in a zero z-test
statistic"; TSD 16, Appendix A: "the point estimate of ψ is that for which the test (z)
statistic equals zero").

## Main results

* `MultipleRoots.sign_changes`: the sample of
  `RPSFTMCounterexample.Wilcoxon` (two experimental and two control patients, generated by the
  model with time ratio `1/2`). The log-rank g-statistic is `-1/3` at `ψ = log (1/12)`, `2/3` at
  `ψ = log (1/5)`, exactly `0` at the true `ψ = log (1/2)` (the arms have the same untreated
  times there), and `-1/3` at `ψ = 0`. So it changes sign twice, once at the true value.
* `NoRoot.no_root`, `NoRoot.sign_change`: a sample of two experimental and one control patient
  in which the log-rank g-statistic is never zero, for any `ψ`, but is positive at
  `ψ = log (1/4)` and negative at `ψ = 0`. The statistic is piecewise constant
  (`GTest.gStat_congr_order`) and jumps over zero, so an exact root need not exist and the
  defining equation "test statistic equals zero" can have no solution. The documents print no
  rule for this case; TSD 24 mentions only averaging when there are several solutions.

## Sources

N. R. Latimer, K. R. Abrams, *NICE DSU Technical Support Document 16* (2014), Appendix A;
H. Bell Gorrod, N. R. Latimer, K. R. Abrams, *NICE DSU Technical Support Document 24* (2024),
Section 4.2.1.
-/

@[expose] public section

open Finset

namespace CausalInference

namespace StructuralNested

namespace GTestExample

open GTest

/-- The log-rank g-statistic is the risk-set weighted statistic with weight `1` at the candidate
untreated times. -/
theorem logRank_gStat_eq {m n : ℕ} (E : Fin m → ℝ × ℝ) (C : Fin n → ℝ × ℝ) (ψ : ℝ) :
    gStat logRank E C ψ = riskWeighted (fun _ _ ↦ 1) (fun i ↦ untreated ψ (E i))
      (fun j ↦ untreated ψ (C j)) := rfl

namespace MultipleRoots

open RPSFTMCounterexample.Wilcoxon

theorem at_one_twelfth : gStat logRank expSample ctrlSample (Real.log (1 / 12)) = -1 / 3 := by
  rw [logRank_gStat_eq, riskWeighted_eq_sum]
  simp only [oe, atRisk_eq_sum, deaths_eq_sum, Fin.sum_univ_two, untreated, expSample,
    ctrlSample, Real.exp_log (show (0 : ℝ) < 1 / 12 by norm_num)]
  norm_num

theorem at_one_fifth : gStat logRank expSample ctrlSample (Real.log (1 / 5)) = 2 / 3 := by
  rw [logRank_gStat_eq, riskWeighted_eq_sum]
  simp only [oe, atRisk_eq_sum, deaths_eq_sum, Fin.sum_univ_two, untreated, expSample,
    ctrlSample, Real.exp_log (show (0 : ℝ) < 1 / 5 by norm_num)]
  norm_num

theorem at_one : gStat logRank expSample ctrlSample 0 = -1 / 3 := by
  rw [logRank_gStat_eq, riskWeighted_eq_sum]
  simp only [oe, atRisk_eq_sum, deaths_eq_sum, Fin.sum_univ_two, untreated, expSample,
    ctrlSample, Real.exp_zero]
  norm_num

/-- At the true value the two arms have the same untreated times `2, 3`, so the statistic is
zero by `GTest.weightedLogRank_eq_zero_of_equiv`. -/
theorem at_truth : gStat logRank expSample ctrlSample (Real.log (1 / 2)) = 0 := by
  refine weightedLogRank_eq_zero_of_equiv _ _ _ (Equiv.refl _) fun i ↦ ?_
  fin_cases i <;>
    norm_num [untreated, expSample, ctrlSample, Real.exp_log (show (0 : ℝ) < 1 / 2 by norm_num)]

/-- **Two sign changes, one at the truth.** The log-rank g-statistic is negative at
`log (1/12)`, positive at `log (1/5)`, zero at the true `log (1/2)` and negative at `0`, with
`log (1/12) < log (1/5) < log (1/2) < 0`. -/
theorem sign_changes :
    gStat logRank expSample ctrlSample (Real.log (1 / 12)) < 0 ∧
      0 < gStat logRank expSample ctrlSample (Real.log (1 / 5)) ∧
      gStat logRank expSample ctrlSample (Real.log (1 / 2)) = 0 ∧
      gStat logRank expSample ctrlSample 0 < 0 ∧
      Real.log (1 / 12) < Real.log (1 / 5) ∧ Real.log (1 / 5) < Real.log (1 / 2) ∧
      Real.log (1 / 2) < 0 := by
  refine ⟨by rw [at_one_twelfth]; norm_num, by rw [at_one_fifth]; norm_num, at_truth,
    by rw [at_one]; norm_num, Real.log_lt_log (by norm_num) (by norm_num),
    Real.log_lt_log (by norm_num) (by norm_num), Real.log_neg (by norm_num) (by norm_num)⟩

end MultipleRoots

namespace NoRoot

/-- Experimental patients: fully treated, `(T^c, T^e) = (0, 1)` and `(0, 2)`. -/
noncomputable def expSample : Fin 2 → ℝ × ℝ := ![(0, 1), (0, 2)]

/-- Control patient: never treated, `(T^c, T^e) = (1, 0)`. -/
noncomputable def ctrlSample : Fin 1 → ℝ × ℝ := ![(1, 0)]

/-- The log-rank g-statistic at time ratio `x > 0`, where the untreated times are `x`, `2 x`
against `1`, takes five values according to the order of `x`, `2 x` and `1`. -/
theorem stat_values {x : ℝ} (hx : 0 < x) :
    (x < 1 / 2 → gStat logRank expSample ctrlSample (Real.log x) = 5 / 6) ∧
    (x = 1 / 2 → gStat logRank expSample ctrlSample (Real.log x) = 1 / 3) ∧
    (1 / 2 < x → x < 1 → gStat logRank expSample ctrlSample (Real.log x) = -1 / 6) ∧
    (x = 1 → gStat logRank expSample ctrlSample (Real.log x) = -1 / 3) ∧
    (1 < x → gStat logRank expSample ctrlSample (Real.log x) = -2 / 3) := by
  have e : gStat logRank expSample ctrlSample (Real.log x) =
      riskWeighted (fun _ _ ↦ 1) ![x, 2 * x] ![1] := by
    rw [logRank_gStat_eq]
    congr 1 <;> funext i <;> fin_cases i <;>
      simp [untreated, expSample, ctrlSample, Real.exp_log hx, mul_comm]
  have h1 : x ≤ 2 * x := by linarith
  have h2 : ¬ 2 * x ≤ x := by linarith
  have h3 : x ≠ 2 * x := by intro h; linarith
  have h4 : 2 * x ≠ x := by intro h; linarith
  rw [e, riskWeighted_eq_sum]
  simp only [oe, atRisk_eq_sum, deaths_eq_sum, Fin.sum_univ_two, Fin.sum_univ_one,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, h1, h2, h3, h4,
    ite_true, ite_false]
  refine ⟨fun hlt ↦ ?_, fun heq ↦ ?_, fun hlt hgt ↦ ?_, fun heq ↦ ?_, fun hgt ↦ ?_⟩
  · have a1 : x ≤ 1 := by linarith
    have a2 : ¬ 1 ≤ x := by linarith
    have a3 : 2 * x ≤ 1 := by linarith
    have a4 : ¬ 1 ≤ 2 * x := by linarith
    have a5 : x ≠ 1 := by intro h; linarith
    have a6 : 2 * x ≠ 1 := by intro h; linarith
    simp [a1, a2, a3, a4, a5, a6, Ne.symm a5, Ne.symm a6]
    norm_num
  · subst heq
    norm_num
  · have a1 : x ≤ 1 := by linarith
    have a2 : ¬ 1 ≤ x := by linarith
    have a3 : ¬ 2 * x ≤ 1 := by linarith
    have a4 : 1 ≤ 2 * x := by linarith
    have a5 : x ≠ 1 := by intro h; linarith
    have a6 : 2 * x ≠ 1 := by intro h; linarith
    simp [a1, a2, a3, a4, a5, a6, Ne.symm a5, Ne.symm a6]
    norm_num
  · subst heq
    norm_num
  · have a1 : ¬ x ≤ 1 := by linarith
    have a2 : 1 ≤ x := by linarith
    have a3 : ¬ 2 * x ≤ 1 := by linarith
    have a4 : 1 ≤ 2 * x := by linarith
    have a5 : x ≠ 1 := by intro h; linarith
    have a6 : 2 * x ≠ 1 := by intro h; linarith
    simp [a1, a2, a3, a4, a5, a6, Ne.symm a5, Ne.symm a6]
    norm_num

/-- **No exact root.** The log-rank g-statistic of this sample is nonzero at every `ψ`. -/
theorem no_root (ψ : ℝ) : gStat logRank expSample ctrlSample ψ ≠ 0 := by
  have hx := Real.exp_pos ψ
  have v := stat_values hx
  rw [Real.log_exp] at v
  rcases lt_trichotomy (Real.exp ψ) (1 / 2) with h | h | h
  · rw [v.1 h]; norm_num
  · rw [v.2.1 h]; norm_num
  rcases lt_trichotomy (Real.exp ψ) 1 with h' | h' | h'
  · rw [v.2.2.1 h h']; norm_num
  · rw [v.2.2.2.1 h']; norm_num
  · rw [v.2.2.2.2 h']; norm_num

/-- **A sign change without a root.** The statistic is `5/6` at `ψ = log (1/4)` and `-1/3` at
`ψ = 0`. -/
theorem sign_change :
    0 < gStat logRank expSample ctrlSample (Real.log (1 / 4)) ∧
      gStat logRank expSample ctrlSample 0 < 0 := by
  constructor
  · rw [((stat_values (show (0 : ℝ) < 1 / 4 by norm_num)).1 (by norm_num))]; norm_num
  · rw [← Real.log_one, (stat_values one_pos).2.2.2.1 rfl]; norm_num

/-- The first stage is nonzero: mean time on the experimental treatment `3/2` against `0`. -/
theorem firstStage : ((expSample 0).2 + (expSample 1).2) / 2 ≠ (ctrlSample 0).2 := by
  norm_num [expSample, ctrlSample]

end NoRoot

end GTestExample

end StructuralNested

end CausalInference
