public import CausalInference.MissingData.Basic

/-!
# Missingness mechanisms: MCAR, MAR, MNAR

Rubin's (1976) classification of missingness mechanisms, stated with Mathlib independence and
conditional independence, together with a mean-independence form of MAR that is what the
weighting identities use.

## Setting

A measurable space `Ω` with a finite measure `μ`, a covariate `X : Ω → 𝒳`, an outcome
`Y : Ω → ℝ`, and a response indicator `R : Ω → Bool`.

## Main definitions

* `MCAR μ X Y R`: missing completely at random, `R ⫫ (X, Y)` (`ProbabilityTheory.IndepFun`).
* `MAR μ hX R Y`: missing at random, `R ⫫ Y | X` (`ProbabilityTheory.CondIndepFun` given the
  σ-algebra generated by `X`; it needs `StandardBorelSpace Ω`).
* `MNAR μ hX R Y`: missing not at random, the negation of `MAR` (the full conditional
  independence form).
* `MARMean μ X Y R`: the mean-independence form of MAR,
  `E[1{R} | X, Y] = E[1{R} | X]` almost everywhere. It is implied by `MAR` (`MAR.marMean`).
  Since `R` is Boolean the two forms are mathematically equivalent, but only the implication
  from `MAR` is proved here.

## Main results

* `MCAR.marMean`: MCAR implies the mean form of MAR.
* `MCAR.mar`: MCAR implies the full conditional independence form of MAR.
* `MAR.marMean`: the full conditional independence form of MAR implies the mean form.
* `MNAR.not_mcar`: an MNAR mechanism is not MCAR.
* `MCAR.completeCaseMean_eq`: under MCAR, with `μ {R = true} ≠ 0` and `Y` integrable, the
  complete-case mean `E[Y | R = true]` equals `E[Y]`.

## References

* D. B. Rubin, *Inference and missing data*, Biometrika 63 (1976).
* R. J. A. Little and D. B. Rubin, *Statistical Analysis with Missing Data*, Wiley.
-/

@[expose] public section

namespace CausalInference

namespace MissingData

open MeasureTheory ProbabilityTheory

variable {Ω 𝒳 : Type*} {mΩ : MeasurableSpace Ω} [MeasurableSpace 𝒳]

/-- Missing completely at random: the response indicator `R` is independent of the pair
`(X, Y)` of covariate and full-data outcome. -/
def MCAR (μ : Measure Ω) (X : Ω → 𝒳) (Y : Ω → ℝ) (R : Ω → Bool) : Prop :=
  IndepFun R (fun ω => (X ω, Y ω)) μ

/-- Missing at random (full form): the response indicator `R` and the outcome `Y` are
conditionally independent given the σ-algebra generated by the covariate `X`. -/
def MAR [StandardBorelSpace Ω] (μ : Measure Ω) [IsFiniteMeasure μ] {X : Ω → 𝒳}
    (hX : Measurable X) (R : Ω → Bool) (Y : Ω → ℝ) : Prop :=
  CondIndepFun (MeasurableSpace.comap X inferInstance) hX.comap_le R Y μ

/-- Missing not at random: the negation of the full conditional independence form `MAR`. -/
def MNAR [StandardBorelSpace Ω] (μ : Measure Ω) [IsFiniteMeasure μ] {X : Ω → 𝒳}
    (hX : Measurable X) (R : Ω → Bool) (Y : Ω → ℝ) : Prop :=
  ¬ MAR μ hX R Y

/-- Missing at random, mean-independence form: the conditional expectation of the response
indicator given `(X, Y)` agrees almost everywhere with its conditional expectation given `X`
alone, `E[1{R} | X, Y] = E[1{R} | X]`. It is implied by the conditional independence form
`MAR` (see `MAR.marMean`); since `R` is Boolean the converse also holds mathematically, but it is
not proved here. -/
def MARMean (μ : Measure Ω) (X : Ω → 𝒳) (Y : Ω → ℝ) (R : Ω → Bool) : Prop :=
  μ[respInd R | MeasurableSpace.comap (fun ω => (X ω, Y ω)) inferInstance] =ᵐ[μ]
    μ[respInd R | MeasurableSpace.comap X inferInstance]

variable {μ : Measure Ω} {X : Ω → 𝒳} {Y : Ω → ℝ} {R : Ω → Bool}

/-- The σ-algebra generated by `X` is contained in the one generated by `(X, Y)`. -/
theorem comap_le_comap_prod :
    MeasurableSpace.comap X inferInstance ≤
      MeasurableSpace.comap (fun ω => (X ω, Y ω)) inferInstance :=
  (measurable_fst.comp (comap_measurable (fun ω => (X ω, Y ω)))).comap_le

/-- If `R` is independent of a σ-algebra `m` contained in the ambient one, then the conditional
expectation given `m` of the indicator of `R ∈ s` is almost everywhere the constant
`μ (R ∈ s)`. -/
theorem condExp_indicator_preimage_of_indep [IsFiniteMeasure μ] {m : MeasurableSpace Ω}
    (hm : m ≤ mΩ) (hR : Measurable[mΩ] R)
    (hind : Indep (MeasurableSpace.comap R inferInstance) m μ) {s : Set Bool}
    (hs : MeasurableSet s) :
    μ⟦R ⁻¹' s | m⟧ =ᵐ[μ] fun _ => μ.real (R ⁻¹' s) := by
  have hsm : StronglyMeasurable[MeasurableSpace.comap R inferInstance]
      ((R ⁻¹' s).indicator fun _ => (1 : ℝ)) :=
    ((measurable_const.indicator hs).comp (comap_measurable R)).stronglyMeasurable
  refine (condExp_indep_eq hR.comap_le hm hsm hind).trans ?_
  refine Filter.Eventually.of_forall fun _ => ?_
  exact integral_indicator_one (hR hs)

/-- MCAR implies the mean-independence form of MAR: both conditional expectations of the
response indicator equal the constant `μ {R = true}` almost everywhere. -/
theorem MCAR.marMean [IsFiniteMeasure μ] (h : MCAR μ X Y R) (hX : Measurable X)
    (hY : Measurable Y) (hR : Measurable R) : MARMean μ X Y R := by
  have hind := (IndepFun_iff_Indep _ _ _).mp h
  have hXY : Measurable fun ω => (X ω, Y ω) := hX.prodMk hY
  have h1 := condExp_indicator_preimage_of_indep hXY.comap_le hR hind
    (measurableSet_singleton true)
  have h2 := condExp_indicator_preimage_of_indep hX.comap_le hR
    (indep_of_indep_of_le_right hind comap_le_comap_prod) (measurableSet_singleton true)
  exact h1.trans h2.symm

/-- If `R ∈ s` is independent of the σ-algebra of `(X, Y)`, then given `X` the indicator of
`R ∈ s` and that of `Y ∈ t` factorize: `E[1{R ∈ s, Y ∈ t} | X] = μ (R ∈ s) E[1{Y ∈ t} | X]`. -/
theorem MCAR.condExp_inter [IsFiniteMeasure μ] (h : MCAR μ X Y R) (hX : Measurable X)
    (hY : Measurable Y) (hR : Measurable R) {s : Set Bool} {t : Set ℝ} (hs : MeasurableSet s)
    (ht : MeasurableSet t) :
    μ⟦R ⁻¹' s ∩ Y ⁻¹' t | MeasurableSpace.comap X inferInstance⟧ =ᵐ[μ]
      fun ω => μ.real (R ⁻¹' s) * (μ⟦Y ⁻¹' t | MeasurableSpace.comap X inferInstance⟧) ω := by
  have hind := (IndepFun_iff_Indep _ _ _).mp h
  have hXY : Measurable fun ω => (X ω, Y ω) := hX.prodMk hY
  set mXY := MeasurableSpace.comap (fun ω => (X ω, Y ω)) inferInstance
  set mX := MeasurableSpace.comap X inferInstance
  set f : Ω → ℝ := (R ⁻¹' s).indicator fun _ => (1 : ℝ)
  set g : Ω → ℝ := (Y ⁻¹' t).indicator fun _ => (1 : ℝ)
  have hfi : Integrable f μ := (integrable_const 1).indicator (hR hs)
  have hgi : Integrable g μ := (integrable_const 1).indicator (hY ht)
  have hprod : (R ⁻¹' s ∩ Y ⁻¹' t).indicator (fun _ => (1 : ℝ)) = f * g := by
    ext ω
    by_cases h1 : R ω ∈ s <;> by_cases h2 : Y ω ∈ t <;>
      simp [f, g, Set.indicator, h1, h2]
  have hgm : StronglyMeasurable[mXY] g := by
    have : Measurable[mXY] Y := measurable_snd.comp (comap_measurable (fun ω => (X ω, Y ω)))
    exact ((measurable_const.indicator ht).comp this).stronglyMeasurable
  have hfgi : Integrable (f * g) μ := by
    rw [← hprod]; exact (integrable_const 1).indicator ((hR hs).inter (hY ht))
  have hf := condExp_indicator_preimage_of_indep hXY.comap_le hR hind hs
  rw [hprod]
  -- tower property, then pull out `g`, then use independence of `R` and `(X, Y)`
  refine (condExp_condExp_of_le comap_le_comap_prod hXY.comap_le).symm.trans ?_
  have hpull : μ[f * g | mXY] =ᵐ[μ] fun ω => μ.real (R ⁻¹' s) • g ω :=
    (condExp_mul_of_stronglyMeasurable_right hgm hfgi hfi).trans
      (hf.mul (Filter.EventuallyEq.refl _ g))
  refine (condExp_congr_ae hpull).trans ?_
  exact condExp_smul (μ.real (R ⁻¹' s)) g mX

/-- MCAR implies the full conditional independence form of MAR. -/
theorem MCAR.mar [StandardBorelSpace Ω] [IsFiniteMeasure μ] (h : MCAR μ X Y R)
    (hX : Measurable X) (hY : Measurable Y) (hR : Measurable R) : MAR μ hX R Y := by
  rw [MAR, condIndepFun_iff_condExp_inter_preimage_eq_mul hR hY]
  intro s t hs ht
  have hind := (IndepFun_iff_Indep _ _ _).mp h
  have hR' := condExp_indicator_preimage_of_indep hX.comap_le hR
    (indep_of_indep_of_le_right hind comap_le_comap_prod) hs
  refine (h.condExp_inter hX hY hR hs ht).trans ?_
  filter_upwards [hR'] with ω hω
  rw [hω]

/-- The full conditional independence form of MAR implies its mean-independence form:
if `R ⫫ Y | X` then `E[1{R} | X, Y] = E[1{R} | X]` almost everywhere. -/
theorem MAR.marMean [StandardBorelSpace Ω] [IsFiniteMeasure μ] (hX : Measurable X)
    (hY : Measurable Y) (hR : Measurable R) (h : MAR μ hX R Y) : MARMean μ X Y R := by
  have hXY : Measurable fun ω => (X ω, Y ω) := hX.prodMk hY
  have hri : Integrable (respInd R) μ :=
    (integrable_const 1).indicator (hR (measurableSet_singleton true))
  have hπint : Integrable (μ[respInd R | MeasurableSpace.comap X inferInstance]) μ :=
    integrable_condExp
  have hπm : StronglyMeasurable[MeasurableSpace.comap X inferInstance]
      (μ[respInd R | MeasurableSpace.comap X inferInstance]) := stronglyMeasurable_condExp
  -- `E[1{R} | X]` is bounded by one
  have hbd : ∀ᵐ ω ∂μ,
      ‖(μ[respInd R | MeasurableSpace.comap X inferInstance]) ω‖ ≤ (1 : ℝ) := by
    have h1 : ∀ᵐ ω ∂μ, |respInd R ω| ≤ (1 : ℝ) :=
      Filter.Eventually.of_forall fun ω => by
        rw [abs_of_nonneg (respInd_nonneg R ω)]; exact respInd_le_one R ω
    filter_upwards [ae_bdd_abs_condExp_of_ae_bdd_abs
      (m := MeasurableSpace.comap X inferInstance) h1] with ω hω
    rwa [Real.norm_eq_abs]
  rw [MAR, condIndepFun_iff_condExp_inter_preimage_eq_mul hR hY] at h
  -- the set integrals agree on rectangles `X⁻¹ A ∩ Y⁻¹ B`
  have hrect : ∀ A B, MeasurableSet A → MeasurableSet B →
      ∫ ω in X ⁻¹' A ∩ Y ⁻¹' B, (μ[respInd R | MeasurableSpace.comap X inferInstance]) ω ∂μ =
        ∫ ω in X ⁻¹' A ∩ Y ⁻¹' B, respInd R ω ∂μ := by
    intro A B hA hB
    have hXA : MeasurableSet[MeasurableSpace.comap X inferInstance] (X ⁻¹' A) := ⟨A, hA, rfl⟩
    have hYB : MeasurableSet (Y ⁻¹' B) := hY hB
    have hgi : Integrable ((Y ⁻¹' B).indicator fun _ => (1 : ℝ)) μ :=
      (integrable_const 1).indicator hYB
    have hfun : (μ[respInd R | MeasurableSpace.comap X inferInstance]) *
        (Y ⁻¹' B).indicator (fun _ => (1 : ℝ)) =
        (Y ⁻¹' B).indicator (μ[respInd R | MeasurableSpace.comap X inferInstance]) := by
      ext ω
      by_cases hω : ω ∈ Y ⁻¹' B <;> simp [Set.indicator, hω]
    have hfun' : (R ⁻¹' {true} ∩ Y ⁻¹' B).indicator (fun _ => (1 : ℝ)) =
        (Y ⁻¹' B).indicator (respInd R) := by
      ext ω
      by_cases h1 : ω ∈ R ⁻¹' {true} <;> by_cases h2 : ω ∈ Y ⁻¹' B <;>
        simp_all [Set.indicator, respInd]
    have hpull := condExp_stronglyMeasurable_mul_of_bound hX.comap_le hπm hgi 1 hbd
    have hci := h {true} B (measurableSet_singleton true) hB
    rw [← setIntegral_indicator hYB, ← setIntegral_indicator hYB, ← hfun, ← hfun',
      ← setIntegral_condExp hX.comap_le (hfun ▸ hπint.indicator hYB) hXA,
      ← setIntegral_condExp hX.comap_le ((integrable_const 1).indicator
        ((hR (measurableSet_singleton true)).inter hYB)) hXA]
    refine setIntegral_congr_ae (hX hA) ?_
    filter_upwards [hpull, hci] with ω h1 h2 _
    rw [h1, h2]
    rfl
  have key : ∀ s (hs : MeasurableSet[MeasurableSpace.comap (fun ω => (X ω, Y ω)) inferInstance] s),
      ∫ ω in s, (μ[respInd R | MeasurableSpace.comap X inferInstance]) ω ∂μ =
        ∫ ω in s, respInd R ω ∂μ := by
    have h_eq : MeasurableSpace.comap (fun ω => (X ω, Y ω)) inferInstance =
        MeasurableSpace.generateFrom (Set.preimage (fun ω => (X ω, Y ω)) ''
          Set.image2 (· ×ˢ ·) {A : Set 𝒳 | MeasurableSet A} {B : Set ℝ | MeasurableSet B}) := by
      rw [← generateFrom_prod, MeasurableSpace.comap_generateFrom]
    intro s hs
    induction s, hs using MeasurableSpace.induction_on_inter h_eq
      (isPiSystem_prod.comap (fun ω => (X ω, Y ω))) with
    | empty => simp
    | basic t ht =>
      obtain ⟨_, ⟨A, hA, B, hB, rfl⟩, rfl⟩ := ht
      exact hrect A B hA hB
    | compl t htm ht =>
      rw [setIntegral_compl (hXY.comap_le _ htm) hπint, setIntegral_compl (hXY.comap_le _ htm) hri,
        ht, integral_condExp hX.comap_le]
    | iUnion f hf hfm heq =>
      rw [integral_iUnion (fun n => hXY.comap_le _ (hfm n)) hf hπint.integrableOn,
        integral_iUnion (fun n => hXY.comap_le _ (hfm n)) hf hri.integrableOn]
      exact tsum_congr heq
  exact (ae_eq_condExp_of_forall_setIntegral_eq hXY.comap_le hri
    (fun s _ _ => hπint.integrableOn) (fun s hs _ => key s hs)
    (hπm.mono comap_le_comap_prod).aestronglyMeasurable).symm

/-- An MNAR mechanism is not MCAR. -/
theorem MNAR.not_mcar [StandardBorelSpace Ω] [IsFiniteMeasure μ] (hX : Measurable X)
    (hY : Measurable Y) (hR : Measurable R) (h : MNAR μ hX R Y) : ¬ MCAR μ X Y R :=
  fun hm => h (hm.mar hX hY hR)

/-- Under MCAR the complete-case mean identifies the full-data mean:
`E[Y | R = true] = E[Y]`, provided the response event has positive probability and `Y` is
integrable. -/
theorem MCAR.completeCaseMean_eq [IsFiniteMeasure μ] (h : MCAR μ X Y R) (hR : Measurable R)
    (hY : Integrable Y μ) (hpos : μ (R ⁻¹' {true}) ≠ 0) :
    completeCaseMean μ R Y = ∫ ω, Y ω ∂μ := by
  have hS : MeasurableSet (R ⁻¹' {true}) := hR (measurableSet_singleton true)
  have hYR : IndepFun (respInd R) Y μ :=
    have hI : IndepFun R (fun ω => (X ω, Y ω)) μ := h
    hI.comp (φ := ({true} : Set Bool).indicator (1 : Bool → ℝ)) (ψ := Prod.snd)
      (measurable_const.indicator (measurableSet_singleton true)) measurable_snd
  have hcomp : respInd R * Y = (R ⁻¹' {true}).indicator Y := by
    ext ω
    by_cases hω : R ω = true <;> simp [respInd, Set.indicator, hω]
  have hmul := IndepFun.integral_mul_eq_mul_integral hYR
    (measurable_respInd hR).aestronglyMeasurable hY.aestronglyMeasurable
  rw [hcomp, integral_indicator hS, respInd, integral_indicator_one hS] at hmul
  have hne : μ.real (R ⁻¹' {true}) ≠ 0 :=
    ENNReal.toReal_ne_zero.mpr ⟨hpos, measure_ne_top _ _⟩
  rw [completeCaseMean, ProbabilityTheory.cond, integral_smul_measure, hmul, smul_eq_mul,
    ENNReal.toReal_inv, ← measureReal_def, ← mul_assoc, inv_mul_cancel₀ hne, one_mul]

end MissingData

end CausalInference
