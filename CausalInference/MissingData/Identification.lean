module

public import CausalInference.MissingData.Weighting

/-!
# Law-level identification of the full-data mean

The weighting identities of `CausalInference.MissingData.Weighting` are equalities of integrals
on the sample space with a supplied version of the response propensity. This file turns them
into identification statements: on suitable classes of admissible models the full-data mean
`E[Y]` is a function of the observed-data law, in the sense of `IsObservedDataFunctional`.

## Main definitions

* `ipwFunctional ν`: for a law `ν` of the observed data `(x, r, w)` (with `w = r · y`),
  `∫ w / p_ν(x) dν`, where `p_ν = E_ν[1{r = true} | x]` is the conditional expectation computed
  under `ν` itself. It does not depend on any chosen version of the propensity of a model.
* `marPositiveModels`: admissible models with integrable `Y`, the mean-independence form of MAR,
  and almost surely positive response propensity `E[1{R} | X] > 0`.

## Main results

* `condExp_comp_ae_eq`: conditional expectations under a push forward pull back to conditional
  expectations under the original measure.
* `fullMean_eq_ipwFunctional`, `isObservedDataFunctional_fullMean_of_mar`: on
  `marPositiveModels` the full-data mean equals `ipwFunctional` of the observed-data law, so it
  is a function of the observed-data law.
* `isObservedDataFunctional_fullMean_of_mcar`: the MCAR special case through the complete-case
  mean.

By `marMean_iff_mar` the class `marPositiveModels` can equivalently be described with the
conditional independence form of MAR when `Ω` is standard Borel. Positivity cannot be dropped:
see `Counterexample.fullMean_not_pointIdentified_of_no_positivity`.

## References

* J. M. Robins, A. Rotnitzky and L. P. Zhao, *Estimation of regression coefficients when some
  regressors are not always observed*, JASA 89 (1994).
* R. J. A. Little and D. B. Rubin, *Statistical Analysis with Missing Data*, Wiley.
-/

@[expose] public section

namespace CausalInference

namespace MissingData

open MeasureTheory ProbabilityTheory

/-- Conditional expectations pull back along a measurable map. If `T : Ω → β` is measurable,
`m` is a sub-σ-algebra of `β` and `f` is integrable under the push forward `μ.map T`, then
`E_{μ.map T}[f | m] ∘ T` is almost everywhere `E_μ[f ∘ T | T⁻¹ m]`. -/
theorem condExp_comp_ae_eq {Ω β : Type*} {m : MeasurableSpace β} {mΩ : MeasurableSpace Ω}
    {mβ : MeasurableSpace β} {μ : Measure Ω} [IsFiniteMeasure μ] {T : Ω → β} (hT : Measurable T)
    (hm : m ≤ mβ) {f : β → ℝ} (hf : Integrable f (μ.map T)) :
    (fun ω => (μ.map T)[f | m] (T ω)) =ᵐ[μ] μ[f ∘ T | m.comap T] := by
  have hm' : m.comap T ≤ mΩ := (MeasurableSpace.comap_mono hm).trans hT.comap_le
  refine ae_eq_condExp_of_forall_setIntegral_eq hm' (hf.comp_measurable hT)
    (fun s _ _ => (integrable_condExp.comp_measurable hT).integrableOn) ?_
    (stronglyMeasurable_condExp.comp_measurable (comap_measurable T)).aestronglyMeasurable
  rintro _ ⟨A, hA, rfl⟩ _
  rw [← setIntegral_map (hm A hA) integrable_condExp.aestronglyMeasurable hT.aemeasurable,
    setIntegral_condExp hm hf hA,
    setIntegral_map (hm A hA) hf.aestronglyMeasurable hT.aemeasurable]
  rfl

variable {Ω 𝒳 : Type*} [MeasurableSpace Ω] [MeasurableSpace 𝒳]

/-- The inverse probability weighting functional of a law `ν` of the observed data `(x, r, w)`:
`∫ w / p_ν(x) dν`, where `p_ν = E_ν[1{r = true} | x]` is the response propensity computed from
`ν` itself (the conditional expectation given the σ-algebra generated by the first
coordinate). -/
noncomputable def ipwFunctional (ν : Measure (𝒳 × Bool × ℝ)) : ℝ :=
  ∫ q, q.2.2 / (ν[respInd (fun q : 𝒳 × Bool × ℝ => q.2.1) |
    MeasurableSpace.comap Prod.fst inferInstance]) q ∂ν

/-- The class of admissible missing-data models with integrable outcome, satisfying the
mean-independence form of MAR, whose response propensity `E[1{R} | X]` is almost surely
positive. -/
def marPositiveModels : Set (MissingDataModel Ω 𝒳) :=
  {M | M.IsAdmissible ∧ Integrable M.Y M.μ ∧ MARMean M.μ M.X M.Y M.R ∧
    ∀ᵐ ω ∂M.μ, 0 < (M.μ[respInd M.R | MeasurableSpace.comap M.X inferInstance]) ω}

/-- Identification of the full-data mean under MAR and positivity: on `marPositiveModels`,
`E[Y]` equals the inverse probability weighting functional of the observed-data law. -/
theorem fullMean_eq_ipwFunctional {M : MissingDataModel Ω 𝒳} (hM : M ∈ marPositiveModels) :
    M.fullMean = ipwFunctional M.observedLaw := by
  obtain ⟨hA, hYi, hmar, hpos⟩ := hM
  have := hA.isProbabilityMeasure
  have := hA.isProbabilityMeasure_observedLaw
  have hX := hA.measurable_X
  have hR := hA.measurable_R
  have hY := hA.measurable_Y
  have hO := hA.measurable_observedData
  have hρ : Integrable (respInd (fun q : 𝒳 × Bool × ℝ => q.2.1)) (M.μ.map M.observedData) :=
    (integrable_const 1).indicator (measurable_snd.fst (measurableSet_singleton true))
  have hρO : respInd (fun q : 𝒳 × Bool × ℝ => q.2.1) ∘ M.observedData = respInd M.R := by
    funext ω
    simp [respInd_apply, MissingDataModel.observedData]
  have hcomap : (MeasurableSpace.comap (Prod.fst : 𝒳 × Bool × ℝ → 𝒳) inferInstance).comap
      M.observedData = MeasurableSpace.comap M.X inferInstance := by
    rw [MeasurableSpace.comap_comp]
    rfl
  have hpull := condExp_comp_ae_eq hO
    (measurable_fst : Measurable (Prod.fst : 𝒳 × Bool × ℝ → 𝒳)).comap_le hρ
  rw [hρO, hcomap] at hpull
  have hmeas : AEStronglyMeasurable (fun q : 𝒳 × Bool × ℝ => q.2.2 /
      ((M.μ.map M.observedData)[respInd (fun q : 𝒳 × Bool × ℝ => q.2.1) |
        MeasurableSpace.comap Prod.fst inferInstance]) q) (M.μ.map M.observedData) :=
    (measurable_snd.snd.div (stronglyMeasurable_condExp.measurable.mono
      (measurable_fst : Measurable (Prod.fst : 𝒳 × Bool × ℝ → 𝒳)).comap_le
        le_rfl)).aestronglyMeasurable
  rw [ipwFunctional, MissingDataModel.observedLaw, integral_map hO.aemeasurable hmeas,
    MissingDataModel.fullMean,
    ← ipw_identity_of_condExp_eq hX hY hR stronglyMeasurable_condExp
      (Filter.EventuallyEq.refl _ _) hmar hpos hYi]
  refine integral_congr_ae ?_
  filter_upwards [hpull] with ω hω
  rw [hω]
  rfl

/-- Under MAR and positivity the full-data mean is a function of the observed-data law on
`marPositiveModels`, through `ipwFunctional`. -/
theorem isObservedDataFunctional_fullMean_of_mar :
    IsObservedDataFunctional (marPositiveModels : Set (MissingDataModel Ω 𝒳))
      MissingDataModel.fullMean :=
  ⟨ipwFunctional, fun _ hM => fullMean_eq_ipwFunctional hM⟩

/-- Under MCAR the full-data mean is a function of the observed-data law on every class of
admissible models with integrable outcome and a response event of positive probability: it
equals the complete-case mean, which is computed from the observed-data law. -/
theorem isObservedDataFunctional_fullMean_of_mcar {S : Set (MissingDataModel Ω 𝒳)}
    (hS : ∀ M ∈ S, M.IsAdmissible ∧ Integrable M.Y M.μ ∧ MCAR M.μ M.X M.Y M.R ∧
      M.μ (M.R ⁻¹' {true}) ≠ 0) :
    IsObservedDataFunctional S MissingDataModel.fullMean := by
  obtain ⟨G, hG⟩ := isObservedDataFunctional_completeCaseMean (S := S) fun M hM =>
    ⟨(hS M hM).1, (hS M hM).2.2.2, (hS M hM).2.1.integrableOn⟩
  refine ⟨G, fun M hM => ?_⟩
  obtain ⟨hA, hYi, hmcar, hpos⟩ := hS M hM
  have := hA.isProbabilityMeasure
  rw [MissingDataModel.fullMean, ← hmcar.completeCaseMean_eq hA.measurable_R hYi hpos]
  exact hG M hM

end MissingData

end CausalInference
