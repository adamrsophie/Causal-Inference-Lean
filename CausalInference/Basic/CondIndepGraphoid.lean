module

public import Mathlib.Probability.Independence.Conditional
public import Mathlib.Probability.Independence.Basic
public import Mathlib.MeasureTheory.Function.ConditionalExpectation.PullOut

/-!
# Conditional independence of random variables: equivalent forms and graphoid laws

Conditional independence of random variables `U : Ω → α` and `V : Ω → β` with values in
arbitrary measurable spaces, given a sub σ-algebra `m` (for instance the σ-algebra generated by
a conditioning variable `W`), is Mathlib's `ProbabilityTheory.CondIndepFun m hm U V μ`. That
definition needs `StandardBorelSpace Ω` and a finite measure. This file proves its equivalent
forms and the semi-graphoid laws.

The proofs rest on two lemmas about conditional expectations that need no standard Borel
assumption (`condExp_sup_eq_of_forall_indicator_mul` and `condExp_mul_eq_of_condExp_sup_eq`):
for an integrable `G`, the product rule `E[1_A(U) G | m] = E[1_A(U) | m] E[G | m]` for all
measurable `A` is equivalent to `E[G | σ(U) ∨ m] = E[G | m]`, and the latter gives the product
rule for every bounded measurable test function of `U`. The standard Borel assumption enters
only through Mathlib's definition of `CondIndepFun`.

## Main results

* `condIndepFun_iff_forall_indicator_mul`: the event form
  `E[1_A(U) 1_B(V) | m] = E[1_A(U) | m] E[1_B(V) | m]`.
* `condIndepFun_iff_forall_condExp_mul_eq`: the product rule for bounded measurable test
  functions, `E[f(U) g(V) | m] = E[f(U) | m] E[g(V) | m]`.
* `condIndepFun_iff_forall_condExp_sup_eq`: the regression form
  `E[f(U) | σ(V) ∨ m] = E[f(U) | m]` for bounded measurable `f`, and
  `condIndepFun_iff_forall_condExp_indicator_sup_eq`: indicators `f = 1_A` suffice.
* `condExp_mul_eq_of_condIndepFun_of_integrable`: the product rule with a bounded factor of `U`
  and an integrable factor of `V`.
* The semi-graphoid laws: symmetry is Mathlib's `CondIndepFun.symm`;
  `condIndepFun_decomposition`, `condIndepFun_weak_union`, `condIndepFun_contraction`, and their
  forms with a conditioning variable `condIndepFun_weak_union_comap`,
  `condIndepFun_contraction_comap`.
* `condIndepFun_bot_iff_indepFun`, `condIndepFun_comap_const_iff_indepFun`: under a probability
  measure, conditional independence given the trivial σ-algebra, or given a constant variable,
  is independence.

A variable measurable for `m` is conditionally independent of every variable given `m`; this is
Mathlib's `condIndepFun_of_measurable_left`. For finite probability spaces the bridge from the
finite form of conditional independence is `FiniteDist.condIndepFun_iff_condIndepFun_toMeasure`.

## References

* A. P. Dawid, *Conditional independence in statistical theory*, Journal of the Royal Statistical
  Society B 41 (1979).
* J. Pearl, *Probabilistic Reasoning in Intelligent Systems*, Morgan Kaufmann (1988).
-/

@[expose] public section

namespace CausalInference

open MeasureTheory ProbabilityTheory

/-! ### Two lemmas about conditional expectations -/

section Engine

variable {Ω α β : Type*} {m mΩ : MeasurableSpace Ω} [MeasurableSpace α] [MeasurableSpace β]
  {μ : Measure Ω}

omit [MeasurableSpace α] in
/-- An indicator with value one is bounded by one. -/
theorem abs_indicator_one_le (A : Set α) (a : α) : |A.indicator (1 : α → ℝ) a| ≤ 1 := by
  by_cases h : a ∈ A <;> simp [Set.indicator, h]

/-- A bounded measurable function of a measurable variable is integrable under a finite
measure. -/
theorem integrable_comp_of_abs_le [IsFiniteMeasure μ] {U : Ω → α} (hU : Measurable U)
    {f : α → ℝ} (hf : Measurable f) {C : ℝ} (hC : ∀ a, |f a| ≤ C) :
    Integrable (fun ω => f (U ω)) μ :=
  (integrable_const C).mono' (hf.comp hU).aestronglyMeasurable
    (Filter.Eventually.of_forall fun ω => by rw [Real.norm_eq_abs]; exact hC (U ω))

omit m mΩ in
/-- `σ(U, V) = σ(U) ∨ σ(V)`, Mathlib's `MeasurableSpace.comap_prodMk` stated with the instance
σ-algebras. -/
theorem comap_prodMk_eq_sup (U : Ω → α) (V : Ω → β) :
    MeasurableSpace.comap (fun ω => (U ω, V ω)) inferInstance =
      MeasurableSpace.comap U inferInstance ⊔ MeasurableSpace.comap V inferInstance :=
  MeasurableSpace.comap_prodMk U V

omit mΩ in
/-- The events `{U ∈ A} ∩ C` with `C ∈ m` generate `σ(U) ∨ m`. -/
theorem comap_sup_eq_generateFrom (U : Ω → α) (m : MeasurableSpace Ω) :
    MeasurableSpace.comap U inferInstance ⊔ m = MeasurableSpace.generateFrom
      {s | ∃ A, MeasurableSet A ∧ ∃ C, MeasurableSet[m] C ∧ s = U ⁻¹' A ∩ C} := by
  refine le_antisymm (sup_le ?_ ?_) (MeasurableSpace.generateFrom_le ?_)
  · rintro s ⟨A, hA, rfl⟩
    exact MeasurableSpace.measurableSet_generateFrom
      ⟨A, hA, Set.univ, MeasurableSet.univ, by simp⟩
  · intro C hC
    exact MeasurableSpace.measurableSet_generateFrom
      ⟨Set.univ, MeasurableSet.univ, C, hC, by simp⟩
  · rintro s ⟨A, hA, C, hC, rfl⟩
    exact MeasurableSet.inter (le_sup_left (a := MeasurableSpace.comap U inferInstance) _
      ⟨A, hA, rfl⟩) (le_sup_right (a := MeasurableSpace.comap U inferInstance) _ hC)

omit mΩ in
/-- The events `{U ∈ A} ∩ C` with `C ∈ m` form a π-system. -/
theorem isPiSystem_preimage_inter (U : Ω → α) (m : MeasurableSpace Ω) :
    IsPiSystem {s | ∃ A, MeasurableSet A ∧ ∃ C, MeasurableSet[m] C ∧ s = U ⁻¹' A ∩ C} := by
  rintro s ⟨A, hA, C, hC, rfl⟩ t ⟨A', hA', C', hC', rfl⟩ _
  refine ⟨A ∩ A', hA.inter hA', C ∩ C', hC.inter hC', ?_⟩
  ext ω
  simp only [Set.mem_inter_iff, Set.mem_preimage]
  tauto

/-- Two integrable functions with the same integrals over the events `{U ∈ A} ∩ C`, `C ∈ m`,
have the same integrals over every event of `σ(U) ∨ m` (the π-λ theorem). -/
theorem setIntegral_eq_of_forall_preimage_inter {U : Ω → α}
    (hU : Measurable U) (hm : m ≤ mΩ) {F G : Ω → ℝ} (hF : Integrable F μ)
    (hG : Integrable G μ)
    (hrect : ∀ A : Set α, MeasurableSet A → ∀ C : Set Ω, MeasurableSet[m] C →
      ∫ ω in U ⁻¹' A ∩ C, F ω ∂μ = ∫ ω in U ⁻¹' A ∩ C, G ω ∂μ)
    (s : Set Ω) (hs : MeasurableSet[MeasurableSpace.comap U inferInstance ⊔ m] s) :
    ∫ ω in s, F ω ∂μ = ∫ ω in s, G ω ∂μ := by
  have hle : MeasurableSpace.comap U inferInstance ⊔ m ≤ mΩ := sup_le hU.comap_le hm
  induction s, hs using MeasurableSpace.induction_on_inter (comap_sup_eq_generateFrom U m)
    (isPiSystem_preimage_inter U m) with
  | empty => simp
  | basic t ht =>
    obtain ⟨A, hA, C, hC, rfl⟩ := ht
    exact hrect A hA C hC
  | compl t htm ih =>
    have huniv := hrect Set.univ MeasurableSet.univ Set.univ MeasurableSet.univ
    simp only [Set.preimage_univ, Set.inter_univ, Measure.restrict_univ] at huniv
    rw [setIntegral_compl (hle _ htm) hF, setIntegral_compl (hle _ htm) hG, huniv, ih]
  | iUnion f hd hfm ih =>
    rw [integral_iUnion (fun i => hle _ (hfm i)) hd hF.integrableOn,
      integral_iUnion (fun i => hle _ (hfm i)) hd hG.integrableOn]
    exact tsum_congr ih

/-- An integral over `{U ∈ A} ∩ S` is the integral over `S` of `1_A(U)` times the
integrand. -/
theorem setIntegral_inter_preimage_eq {U : Ω → α} (hU : Measurable U) {A : Set α}
    (hA : MeasurableSet A) (S : Set Ω) (F : Ω → ℝ) :
    ∫ ω in U ⁻¹' A ∩ S, F ω ∂μ = ∫ ω in S, A.indicator 1 (U ω) * F ω ∂μ := by
  rw [Set.inter_comm, ← setIntegral_indicator (hU hA)]
  congr 1
  funext ω
  by_cases h : U ω ∈ A <;> simp [Set.indicator, h]

/-- **The indicator product rule gives the regression identity.** For an integrable `G`, if
`E[1_A(U) G | m] = E[1_A(U) | m] E[G | m]` for every measurable `A`, then
`E[G | σ(U) ∨ m] = E[G | m]`. The defining set integrals are checked on the events
`{U ∈ A} ∩ C`, `C ∈ m`, and extended by the π-λ theorem. -/
theorem condExp_sup_eq_of_forall_indicator_mul [IsFiniteMeasure μ] (hm : m ≤ mΩ) {U : Ω → α}
    (hU : Measurable U) {G : Ω → ℝ} (hG : Integrable G μ)
    (H : ∀ A : Set α, MeasurableSet A →
      μ[fun ω => A.indicator 1 (U ω) * G ω | m] =ᵐ[μ]
        μ[fun ω => A.indicator 1 (U ω) | m] * μ[G | m]) :
    μ[G | MeasurableSpace.comap U inferInstance ⊔ m] =ᵐ[μ] μ[G | m] := by
  have hle : MeasurableSpace.comap U inferInstance ⊔ m ≤ mΩ := sup_le hU.comap_le hm
  refine (ae_eq_condExp_of_forall_setIntegral_eq hle hG
    (fun s _ _ => integrable_condExp.integrableOn) (fun s hs _ => ?_)
    ((stronglyMeasurable_condExp.mono
      (le_sup_right : m ≤ MeasurableSpace.comap U inferInstance ⊔ m)).aestronglyMeasurable)).symm
  refine setIntegral_eq_of_forall_preimage_inter hU hm integrable_condExp hG
    (fun A hA C hC => ?_) s hs
  rw [setIntegral_inter_preimage_eq hU hA, setIntegral_inter_preimage_eq hU hA]
  have hfAm : Measurable fun ω => A.indicator (1 : α → ℝ) (U ω) :=
    (measurable_one.indicator hA).comp hU
  have hfAb : ∀ᵐ ω ∂μ, ‖A.indicator (1 : α → ℝ) (U ω)‖ ≤ 1 :=
    Filter.Eventually.of_forall fun ω => by
      rw [Real.norm_eq_abs]; exact abs_indicator_one_le A (U ω)
  have hfA : Integrable (fun ω => A.indicator (1 : α → ℝ) (U ω)) μ :=
    integrable_comp_of_abs_le hU (measurable_one.indicator hA) (abs_indicator_one_le A)
  have hfAG : Integrable (fun ω => A.indicator (1 : α → ℝ) (U ω) * G ω) μ :=
    hG.bdd_mul hfAm.aestronglyMeasurable hfAb
  have hfAc := (integrable_condExp (m := m) (f := G) (μ := μ)).bdd_mul
    hfAm.aestronglyMeasurable hfAb
  have hpull := condExp_mul_of_stronglyMeasurable_right
    (stronglyMeasurable_condExp (m := m) (f := G) (μ := μ)) hfAc hfA
  have hci := H A hA
  simp only [Pi.mul_def] at hpull hci
  rw [← setIntegral_condExp hm hfAG hC, ← setIntegral_condExp hm hfAc hC]
  exact integral_congr_ae (ae_restrict_of_ae (hpull.trans hci.symm))

/-- **The regression identity gives the product rule.** For an integrable `G`, if
`E[G | σ(U) ∨ m] = E[G | m]`, then `E[f(U) G | m] = E[f(U) | m] E[G | m]` for every bounded
measurable `f`: condition on `σ(U) ∨ m` first, pull out `f(U)`, replace `E[G | σ(U) ∨ m]` by
`E[G | m]`, and pull out that factor given `m`. -/
theorem condExp_mul_eq_of_condExp_sup_eq [IsFiniteMeasure μ] (hm : m ≤ mΩ) {U : Ω → α}
    (hU : Measurable U) {G : Ω → ℝ} (hG : Integrable G μ)
    (H : μ[G | MeasurableSpace.comap U inferInstance ⊔ m] =ᵐ[μ] μ[G | m])
    {f : α → ℝ} (hf : Measurable f) {C : ℝ} (hC : ∀ a, |f a| ≤ C) :
    μ[fun ω => f (U ω) * G ω | m] =ᵐ[μ] μ[fun ω => f (U ω) | m] * μ[G | m] := by
  have hle : MeasurableSpace.comap U inferInstance ⊔ m ≤ mΩ := sup_le hU.comap_le hm
  have hfUm : Measurable fun ω => f (U ω) := hf.comp hU
  have hfUb : ∀ᵐ ω ∂μ, ‖f (U ω)‖ ≤ C :=
    Filter.Eventually.of_forall fun ω => by rw [Real.norm_eq_abs]; exact hC (U ω)
  have hfU : Integrable (fun ω => f (U ω)) μ := integrable_comp_of_abs_le (μ := μ) hU hf hC
  have hfg := hG.bdd_mul hfUm.aestronglyMeasurable hfUb
  have hfU_sup : StronglyMeasurable[MeasurableSpace.comap U inferInstance ⊔ m]
      (fun ω => f (U ω)) :=
    ((hf.comp (comap_measurable U)).mono
      (le_sup_left : _ ≤ MeasurableSpace.comap U inferInstance ⊔ m) le_rfl).stronglyMeasurable
  have h2 := condExp_mul_of_stronglyMeasurable_left hfU_sup hfg hG
  have hfc := (integrable_condExp (m := m) (f := G) (μ := μ)).bdd_mul
    hfUm.aestronglyMeasurable hfUb
  have h4 := condExp_mul_of_stronglyMeasurable_right
    (stronglyMeasurable_condExp (m := m) (f := G) (μ := μ)) hfc hfU
  have h1 := condExp_condExp_of_le (μ := μ) (f := fun ω => f (U ω) * G ω)
    (le_sup_right : m ≤ MeasurableSpace.comap U inferInstance ⊔ m) hle
  simp only [Pi.mul_def] at h2 h4 ⊢
  have h3 : μ[fun ω => f (U ω) * G ω | MeasurableSpace.comap U inferInstance ⊔ m] =ᵐ[μ]
      fun ω => f (U ω) * μ[G | m] ω := by
    filter_upwards [h2, H] with ω ha hb
    rw [ha, hb]
  exact h1.symm.trans ((condExp_congr_ae h3).trans h4)

omit [MeasurableSpace α] [MeasurableSpace β] in
/-- The product rule is symmetric in its two factors. -/
theorem condExp_mul_comm_of_eq {F G : Ω → ℝ}
    (h : μ[fun ω => F ω * G ω | m] =ᵐ[μ] μ[F | m] * μ[G | m]) :
    μ[fun ω => G ω * F ω | m] =ᵐ[μ] μ[G | m] * μ[F | m] := by
  have e : (fun ω => G ω * F ω) = fun ω => F ω * G ω := funext fun ω => mul_comm _ _
  rw [e, mul_comm (μ[G | m])]
  exact h

end Engine

section Sandwich

variable {Ω : Type*} {m₁ m m₂ mΩ : MeasurableSpace Ω} {μ : Measure Ω}

/-- **Sandwich.** If `m₁ ≤ m ≤ m₂` and `E[F | m₂] = E[F | m₁]`, then `E[F | m] = E[F | m₁]`, by
the tower property. -/
theorem condExp_eq_of_le_of_le [IsFiniteMeasure μ] (h₁ : m₁ ≤ m) (h₂ : m ≤ m₂)
    (h₃ : m₂ ≤ mΩ) {F : Ω → ℝ} (H : μ[F | m₂] =ᵐ[μ] μ[F | m₁]) :
    μ[F | m] =ᵐ[μ] μ[F | m₁] := by
  refine (condExp_condExp_of_le h₂ h₃).symm.trans ((condExp_congr_ae H).trans ?_)
  rw [condExp_of_stronglyMeasurable (h₂.trans h₃) (stronglyMeasurable_condExp.mono h₁)
    integrable_condExp]

end Sandwich

/-! ### The equivalent forms of conditional independence -/

section Congr

variable {Ω γ δ : Type*} {m₁ m₂ mΩ : MeasurableSpace Ω} [StandardBorelSpace Ω]
  [MeasurableSpace γ] [MeasurableSpace δ] {μ : Measure Ω} [IsFiniteMeasure μ]

/-- Conditional independence depends on the conditioning σ-algebra only, not on the proof that it
is a sub σ-algebra; equal σ-algebras give the same statement. -/
theorem condIndepFun_congr_sigma (h : m₁ = m₂) (h₁ : m₁ ≤ mΩ) (h₂ : m₂ ≤ mΩ) {f : Ω → γ}
    {g : Ω → δ} : CondIndepFun m₁ h₁ f g μ ↔ CondIndepFun m₂ h₂ f g μ := by
  subst h
  rfl

end Congr

section Forms

variable {Ω α β : Type*} {m mΩ : MeasurableSpace Ω} [StandardBorelSpace Ω]
  [MeasurableSpace α] [MeasurableSpace β] {μ : Measure Ω} [IsFiniteMeasure μ]
  {hm : m ≤ mΩ} {U : Ω → α} {V : Ω → β}

omit [MeasurableSpace α] in
theorem indicator_one_comp (U : Ω → α) (A : Set α) :
    (U ⁻¹' A).indicator (fun _ => (1 : ℝ)) = fun ω => A.indicator (1 : α → ℝ) (U ω) := by
  funext ω
  by_cases h : U ω ∈ A <;> simp [Set.indicator, h]

omit [MeasurableSpace α] [MeasurableSpace β] in
theorem indicator_one_inter_comp (U : Ω → α) (V : Ω → β) (A : Set α) (B : Set β) :
    (U ⁻¹' A ∩ V ⁻¹' B).indicator (fun _ => (1 : ℝ)) =
      fun ω => A.indicator (1 : α → ℝ) (U ω) * B.indicator (1 : β → ℝ) (V ω) := by
  funext ω
  by_cases h : U ω ∈ A <;> by_cases h' : V ω ∈ B <;> simp [Set.indicator, h, h']

/-- **The event form of conditional independence**: `U ⫫ V | m` if and only if
`E[1_A(U) 1_B(V) | m] = E[1_A(U) | m] E[1_B(V) | m]` almost everywhere for all measurable `A`
and `B`. -/
theorem condIndepFun_iff_forall_indicator_mul (hU : Measurable U) (hV : Measurable V) :
    CondIndepFun m hm U V μ ↔ ∀ A : Set α, MeasurableSet A → ∀ B : Set β, MeasurableSet B →
      μ[fun ω => A.indicator (1 : α → ℝ) (U ω) * B.indicator (1 : β → ℝ) (V ω) | m] =ᵐ[μ]
        μ[fun ω => A.indicator (1 : α → ℝ) (U ω) | m] *
          μ[fun ω => B.indicator (1 : β → ℝ) (V ω) | m] := by
  rw [condIndepFun_iff_condExp_inter_preimage_eq_mul hU hV]
  refine ⟨fun H A hA B hB => ?_, fun H A B hA hB => ?_⟩
  · have h := H A B hA hB
    rw [indicator_one_inter_comp, indicator_one_comp, indicator_one_comp] at h
    exact h
  · rw [indicator_one_inter_comp, indicator_one_comp, indicator_one_comp]
    exact H A hA B hB

/-- If `U ⫫ V | m`, then `E[1_A(U) | σ(V) ∨ m] = E[1_A(U) | m]` for every measurable `A`. -/
theorem condExp_indicator_sup_eq_of_condIndepFun (h : CondIndepFun m hm U V μ)
    (hU : Measurable U) (hV : Measurable V) {A : Set α} (hA : MeasurableSet A) :
    μ[fun ω => A.indicator (1 : α → ℝ) (U ω) | MeasurableSpace.comap V inferInstance ⊔ m]
      =ᵐ[μ] μ[fun ω => A.indicator (1 : α → ℝ) (U ω) | m] := by
  have hE := (condIndepFun_iff_forall_indicator_mul hU hV).1 h
  exact condExp_sup_eq_of_forall_indicator_mul hm hV
    (integrable_comp_of_abs_le hU (measurable_one.indicator hA) (abs_indicator_one_le A))
    fun B hB => condExp_mul_comm_of_eq (hE A hA B hB)

/-- **The product rule for bounded test functions.** If `U ⫫ V | m`, then
`E[f(U) g(V) | m] = E[f(U) | m] E[g(V) | m]` for all bounded measurable `f` and `g`. The rule is
extended from indicators one factor at a time, each time through the regression identity. -/
theorem condExp_mul_eq_of_condIndepFun (h : CondIndepFun m hm U V μ) (hU : Measurable U)
    (hV : Measurable V) {f : α → ℝ} {g : β → ℝ} (hf : Measurable f) (hg : Measurable g)
    {Cf Cg : ℝ} (hCf : ∀ a, |f a| ≤ Cf) (hCg : ∀ b, |g b| ≤ Cg) :
    μ[fun ω => f (U ω) * g (V ω) | m] =ᵐ[μ]
      μ[fun ω => f (U ω) | m] * μ[fun ω => g (V ω) | m] := by
  have hgi := integrable_comp_of_abs_le (μ := μ) hV hg hCg
  have h1 : ∀ A : Set α, MeasurableSet A →
      μ[fun ω => A.indicator (1 : α → ℝ) (U ω) * g (V ω) | m] =ᵐ[μ]
        μ[fun ω => A.indicator (1 : α → ℝ) (U ω) | m] * μ[fun ω => g (V ω) | m] :=
    fun A hA => condExp_mul_comm_of_eq (condExp_mul_eq_of_condExp_sup_eq hm hV
      (integrable_comp_of_abs_le hU (measurable_one.indicator hA) (abs_indicator_one_le A))
      (condExp_indicator_sup_eq_of_condIndepFun h hU hV hA) hg hCg)
  exact condExp_mul_eq_of_condExp_sup_eq hm hU hgi
    (condExp_sup_eq_of_forall_indicator_mul hm hU hgi h1) hf hCf

/-- **The regression form, forward direction.** If `U ⫫ V | m`, then
`E[f(U) | σ(V) ∨ m] = E[f(U) | m]` for every bounded measurable `f`. -/
theorem condExp_sup_eq_of_condIndepFun (h : CondIndepFun m hm U V μ) (hU : Measurable U)
    (hV : Measurable V) {f : α → ℝ} (hf : Measurable f) {C : ℝ} (hC : ∀ a, |f a| ≤ C) :
    μ[fun ω => f (U ω) | MeasurableSpace.comap V inferInstance ⊔ m] =ᵐ[μ]
      μ[fun ω => f (U ω) | m] :=
  condExp_sup_eq_of_forall_indicator_mul hm hV (integrable_comp_of_abs_le hU hf hC)
    fun B hB => condExp_mul_comm_of_eq (condExp_mul_eq_of_condIndepFun h hU hV hf
      (measurable_one.indicator hB) hC (abs_indicator_one_le B))

/-- **Indicators suffice for the regression form.** If
`E[1_A(U) | σ(V) ∨ m] = E[1_A(U) | m]` for every measurable `A`, then `U ⫫ V | m`. -/
theorem condIndepFun_of_forall_condExp_indicator_sup_eq (hU : Measurable U)
    (hV : Measurable V)
    (H : ∀ A : Set α, MeasurableSet A →
      μ[fun ω => A.indicator (1 : α → ℝ) (U ω) | MeasurableSpace.comap V inferInstance ⊔ m]
        =ᵐ[μ] μ[fun ω => A.indicator (1 : α → ℝ) (U ω) | m]) :
    CondIndepFun m hm U V μ := by
  refine (condIndepFun_iff_forall_indicator_mul hU hV).2 fun A hA B hB => ?_
  exact condExp_mul_comm_of_eq (condExp_mul_eq_of_condExp_sup_eq hm hV
    (integrable_comp_of_abs_le hU (measurable_one.indicator hA) (abs_indicator_one_le A))
    (H A hA) (measurable_one.indicator hB) (abs_indicator_one_le B))

/-- **The product rule for bounded test functions characterizes conditional independence**:
`U ⫫ V | m` if and only if `E[f(U) g(V) | m] = E[f(U) | m] E[g(V) | m]` almost everywhere for
all bounded measurable `f` and `g`. -/
theorem condIndepFun_iff_forall_condExp_mul_eq (hU : Measurable U) (hV : Measurable V) :
    CondIndepFun m hm U V μ ↔
      ∀ (f : α → ℝ) (g : β → ℝ), Measurable f → Measurable g → (∃ C, ∀ a, |f a| ≤ C) →
        (∃ C, ∀ b, |g b| ≤ C) →
        μ[fun ω => f (U ω) * g (V ω) | m] =ᵐ[μ]
          μ[fun ω => f (U ω) | m] * μ[fun ω => g (V ω) | m] := by
  refine ⟨fun h f g hf hg ⟨Cf, hCf⟩ ⟨Cg, hCg⟩ =>
    condExp_mul_eq_of_condIndepFun h hU hV hf hg hCf hCg,
    fun H => (condIndepFun_iff_forall_indicator_mul hU hV).2 fun A hA B hB => ?_⟩
  exact H _ _ (measurable_one.indicator hA) (measurable_one.indicator hB)
    ⟨1, abs_indicator_one_le A⟩ ⟨1, abs_indicator_one_le B⟩

/-- **The regression form of conditional independence**: `U ⫫ V | m` if and only if
`E[f(U) | σ(V) ∨ m] = E[f(U) | m]` almost everywhere for every bounded measurable `f`. -/
theorem condIndepFun_iff_forall_condExp_sup_eq (hU : Measurable U) (hV : Measurable V) :
    CondIndepFun m hm U V μ ↔
      ∀ f : α → ℝ, Measurable f → (∃ C, ∀ a, |f a| ≤ C) →
        μ[fun ω => f (U ω) | MeasurableSpace.comap V inferInstance ⊔ m] =ᵐ[μ]
          μ[fun ω => f (U ω) | m] :=
  ⟨fun h _ hf ⟨_, hC⟩ => condExp_sup_eq_of_condIndepFun h hU hV hf hC, fun H =>
    condIndepFun_of_forall_condExp_indicator_sup_eq hU hV fun A hA =>
      H _ (measurable_one.indicator hA) ⟨1, abs_indicator_one_le A⟩⟩

/-- **The regression form with indicators**: `U ⫫ V | m` if and only if
`E[1_A(U) | σ(V) ∨ m] = E[1_A(U) | m]` almost everywhere for every measurable `A`. -/
theorem condIndepFun_iff_forall_condExp_indicator_sup_eq (hU : Measurable U)
    (hV : Measurable V) :
    CondIndepFun m hm U V μ ↔
      ∀ A : Set α, MeasurableSet A →
        μ[fun ω => A.indicator (1 : α → ℝ) (U ω) | MeasurableSpace.comap V inferInstance ⊔ m]
          =ᵐ[μ] μ[fun ω => A.indicator (1 : α → ℝ) (U ω) | m] :=
  ⟨fun h _ hA => condExp_indicator_sup_eq_of_condIndepFun h hU hV hA,
    condIndepFun_of_forall_condExp_indicator_sup_eq hU hV⟩

/-- **The product rule with an integrable factor.** If `U ⫫ V | m`, `f` is bounded measurable and
`g(V)` is integrable, then `E[f(U) g(V) | m] = E[f(U) | m] E[g(V) | m]`. Conditioning on
`σ(V) ∨ m` first, `g(V)` pulls out and `E[f(U) | σ(V) ∨ m] = E[f(U) | m]`; then the factor
`E[f(U) | m]` pulls out given `m`. -/
theorem condExp_mul_eq_of_condIndepFun_of_integrable (h : CondIndepFun m hm U V μ)
    (hU : Measurable U) (hV : Measurable V) {f : α → ℝ} (hf : Measurable f) {C : ℝ}
    (hC : ∀ a, |f a| ≤ C) {g : β → ℝ} (hg : Measurable g)
    (hgi : Integrable (fun ω => g (V ω)) μ) :
    μ[fun ω => f (U ω) * g (V ω) | m] =ᵐ[μ]
      μ[fun ω => f (U ω) | m] * μ[fun ω => g (V ω) | m] := by
  have hle : MeasurableSpace.comap V inferInstance ⊔ m ≤ mΩ := sup_le hV.comap_le hm
  have hfU := integrable_comp_of_abs_le (μ := μ) hU hf hC
  have hfUb : ∀ᵐ ω ∂μ, ‖f (U ω)‖ ≤ C :=
    Filter.Eventually.of_forall fun ω => by rw [Real.norm_eq_abs]; exact hC (U ω)
  have hfg : Integrable ((fun ω => f (U ω)) * fun ω => g (V ω)) μ :=
    hgi.bdd_mul (hf.comp hU).aestronglyMeasurable hfUb
  have hgV : StronglyMeasurable[MeasurableSpace.comap V inferInstance ⊔ m]
      (fun ω => g (V ω)) :=
    ((hg.comp (comap_measurable V)).mono
      (le_sup_left : _ ≤ MeasurableSpace.comap V inferInstance ⊔ m) le_rfl).stronglyMeasurable
  have p1 : μ[(fun ω => f (U ω)) * (fun ω => g (V ω)) |
      MeasurableSpace.comap V inferInstance ⊔ m] =ᵐ[μ]
      μ[fun ω => f (U ω) | m] * fun ω => g (V ω) :=
    (condExp_mul_of_stronglyMeasurable_right hgV hfg hfU).trans
      ((condExp_sup_eq_of_condIndepFun h hU hV hf hC).mul (Filter.EventuallyEq.refl _ _))
  have hcg : Integrable (μ[fun ω => f (U ω) | m] * fun ω => g (V ω)) μ :=
    integrable_condExp.congr p1
  have p2 := condExp_mul_of_stronglyMeasurable_left (m := m) stronglyMeasurable_condExp hcg hgi
  exact (condExp_condExp_of_le (le_sup_right : m ≤ _) hle).symm.trans
    ((condExp_congr_ae p1).trans p2)

end Forms

/-! ### The semi-graphoid laws -/

section Graphoid

variable {Ω α β γ δ : Type*} {m mΩ : MeasurableSpace Ω} [StandardBorelSpace Ω]
  [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ] [MeasurableSpace δ]
  {μ : Measure Ω} [IsFiniteMeasure μ] {hm : m ≤ mΩ}
  {X : Ω → α} {Y : Ω → β} {Z : Ω → γ} {W : Ω → δ}

omit [MeasurableSpace γ] in
/-- **Decomposition**: `X ⫫ (Y, W) | m` implies `X ⫫ Y | m` (Mathlib's `CondIndepFun.comp` with the
first projection). -/
theorem condIndepFun_decomposition (h : CondIndepFun m hm X (fun ω => (Y ω, W ω)) μ) :
    CondIndepFun m hm X Y μ :=
  h.comp measurable_id measurable_fst

omit [MeasurableSpace γ] in
/-- **Weak union**: `X ⫫ (Y, W) | m` implies `X ⫫ Y | σ(W) ∨ m`. In regression form the hypothesis
says `E[1_A(X) | σ(Y, W) ∨ m] = E[1_A(X) | m]`; since `m ≤ σ(W) ∨ m ≤ σ(Y, W) ∨ m`, the tower
property gives `E[1_A(X) | σ(W) ∨ m] = E[1_A(X) | m]` as well. -/
theorem condIndepFun_weak_union (hX : Measurable X) (hY : Measurable Y) (hW : Measurable W)
    (h : CondIndepFun m hm X (fun ω => (Y ω, W ω)) μ) :
    CondIndepFun (MeasurableSpace.comap W inferInstance ⊔ m) (sup_le hW.comap_le hm) X Y μ := by
  refine condIndepFun_of_forall_condExp_indicator_sup_eq hX hY fun A hA => ?_
  have h1 := condExp_indicator_sup_eq_of_condIndepFun h hX (hY.prodMk hW) hA
  have e : MeasurableSpace.comap (fun ω => (Y ω, W ω)) inferInstance ⊔ m =
      MeasurableSpace.comap Y inferInstance ⊔ (MeasurableSpace.comap W inferInstance ⊔ m) := by
    rw [comap_prodMk_eq_sup, sup_assoc]
  rw [e] at h1
  have h2 := condExp_eq_of_le_of_le (μ := μ) (F := fun ω => A.indicator (1 : α → ℝ) (X ω))
    (le_sup_right : m ≤ MeasurableSpace.comap W inferInstance ⊔ m) le_sup_right
    (sup_le hY.comap_le (sup_le hW.comap_le hm)) h1
  exact h1.trans h2.symm

omit [MeasurableSpace γ] in
/-- **Contraction**: `X ⫫ Y | m` and `X ⫫ W | σ(Y) ∨ m` imply `X ⫫ (Y, W) | m`. In regression form:
`E[1_A(X) | σ(Y, W) ∨ m] = E[1_A(X) | σ(Y) ∨ m] = E[1_A(X) | m]`. -/
theorem condIndepFun_contraction (hX : Measurable X) (hY : Measurable Y) (hW : Measurable W)
    (h₁ : CondIndepFun m hm X Y μ)
    (h₂ : CondIndepFun (MeasurableSpace.comap Y inferInstance ⊔ m) (sup_le hY.comap_le hm)
      X W μ) :
    CondIndepFun m hm X (fun ω => (Y ω, W ω)) μ := by
  refine condIndepFun_of_forall_condExp_indicator_sup_eq hX (hY.prodMk hW) fun A hA => ?_
  have e : MeasurableSpace.comap (fun ω => (Y ω, W ω)) inferInstance ⊔ m =
      MeasurableSpace.comap W inferInstance ⊔ (MeasurableSpace.comap Y inferInstance ⊔ m) := by
    rw [comap_prodMk_eq_sup, sup_left_comm, sup_assoc]
  rw [e]
  exact (condExp_indicator_sup_eq_of_condIndepFun h₂ hX hW hA).trans
    (condExp_indicator_sup_eq_of_condIndepFun h₁ hX hY hA)

/-- **Weak union, with a conditioning variable**: `X ⫫ (Y, W) | Z` implies `X ⫫ Y | (Z, W)`. -/
theorem condIndepFun_weak_union_comap (hX : Measurable X) (hY : Measurable Y)
    (hZ : Measurable Z) (hW : Measurable W)
    (h : CondIndepFun (MeasurableSpace.comap Z inferInstance) hZ.comap_le X
      (fun ω => (Y ω, W ω)) μ) :
    CondIndepFun (MeasurableSpace.comap (fun ω => (Z ω, W ω)) inferInstance)
      (hZ.prodMk hW).comap_le X Y μ := by
  refine (condIndepFun_congr_sigma ?_ _ _).1 (condIndepFun_weak_union hX hY hW h)
  rw [comap_prodMk_eq_sup, sup_comm]

/-- **Contraction, with a conditioning variable**: `X ⫫ Y | Z` and `X ⫫ W | (Z, Y)` imply
`X ⫫ (Y, W) | Z`. -/
theorem condIndepFun_contraction_comap (hX : Measurable X) (hY : Measurable Y)
    (hZ : Measurable Z) (hW : Measurable W)
    (h₁ : CondIndepFun (MeasurableSpace.comap Z inferInstance) hZ.comap_le X Y μ)
    (h₂ : CondIndepFun (MeasurableSpace.comap (fun ω => (Z ω, Y ω)) inferInstance)
      (hZ.prodMk hY).comap_le X W μ) :
    CondIndepFun (MeasurableSpace.comap Z inferInstance) hZ.comap_le X
      (fun ω => (Y ω, W ω)) μ := by
  refine condIndepFun_contraction hX hY hW h₁ ((condIndepFun_congr_sigma ?_ _ _).1 h₂)
  rw [comap_prodMk_eq_sup, sup_comm]

end Graphoid

/-! ### Conditional independence given a constant -/

section Constant

variable {Ω α β γ : Type*} {mΩ : MeasurableSpace Ω} [StandardBorelSpace Ω]
  [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ] {μ : Measure Ω}
  [IsProbabilityMeasure μ] {U : Ω → α} {V : Ω → β}

omit [MeasurableSpace γ] in
/-- **Conditional independence given the trivial σ-algebra is independence**, for a probability
measure: given `⊥`, a conditional expectation is the plain expectation. (For a finite measure of
total mass other than one the statement fails: independence is then not the right notion.) -/
theorem condIndepFun_bot_iff_indepFun (hU : Measurable U) (hV : Measurable V) :
    CondIndepFun ⊥ bot_le U V μ ↔ IndepFun U V μ := by
  have hconst : ∀ a b : ℝ, ((fun _ => a) =ᵐ[μ] (fun _ : Ω => b)) ↔ a = b := fun a b =>
    Filter.eventually_const
  rw [condIndepFun_iff_forall_indicator_mul hU hV, indepFun_iff_measure_inter_preimage_eq_mul]
  simp only [condExp_bot]
  suffices key : ∀ A : Set α, MeasurableSet A → ∀ B : Set β, MeasurableSet B →
      (((fun _ : Ω => ∫ ω, A.indicator (1 : α → ℝ) (U ω) * B.indicator (1 : β → ℝ) (V ω) ∂μ)
        =ᵐ[μ] (fun _ : Ω => ∫ ω, A.indicator (1 : α → ℝ) (U ω) ∂μ) *
          (fun _ : Ω => ∫ ω, B.indicator (1 : β → ℝ) (V ω) ∂μ)) ↔
        μ (U ⁻¹' A ∩ V ⁻¹' B) = μ (U ⁻¹' A) * μ (V ⁻¹' B)) from
    ⟨fun H A B hA hB => (key A hA B hB).1 (H A hA B hB),
      fun H A hA B hB => (key A hA B hB).2 (H A B hA hB)⟩
  intro A hA B hB
  have e : (fun _ : Ω => ∫ ω, A.indicator (1 : α → ℝ) (U ω) ∂μ) *
      (fun _ : Ω => ∫ ω, B.indicator (1 : β → ℝ) (V ω) ∂μ) =
      fun _ => (∫ ω, A.indicator (1 : α → ℝ) (U ω) ∂μ) *
        ∫ ω, B.indicator (1 : β → ℝ) (V ω) ∂μ := rfl
  rw [e, hconst, ← indicator_one_comp, ← indicator_one_comp, ← indicator_one_inter_comp,
    integral_indicator_const _ ((hU hA).inter (hV hB)), integral_indicator_const _ (hU hA),
    integral_indicator_const _ (hV hB)]
  simp only [measureReal_def, smul_eq_mul, mul_one]
  rw [← ENNReal.toReal_mul]
  exact ENNReal.toReal_eq_toReal_iff' (measure_ne_top _ _)
    (ENNReal.mul_ne_top (measure_ne_top _ _) (measure_ne_top _ _))

/-- **Conditional independence given a constant variable is independence**, for a probability
measure: a constant generates the trivial σ-algebra. -/
theorem condIndepFun_comap_const_iff_indepFun (hU : Measurable U) (hV : Measurable V) (c : γ) :
    CondIndepFun (MeasurableSpace.comap (fun _ : Ω => c) inferInstance)
      (measurable_const (a := c)).comap_le U V μ ↔ IndepFun U V μ := by
  rw [condIndepFun_congr_sigma (MeasurableSpace.comap_const c) _ bot_le]
  exact condIndepFun_bot_iff_indepFun hU hV

end Constant

end CausalInference
