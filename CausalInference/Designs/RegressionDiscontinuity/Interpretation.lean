/-!
# Regression discontinuity: interpretation

Three interpretive facts about regression discontinuity designs described in NICE DSU
Technical Support Document 17 (R. Faria, M. Hernandez Alava, A. Manca, A. J. Wailoo, 2015, The
use of observational data to inform estimates of treatment effectiveness in technology
appraisal: methods for comparative individual patient data), Section 2.5.2 and Question 25.

The probability setting is that of `Sharp.lean` and `Fuzzy.lean`: everything is stated through
conditional mean functions of the running variable (versions of `E[· | X = x]`), so that no
conditioning on the null event `X = c` is needed; the law-level statements use Mathlib
conditional expectations given the sigma-algebra generated by the running variable.

## Main results

* No overlap in the sharp design (Section 2.5.2: "matching cannot be used because of the lack
  of overlap"). `CausalInference.RD.sharpTreatment_eq_zero_or_one` and
  `CausalInference.RD.sharpTreatment_no_overlap`: the treatment probability `1{x ≥ c}` is `0` or
  `1` at every `x`; `CausalInference.RD.ae_sharpPropensity_eq_zero_or_one`: every version of the
  propensity score `P(D = 1 | X)` is `0` or `1` almost surely.
  `CausalInference.RD.observedRegression_congr_untreated` and
  `CausalInference.RD.sharp_effect_above_not_identified`: the observed regression does not depend
  on `E[Y(0) | X = x]` above the cutoff, so above the cutoff the effect is not identified even
  among continuous mean functions; any estimate there is an extrapolation.
* The fuzzy design without selection on gains (Section 2.5.2: "local effects on randomly
  selected individuals"). `CausalInference.RD.FuzzyModel.fuzzy_rd_averageEffect_of_noGainSelection`:
  if at the cutoff the mean effect `E[Y(1) - Y(0) | stratum, X = c]` is the same in every
  principal stratum of positive share, the local Wald ratio equals the average treatment effect
  at the cutoff `E[Y(1) - Y(0) | X = c]`, not only the complier effect; no monotonicity is
  needed. `CausalInference.RD.FuzzyModel.fuzzy_rd_averageEffect_of_noGainSelection_of_condExp`
  is the law-level version for the model means, and
  `CausalInference.RD.FuzzyModel.fuzzy_rd_averageEffect_of_noGainSelection_of_potentialMeans`
  adds the hypothesis that the model describes the moments of both potential outcomes in every
  stratum, under which the average effect is a version of `E[Y(1) - Y(0) | σ(X)]`.
  `CausalInference.RD.FuzzyModel.gainSelection_counterexample`: with selection on gains
  (compliers gain `1`, never-takers gain `0`) and every other assumption in force, the ratio is
  `1` while the average effect at the cutoff is `1/2`.
* Manipulation of the running variable (Section 2.5.2 and Question 25: if individuals can
  manipulate the forcing variable, "individuals below and above the threshold are different in
  terms of the unobservables"). `CausalInference.RD.sorting_counterexample`: two types of units
  with untreated outcome `0` or `1`, each of probability `1 / 2`, uniformly distributed on
  `(-1, 1)` before sorting (density `1 / 2` there), with a constant unit effect `τ`. Before
  sorting `E[Y(0) | X = x]` is continuous at the cutoff `0` and the sharp jump is `τ`. After
  the low types just below the cutoff move just above it, `E[Y(0) | X = x]` has left limit
  `1` and right limit `1/3`, and every observed jump is `τ - 2/3 ≠ τ`.
  `CausalInference.RD.map_sortingMap_latent` checks that the post-sorting density of the low
  types is the pushforward of their latent law by the sorting map, and
  `CausalInference.RD.sorting_condExp` that the untreated mean functions are conditional
  expectations of `Y(0)` given the running variable under the joint law of type and
  running variable.

The general identification results are `CausalInference.RD.sharp_rd_identification` and
`CausalInference.RD.FuzzyModel.fuzzy_rd_complier_identification_of_arms`.
-/

@[expose] public section

open Filter Topology

namespace CausalInference

namespace RD

/-! ### The sharp design has no overlap -/

/-- In the sharp design the treatment probability `observedRegression c 1 0 = 1{x ≥ c}` takes
only the values `0` and `1`. -/
theorem sharpTreatment_eq_zero_or_one (c x : ℝ) :
    observedRegression c (fun _ => (1 : ℝ)) (fun _ => 0) x = 0 ∨
      observedRegression c (fun _ => (1 : ℝ)) (fun _ => 0) x = 1 := by
  unfold observedRegression
  split_ifs <;> simp

/-- **No overlap in the sharp design** (TSD 17, Section 2.5.2). The treatment probability
`P(D = 1 | X = x) = 1{x ≥ c}` of the sharp design lies strictly between `0` and `1` at no value
of the running variable: positivity fails everywhere. The same holds for the all-complier fuzzy
model (`FuzzyModel.sharp_treatmentProb_no_overlap`). -/
theorem sharpTreatment_no_overlap (c x : ℝ) :
    ¬ (0 < observedRegression c (fun _ => (1 : ℝ)) (fun _ => 0) x ∧
      observedRegression c (fun _ => (1 : ℝ)) (fun _ => 0) x < 1) := by
  rcases sharpTreatment_eq_zero_or_one c x with h | h <;> rw [h] <;> norm_num

/-- **No overlap in the all-complier fuzzy model.** The treatment probability of
`FuzzyModel.sharp m1 m0` is `0` or `1` at every value of the running variable, never strictly
between. -/
theorem FuzzyModel.sharp_treatmentProb_no_overlap (m1 m0 : ℝ → ℝ) (c x : ℝ) :
    ((FuzzyModel.sharp m1 m0).treatmentProb c x = 0 ∨
      (FuzzyModel.sharp m1 m0).treatmentProb c x = 1) ∧
    ¬ (0 < (FuzzyModel.sharp m1 m0).treatmentProb c x ∧
      (FuzzyModel.sharp m1 m0).treatmentProb c x < 1) := by
  rw [FuzzyModel.sharp_treatmentProb]
  exact ⟨sharpTreatment_eq_zero_or_one c x, sharpTreatment_no_overlap c x⟩

open MeasureTheory in
/-- **No overlap in the sharp design, law-level form.** On a probability space with measurable
running variable `X` and the sharp rule `D = 1{X ≥ c}`, every function `p` such that `p ∘ X` is
a version of the propensity score `E[1{D} | σ(X)]` takes only the values `0` and `1` almost
surely. -/
theorem ae_sharpPropensity_eq_zero_or_one {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {μ : Measure Ω} [IsProbabilityMeasure μ] {X : Ω → ℝ} (hX : Measurable X) (c : ℝ)
    {p : ℝ → ℝ}
    (hp : p ∘ X =ᵐ[μ] μ[fun ω => if c ≤ X ω then (1 : ℝ) else 0 |
      MeasurableSpace.comap X inferInstance]) :
    ∀ᵐ ω ∂μ, p (X ω) = 0 ∨ p (X ω) = 1 := by
  have h := condExp_observed_eq_observedRegression (μ := μ) hX (integrable_const (1 : ℝ))
    (integrable_const (0 : ℝ)) c (m1 := fun _ => 1) (m0 := fun _ => 0)
    (by rw [condExp_const hX.comap_le]; rfl) (by rw [condExp_const hX.comap_le]; rfl)
  filter_upwards [hp.trans h] with ω hω
  simp only [Function.comp_apply] at hω
  rw [hω]
  exact sharpTreatment_eq_zero_or_one c (X ω)

/-- The observed regression of the sharp design does not depend on the untreated mean function
at or above the cutoff: if `m0` and `m0'` agree below `c`, the observed regressions agree. -/
theorem observedRegression_congr_untreated {c : ℝ} (m1 : ℝ → ℝ) {m0 m0' : ℝ → ℝ}
    (h : ∀ x < c, m0 x = m0' x) :
    observedRegression c m1 m0 = observedRegression c m1 m0' := by
  funext x
  by_cases hx : c ≤ x
  · simp [observedRegression, hx]
  · simp [observedRegression, hx, h x (not_le.mp hx)]

/-- **Above the cutoff the sharp design does not identify the effect** (the "dangerous
extrapolation" of TSD 17, Section 2.5.2). The observed regression identifies `m1` above the
cutoff and `m0` below it, but not their difference away from the cutoff. There are two pairs
of everywhere continuous mean functions `(m1, m0) = (0, 0)` and
`(m1, m0') = (0, x ↦ max (x - c) 0)` with the same observed regression whose effects
`m1 x - m0 x` differ at every `x > c`. -/
theorem sharp_effect_above_not_identified (c : ℝ) :
    Continuous (fun _ : ℝ => (0 : ℝ)) ∧ Continuous (fun x : ℝ => max (x - c) 0) ∧
    observedRegression c (fun _ => 0) (fun _ => 0) =
      observedRegression c (fun _ => 0) (fun x => max (x - c) 0) ∧
    ∀ x, c < x → (0 : ℝ) - 0 ≠ 0 - max (x - c) 0 := by
  refine ⟨continuous_const, (continuous_id.sub continuous_const).max continuous_const,
    observedRegression_congr_untreated _ fun x hx => ?_, fun x hx => ?_⟩
  · simp [le_of_lt (sub_neg.mpr hx)]
  · rw [max_eq_left (le_of_lt (sub_pos.mpr hx))]
    linarith

/-! ### The fuzzy design without selection on gains -/

namespace FuzzyModel

variable {M : FuzzyModel}

/-- In a valid model, if at `c` every stratum of nonzero share has mean effect `τ`, the average
treatment effect at `c` is `τ`. -/
theorem IsValid.averageEffect_eq_of_noGainSelection (hM : M.IsValid) {c τ : ℝ}
    (hgain : ∀ t, M.share t c ≠ 0 → M.mean1 t c - M.mean0 t c = τ) :
    M.averageEffect c = τ := by
  have key : ∀ t, M.share t c * (M.mean1 t c - M.mean0 t c) = M.share t c * τ := by
    intro t
    by_cases hs : M.share t c = 0
    · simp [hs]
    · rw [hgain t hs]
  have hs := hM.share_sum c
  simp only [Stratum.sum] at hs
  simp only [averageEffect, Stratum.sum, key]
  linear_combination τ * hs

/-- **Fuzzy regression discontinuity without selection on gains** (TSD 17, Section 2.5.2: the
"local effects on randomly selected individuals" interpretation). Assume a valid model, the
one-sided continuity hypotheses `ArmsContinuousAtCutoff` at `c`, a jump in the treatment
probability, and no selection on gains at the cutoff: every principal stratum of nonzero share
at `c` has the same mean effect `τ = mean1 t c - mean0 t c`. Then the local Wald ratio equals
the share-weighted average effect `M.averageEffect c`, and both equal `τ`. No monotonicity is
needed: with equal gains the outcome jump is `τ (p_C - p_D)` and the treatment jump is
`p_C - p_D` (complier minus defier share), which the jump hypothesis makes nonzero. The
hypothesis is needed at `c` only; it restricts the never-revealed means
`mean1 neverTaker c` and `mean0 alwaysTaker c`, so it cannot be checked from the observed law.
`gainSelection_counterexample` shows it cannot be dropped. -/
theorem fuzzy_rd_averageEffect_of_noGainSelection {c τ : ℝ} (hM : M.IsValid)
    (hcont : M.ArmsContinuousAtCutoff c)
    (hgain : ∀ t, M.share t c ≠ 0 → M.mean1 t c - M.mean0 t c = τ)
    {pPlus pMinus yPlus yMinus : ℝ}
    (hpPlus : Tendsto (M.treatmentProb c) (𝓝[>] c) (𝓝 pPlus))
    (hpMinus : Tendsto (M.treatmentProb c) (𝓝[<] c) (𝓝 pMinus))
    (hyPlus : Tendsto (M.outcomeReg c) (𝓝[>] c) (𝓝 yPlus))
    (hyMinus : Tendsto (M.outcomeReg c) (𝓝[<] c) (𝓝 yMinus))
    (hjump : pPlus ≠ pMinus) :
    (yPlus - yMinus) / (pPlus - pMinus) = M.averageEffect c ∧ M.averageEffect c = τ := by
  obtain ⟨hne, hW⟩ := fuzzy_wald_identification hcont.treat_right hcont.treat_left
    hcont.mean_right hcont.mean_left hpPlus hpMinus hyPlus hyMinus hjump
  have hA := hM.averageEffect_eq_of_noGainSelection hgain
  have hg : ∀ t, M.share t c * (M.mean1 t c - M.mean0 t c) = M.share t c * τ := by
    intro t
    by_cases hs : M.share t c = 0
    · simp [hs]
    · rw [hgain t hs]
  have hd : M.armTreat true c - M.armTreat false c ≠ 0 := sub_ne_zero.mpr hne
  rw [armTreat_sub] at hd
  refine ⟨?_, hA⟩
  rw [hW, hA, armMean_sub, hg .complier, hg .defier, armTreat_sub, ← sub_mul,
    mul_div_cancel_left₀ _ hd]

open MeasureTheory in
/-- **Fuzzy regression discontinuity without selection on gains, from the observed law.**
Under the hypotheses of `fuzzy_rd_complier_identification_of_condExp` except local
monotonicity, and no selection on gains at the cutoff in the model means (every stratum of
nonzero share at `c` has `mean1 t c - mean0 t c = τ`), the ratio of the jumps of arbitrary
versions of `E[Y | σ(X)]` and `E[1{D} | σ(X)]` equals `M.averageEffect c`, and both equal `τ`.
`IsCondExpModel` ties to the probability space only the moments that each stratum reveals, so
here `M.averageEffect c` is a model quantity: the never-revealed means `mean1 neverTaker` and
`mean0 alwaysTaker` are free, and `hgain` may hold for the model while the true gains differ.
For the reading as the average treatment effect at the cutoff see
`fuzzy_rd_averageEffect_of_noGainSelection_of_potentialMeans`. -/
theorem fuzzy_rd_averageEffect_of_noGainSelection_of_condExp {Ω : Type*}
    {mΩ : MeasurableSpace Ω} {μ : Measure Ω} [IsProbabilityMeasure μ] {X : Ω → ℝ}
    {T : Ω → Stratum} {Y1 Y0 : Ω → ℝ} {c τ : ℝ}
    (hX : Measurable X) (hT : ∀ t, MeasurableSet (T ⁻¹' {t})) (hY1 : Integrable Y1 μ)
    (hY0 : Integrable Y0 μ) (hmodel : M.IsCondExpModel μ X T Y1 Y0) (hM : M.IsValid)
    (hcont : M.ArmsContinuousAtCutoff c)
    (hgain : ∀ t, M.share t c ≠ 0 → M.mean1 t c - M.mean0 t c = τ)
    (hright : RightSupport μ X c) (hleft : LeftSupport μ X c) {p r : ℝ → ℝ}
    (hp : p ∘ X =ᵐ[μ] μ[fun ω => if (T ω).treated (decide (c ≤ X ω)) then (1 : ℝ) else 0 |
      MeasurableSpace.comap X inferInstance])
    (hr : r ∘ X =ᵐ[μ] μ[fun ω => if (T ω).treated (decide (c ≤ X ω)) then Y1 ω else Y0 ω |
      MeasurableSpace.comap X inferInstance])
    {pPlus pMinus yPlus yMinus : ℝ} (hpPlus : Tendsto p (𝓝[>] c) (𝓝 pPlus))
    (hpMinus : Tendsto p (𝓝[<] c) (𝓝 pMinus)) (hyPlus : Tendsto r (𝓝[>] c) (𝓝 yPlus))
    (hyMinus : Tendsto r (𝓝[<] c) (𝓝 yMinus)) (hjump : pPlus ≠ pMinus) :
    (yPlus - yMinus) / (pPlus - pMinus) = M.averageEffect c ∧ M.averageEffect c = τ := by
  have hpae := hp.trans (hmodel.condExp_treatment_eq_treatmentProb hX hT c)
  have hrae := hr.trans (hmodel.condExp_outcome_eq_outcomeReg hX hT hY1 hY0 c)
  have tpR := tendsto_observedRegression_right (M.armTreat false) hcont.treat_right
  have tpL := tendsto_observedRegression_left (M.armTreat true) hcont.treat_left
  have tyR := tendsto_observedRegression_right (M.armMean false) hcont.mean_right
  have tyL := tendsto_observedRegression_left (M.armMean true) hcont.mean_left
  obtain rfl := tendsto_right_unique_of_ae_eq hpae hright hpPlus tpR
  obtain rfl := tendsto_left_unique_of_ae_eq hpae hleft hpMinus tpL
  obtain rfl := tendsto_right_unique_of_ae_eq hrae hright hyPlus tyR
  obtain rfl := tendsto_left_unique_of_ae_eq hrae hleft hyMinus tyL
  exact fuzzy_rd_averageEffect_of_noGainSelection hM hcont hgain tpR tpL tyR tyL hjump

section PotentialMeans

open MeasureTheory

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {μ : Measure Ω} {X : Ω → ℝ} {T : Ω → Stratum}
  {Y1 Y0 : Ω → ℝ}

/-- The model means describe **both** potential outcomes in every stratum: for every stratum
`t`, `ω ↦ M.share t (X ω) * M.mean1 t (X ω)` is a version of `E[1{T = t} Y(1) | σ(X)]` and
`ω ↦ M.share t (X ω) * M.mean0 t (X ω)` a version of `E[1{T = t} Y(0) | σ(X)]`. This covers the
never-revealed moments that `IsCondExpModel` leaves free. -/
def PotentialMeansCondExp (M : FuzzyModel) (μ : Measure Ω) (X : Ω → ℝ) (T : Ω → Stratum)
    (Y1 Y0 : Ω → ℝ) : Prop :=
  ∀ t, μ[(T ⁻¹' {t}).indicator Y1 | MeasurableSpace.comap X inferInstance] =ᵐ[μ]
      (fun ω => M.share t (X ω) * M.mean1 t (X ω)) ∧
    μ[(T ⁻¹' {t}).indicator Y0 | MeasurableSpace.comap X inferInstance] =ᵐ[μ]
      (fun ω => M.share t (X ω) * M.mean0 t (X ω))

/-- Under `PotentialMeansCondExp`, `M.averageEffect ∘ X` is a version of the conditional
average treatment effect `E[Y(1) - Y(0) | σ(X)]`. -/
theorem PotentialMeansCondExp.condExp_sub_eq_averageEffect
    (h : M.PotentialMeansCondExp μ X T Y1 Y0)
    (hT : ∀ t, MeasurableSet (T ⁻¹' {t})) (hY1 : Integrable Y1 μ) (hY0 : Integrable Y0 μ) :
    μ[fun ω => Y1 ω - Y0 ω | MeasurableSpace.comap X inferInstance] =ᵐ[μ]
      M.averageEffect ∘ X := by
  set f : Stratum → Ω → ℝ := fun t =>
    (T ⁻¹' {t}).indicator Y1 - (T ⁻¹' {t}).indicator Y0
  have heq : (fun ω => Y1 ω - Y0 ω) = fun ω => Stratum.sum fun t => f t ω := by
    funext ω
    cases hω : T ω <;> simp [f, Stratum.sum, Set.indicator, hω]
  have hf : ∀ t, Integrable (f t) μ := fun t => (hY1.indicator (hT t)).sub (hY0.indicator (hT t))
  rw [heq]
  refine condExp_stratumSum
    (g := fun t ω => M.share t (X ω) * (M.mean1 t (X ω) - M.mean0 t (X ω))) hf fun t => ?_
  filter_upwards [condExp_sub (hY1.indicator (hT t)) (hY0.indicator (hT t))
    (MeasurableSpace.comap X inferInstance), (h t).1, (h t).2] with ω h0 h1 h2
  simp only [f]
  rw [h0, Pi.sub_apply, h1, h2, mul_sub]

/-- Two functions of the running variable that agree almost surely along `X` agree at every
atom `c` of `X`. -/
theorem eq_of_ae_eq_of_atom {f g : ℝ → ℝ} (hfg : f ∘ X =ᵐ[μ] g ∘ X) {c : ℝ}
    (hc : μ (X ⁻¹' {c}) ≠ 0) : f c = g c := by
  by_contra hne
  refine hc (measure_mono_null (fun ω hω => ?_) (ae_iff.mp hfg))
  simp only [Set.mem_preimage, Set.mem_singleton_iff] at hω
  simp [hω, hne]

/-- **Fuzzy regression discontinuity without selection on gains: the average treatment effect
at the cutoff** (TSD 17, Section 2.5.2). Assume the hypotheses of
`fuzzy_rd_averageEffect_of_noGainSelection_of_condExp` and moreover that the model means are
versions of the conditional moments of both potential outcomes in every stratum
(`PotentialMeansCondExp`). Then the ratio of the observed jumps equals `M.averageEffect c = τ`,
`M.averageEffect ∘ X` is a version of `E[Y(1) - Y(0) | σ(X)]`, so `hgain` is now a statement
about the true conditional gains, and every version `g` of the conditional average treatment
effect takes the value `τ` at `c` when `X` has an atom at `c`. When `P(X = c) = 0` versions are
not determined at `c` by the law; the last conjunct gives `g c = τ` for every version `g` that
is right-continuous at `c` when `M.averageEffect` is right-continuous at `c` (with the right
support of `X` at `c`). Continuity of the chosen version is a hypothesis, not a consequence of
the law. -/
theorem fuzzy_rd_averageEffect_of_noGainSelection_of_potentialMeans
    [IsProbabilityMeasure μ] {c τ : ℝ}
    (hX : Measurable X) (hT : ∀ t, MeasurableSet (T ⁻¹' {t})) (hY1 : Integrable Y1 μ)
    (hY0 : Integrable Y0 μ) (hmodel : M.IsCondExpModel μ X T Y1 Y0)
    (hfull : M.PotentialMeansCondExp μ X T Y1 Y0) (hM : M.IsValid)
    (hcont : M.ArmsContinuousAtCutoff c)
    (hgain : ∀ t, M.share t c ≠ 0 → M.mean1 t c - M.mean0 t c = τ)
    (hright : RightSupport μ X c) (hleft : LeftSupport μ X c) {p r : ℝ → ℝ}
    (hp : p ∘ X =ᵐ[μ] μ[fun ω => if (T ω).treated (decide (c ≤ X ω)) then (1 : ℝ) else 0 |
      MeasurableSpace.comap X inferInstance])
    (hr : r ∘ X =ᵐ[μ] μ[fun ω => if (T ω).treated (decide (c ≤ X ω)) then Y1 ω else Y0 ω |
      MeasurableSpace.comap X inferInstance])
    {pPlus pMinus yPlus yMinus : ℝ} (hpPlus : Tendsto p (𝓝[>] c) (𝓝 pPlus))
    (hpMinus : Tendsto p (𝓝[<] c) (𝓝 pMinus)) (hyPlus : Tendsto r (𝓝[>] c) (𝓝 yPlus))
    (hyMinus : Tendsto r (𝓝[<] c) (𝓝 yMinus)) (hjump : pPlus ≠ pMinus) :
    (yPlus - yMinus) / (pPlus - pMinus) = M.averageEffect c ∧ M.averageEffect c = τ ∧
      μ[fun ω => Y1 ω - Y0 ω | MeasurableSpace.comap X inferInstance] =ᵐ[μ]
        M.averageEffect ∘ X ∧
      (∀ g : ℝ → ℝ, g ∘ X =ᵐ[μ] μ[fun ω => Y1 ω - Y0 ω | MeasurableSpace.comap X inferInstance] →
        μ (X ⁻¹' {c}) ≠ 0 → g c = τ) ∧
      (∀ g : ℝ → ℝ, g ∘ X =ᵐ[μ] μ[fun ω => Y1 ω - Y0 ω | MeasurableSpace.comap X inferInstance] →
        Tendsto g (𝓝[>] c) (𝓝 (g c)) →
        Tendsto M.averageEffect (𝓝[>] c) (𝓝 (M.averageEffect c)) → g c = τ) := by
  obtain ⟨hW, hA⟩ := fuzzy_rd_averageEffect_of_noGainSelection_of_condExp hX hT hY1 hY0 hmodel
    hM hcont hgain hright hleft hp hr hpPlus hpMinus hyPlus hyMinus hjump
  have hE := hfull.condExp_sub_eq_averageEffect hT hY1 hY0
  exact ⟨hW, hA, hE, fun g hg hc => (eq_of_ae_eq_of_atom (hg.trans hE) hc).trans hA,
    fun g hg hgc hAc => (tendsto_right_unique_of_ae_eq (hg.trans hE) hright hgc hAc).trans hA⟩

end PotentialMeans

/-- The countermodel with selection on gains: at every value of the running variable, half of
the units are compliers with mean potential outcomes `1` (treated) and `0` (untreated), and half
are never-takers with mean potential outcomes `0` and `0`. There are no always-takers and no
defiers. -/
noncomputable def gainSelectionModel : FuzzyModel where
  share t _ := if t = .complier then 1 / 2 else if t = .neverTaker then 1 / 2 else 0
  mean1 t _ := if t = .complier then 1 else 0
  mean0 _ _ := 0

/-- **Counterexample: selection on gains.** The model `gainSelectionModel` with cutoff `0` is
valid, satisfies the continuity condition `ContinuousAtCutoff`, has no defiers, and its treatment
probability jumps from `0` to `1/2` and its outcome regression from `0` to `1/2` at the
cutoff, so every hypothesis of
`fuzzy_rd_averageEffect_of_noGainSelection` holds except no selection on gains: compliers gain
`1` and never-takers gain `0`. For all limits of the observed regressions, the local Wald ratio
is `1` (the complier effect) while the average treatment effect at the cutoff is `1/2`. -/
theorem gainSelection_counterexample :
    gainSelectionModel.IsValid ∧ gainSelectionModel.ContinuousAtCutoff 0 ∧
    gainSelectionModel.share .defier 0 = 0 ∧
    Tendsto (gainSelectionModel.treatmentProb 0) (𝓝[>] 0) (𝓝 (1 / 2)) ∧
    Tendsto (gainSelectionModel.treatmentProb 0) (𝓝[<] 0) (𝓝 0) ∧
    Tendsto (gainSelectionModel.outcomeReg 0) (𝓝[>] 0) (𝓝 (1 / 2)) ∧
    Tendsto (gainSelectionModel.outcomeReg 0) (𝓝[<] 0) (𝓝 0) ∧
    gainSelectionModel.mean1 .complier 0 - gainSelectionModel.mean0 .complier 0 ≠
      gainSelectionModel.mean1 .neverTaker 0 - gainSelectionModel.mean0 .neverTaker 0 ∧
    gainSelectionModel.averageEffect 0 = 1 / 2 ∧
    ∀ pPlus pMinus yPlus yMinus : ℝ,
      Tendsto (gainSelectionModel.treatmentProb 0) (𝓝[>] 0) (𝓝 pPlus) →
      Tendsto (gainSelectionModel.treatmentProb 0) (𝓝[<] 0) (𝓝 pMinus) →
      Tendsto (gainSelectionModel.outcomeReg 0) (𝓝[>] 0) (𝓝 yPlus) →
      Tendsto (gainSelectionModel.outcomeReg 0) (𝓝[<] 0) (𝓝 yMinus) →
      (yPlus - yMinus) / (pPlus - pMinus) = 1 ∧
        (yPlus - yMinus) / (pPlus - pMinus) ≠ gainSelectionModel.averageEffect 0 := by
  have hV : gainSelectionModel.IsValid :=
    { share_nonneg := fun t x => by
        simp only [gainSelectionModel]
        split_ifs <;> norm_num
      share_sum := fun x => by
        simp [gainSelectionModel, Stratum.sum]
        norm_num }
  have hC : gainSelectionModel.ContinuousAtCutoff 0 := fun t =>
    ⟨continuousAt_const, fun _ => continuousAt_const, fun _ => continuousAt_const⟩
  have hD : gainSelectionModel.share .defier 0 = 0 := by simp [gainSelectionModel]
  have hT1 : gainSelectionModel.armTreat true 0 = 1 / 2 := by
    simp [armTreat, gainSelectionModel, Stratum.sum, Stratum.treated]
  have hT0 : gainSelectionModel.armTreat false 0 = 0 := by
    simp [armTreat, gainSelectionModel, Stratum.sum, Stratum.treated]
  have tpR : Tendsto (gainSelectionModel.treatmentProb 0) (𝓝[>] 0) (𝓝 (1 / 2)) :=
by
    have h := tendsto_observedRegression_right (gainSelectionModel.armTreat false)
      hC.arms.treat_right
    rwa [hT1] at h
  have tpL : Tendsto (gainSelectionModel.treatmentProb 0) (𝓝[<] 0) (𝓝 0) :=
by
    have h := tendsto_observedRegression_left (gainSelectionModel.armTreat true)
      hC.arms.treat_left
    rwa [hT0] at h
  have hM1 : gainSelectionModel.armMean true 0 = 1 / 2 := by
    simp [armMean, gainSelectionModel, Stratum.sum, Stratum.treated]
  have hM0 : gainSelectionModel.armMean false 0 = 0 := by
    simp [armMean, gainSelectionModel, Stratum.sum, Stratum.treated]
  have tyR : Tendsto (gainSelectionModel.outcomeReg 0) (𝓝[>] 0) (𝓝 (1 / 2)) := by
    have h := tendsto_observedRegression_right (gainSelectionModel.armMean false)
      hC.arms.mean_right
    rwa [hM1] at h
  have tyL : Tendsto (gainSelectionModel.outcomeReg 0) (𝓝[<] 0) (𝓝 0) := by
    have h := tendsto_observedRegression_left (gainSelectionModel.armMean true)
      hC.arms.mean_left
    rwa [hM0] at h
  have hAE : gainSelectionModel.averageEffect 0 = 1 / 2 := by
    simp [averageEffect, gainSelectionModel, Stratum.sum]
  refine ⟨hV, hC, hD, tpR, tpL, tyR, tyL, by simp [gainSelectionModel], hAE, ?_⟩
  intro pPlus pMinus yPlus yMinus hpPlus hpMinus hyPlus hyMinus
  have hjump : pPlus ≠ pMinus := by
    rw [tendsto_nhds_unique hpPlus tpR, tendsto_nhds_unique hpMinus tpL]
    norm_num
  have hW := (fuzzy_rd_complier_identification_of_arms hV hC.arms hD hpPlus hpMinus hyPlus
    hyMinus hjump).2.2.2
  have h1 : (yPlus - yMinus) / (pPlus - pMinus) = 1 := by
    rw [hW]
    simp [gainSelectionModel]
  refine ⟨h1, ?_⟩
  rw [h1, hAE]
  norm_num

end FuzzyModel

/-! ### Manipulation of the running variable: a sorting model -/

open MeasureTheory

open scoped ENNReal NNReal

/-- Probability density of the latent (pre-sorting) running variable of each type of unit in
the sorting model: uniform on `(-1, 1)`, with value `1 / 2` there. -/
noncomputable def sortingLatentDensity (x : ℝ) : ℝ :=
  Set.indicator (Set.Ioo (-1) 1) (fun _ => (1 / 2 : ℝ)) x

/-- Density of the running variable of the low types after sorting. Every low type whose latent
running variable `x'` lies in `[-1/2, 0)`, just below the cutoff `0`, moves to `x' + 1/2`, just
above it; the other units stay. So the post-sorting density is the latent density with the mass
on `[-1/2, 0)` removed and translated onto `[0, 1/2)`: the change of variables formula for the
pushforward of the latent law by the sorting map. -/
noncomputable def sortedLowDensity (x : ℝ) : ℝ :=
  (if x ∈ Set.Ico (-1 / 2) 0 then 0 else sortingLatentDensity x) +
    (if x ∈ Set.Ico 0 (1 / 2) then sortingLatentDensity (x - 1 / 2) else 0)

/-- The sorting map of the low types: a latent running variable `x'` in `[-1/2, 0)` (just below
the cutoff `0`) is moved to `x' + 1/2` (just above it); every other value is kept. -/
noncomputable def sortingMap (x : ℝ) : ℝ := if x ∈ Set.Ico (-1 / 2) 0 then x + 1 / 2 else x

/-- The law on the real line with density `f` against Lebesgue measure (`f` nonnegative). -/
noncomputable def densityLaw (f : ℝ → ℝ) : Measure ℝ :=
  volume.withDensity fun x => ENNReal.ofReal (f x)

theorem measurable_sortingLatentDensity : Measurable sortingLatentDensity :=
  measurable_const.indicator measurableSet_Ioo

theorem measurable_sortingMap : Measurable sortingMap :=
  Measurable.ite measurableSet_Ico (measurable_id.add_const _) measurable_id

theorem sortingLatentDensity_nonneg (x : ℝ) : 0 ≤ sortingLatentDensity x :=
  Set.indicator_nonneg (fun _ _ => by norm_num) x

theorem measurable_sortedLowDensity : Measurable sortedLowDensity :=
  (Measurable.ite measurableSet_Ico measurable_const measurable_sortingLatentDensity).add
    (Measurable.ite measurableSet_Ico
      (measurable_sortingLatentDensity.comp (measurable_id.sub_const _)) measurable_const)

theorem sortedLowDensity_nonneg (x : ℝ) : 0 ≤ sortedLowDensity x := by
  unfold sortedLowDensity
  have h1 := sortingLatentDensity_nonneg x
  have h2 := sortingLatentDensity_nonneg (x - 1 / 2)
  split_ifs <;> linarith

private theorem ofReal_half : ENNReal.ofReal (1 / 2) = 2⁻¹ := by
  rw [one_div, ENNReal.ofReal_inv_of_pos two_pos, ENNReal.ofReal_ofNat]

/-- The sorting map transports Lebesgue measure on `(-1, 1)` to Lebesgue measure on
`(-1, 1) \ [-1/2, 0)` plus Lebesgue measure on `[0, 1/2)`. -/
theorem map_sortingMap_indicator :
    (volume.withDensity ((Set.Ioo (-1 : ℝ) 1).indicator 1)).map sortingMap =
      volume.withDensity ((Set.Ioo (-1 : ℝ) 1 \ Set.Ico (-1 / 2) 0).indicator 1 +
        (Set.Ico (0 : ℝ) (1 / 2)).indicator 1) := by
  have hA : MeasurableSet (Set.Ico (-1 / 2 : ℝ) 0) := measurableSet_Ico
  have hB : MeasurableSet (Set.Ico (0 : ℝ) (1 / 2)) := measurableSet_Ico
  have hI : MeasurableSet (Set.Ioo (-1 : ℝ) 1) := measurableSet_Ioo
  have hAI : Set.Ico (-1 / 2 : ℝ) 0 ⊆ Set.Ioo (-1) 1 :=
    fun x hx => ⟨by linarith [hx.1], by linarith [hx.2]⟩
  have hf : Measurable sortingMap :=
    Measurable.ite hA (measurable_id.add_const _) measurable_id
  rw [withDensity_indicator_one hI,
    withDensity_add_left (measurable_one.indicator (hI.diff hA)),
    withDensity_indicator_one (hI.diff hA), withDensity_indicator_one hB,
    ← Measure.restrict_add_restrict_compl (μ := volume.restrict (Set.Ioo (-1 : ℝ) 1)) hA,
    Measure.restrict_restrict hA, Measure.restrict_restrict hA.compl,
    Set.inter_eq_left.mpr hAI, Measure.map_add _ _ hf, add_comm]
  congr 1
  · rw [Set.inter_comm, ← Set.sdiff_eq,
      Measure.map_congr (f := sortingMap) (g := id) ((ae_restrict_mem (hI.diff hA)).mono
        fun x hx => by simp [sortingMap, hx.2]), Measure.map_id]
  · have hpre : (fun x : ℝ => x + 1 / 2) ⁻¹' Set.Ico 0 (1 / 2) = Set.Ico (-1 / 2) 0 := by
      ext x
      simp only [Set.mem_preimage, Set.mem_Ico]
      constructor <;> intro h <;> constructor <;> linarith [h.1, h.2]
    rw [Measure.map_congr (f := sortingMap) (g := fun x : ℝ => x + 1 / 2)
        ((ae_restrict_mem hA).mono fun x hx => by simp only [sortingMap, hx, ↓reduceIte]),
      ← hpre, ← Measure.restrict_map (measurable_add_const (1 / 2 : ℝ)) hB,
      Measure.IsAddRightInvariant.map_add_right_eq_self]

/-- **The sorting mechanism.** `sortedLowDensity` is the density of the law of the running
variable of the low types after sorting: the pushforward by `sortingMap` of the latent law with
density `sortingLatentDensity` (uniform on `(-1, 1)`) is the law with density
`sortedLowDensity`. -/
theorem map_sortingMap_latent :
    (densityLaw sortingLatentDensity).map sortingMap = densityLaw sortedLowDensity := by
  have hA : MeasurableSet (Set.Ico (-1 / 2 : ℝ) 0) := measurableSet_Ico
  have hB : MeasurableSet (Set.Ico (0 : ℝ) (1 / 2)) := measurableSet_Ico
  have hI : MeasurableSet (Set.Ioo (-1 : ℝ) 1) := measurableSet_Ioo
  have hlat : (fun x => ENNReal.ofReal (sortingLatentDensity x)) =
      (2⁻¹ : ℝ≥0∞) • (Set.Ioo (-1 : ℝ) 1).indicator 1 := by
    funext x
    by_cases hx : x ∈ Set.Ioo (-1 : ℝ) 1 <;> simp [sortingLatentDensity, hx]
  have hsort : (fun x => ENNReal.ofReal (sortedLowDensity x)) =
      (2⁻¹ : ℝ≥0∞) • ((Set.Ioo (-1 : ℝ) 1 \ Set.Ico (-1 / 2) 0).indicator 1 +
        (Set.Ico (0 : ℝ) (1 / 2)).indicator 1) := by
    funext x
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    by_cases hxA : x ∈ Set.Ico (-1 / 2 : ℝ) 0
    · have hxB : x ∉ Set.Ico (0 : ℝ) (1 / 2) := fun h => by linarith [h.1, hxA.2]
      have hxD : x ∉ Set.Ioo (-1 : ℝ) 1 \ Set.Ico (-1 / 2) 0 := fun h => h.2 hxA
      simp only [sortedLowDensity, hxA, hxB, ↓reduceIte, Set.indicator_of_notMem hxB,
        Set.indicator_of_notMem hxD]
      norm_num
    · by_cases hxB : x ∈ Set.Ico (0 : ℝ) (1 / 2)
      · have hxI : x ∈ Set.Ioo (-1 : ℝ) 1 := ⟨by linarith [hxB.1], by linarith [hxB.2]⟩
        have hxI' : x - 1 / 2 ∈ Set.Ioo (-1 : ℝ) 1 :=
          ⟨by linarith [hxB.1], by linarith [hxB.2]⟩
        have hxD : x ∈ Set.Ioo (-1 : ℝ) 1 \ Set.Ico (-1 / 2) 0 := ⟨hxI, hxA⟩
        simp only [sortedLowDensity, sortingLatentDensity, hxA, hxB, ↓reduceIte,
          Set.indicator_of_mem hxI, Set.indicator_of_mem hxI', Set.indicator_of_mem hxD,
          Set.indicator_of_mem hxB, Pi.one_apply]
        norm_num
        exact (ENNReal.inv_mul_cancel two_ne_zero ENNReal.ofNat_ne_top).symm
      · by_cases hxI : x ∈ Set.Ioo (-1 : ℝ) 1
        · have hxD : x ∈ Set.Ioo (-1 : ℝ) 1 \ Set.Ico (-1 / 2) 0 := ⟨hxI, hxA⟩
          simp only [sortedLowDensity, sortingLatentDensity, hxA, hxB, ↓reduceIte,
            Set.indicator_of_mem hxI, Set.indicator_of_mem hxD, Set.indicator_of_notMem hxB,
            Pi.one_apply]
          rw [add_zero, add_zero, mul_one, ofReal_half]
        · have hxD : x ∉ Set.Ioo (-1 : ℝ) 1 \ Set.Ico (-1 / 2) 0 := fun h => hxI h.1
          simp only [sortedLowDensity, sortingLatentDensity, hxA, hxB, ↓reduceIte,
            Set.indicator_of_notMem hxI, Set.indicator_of_notMem hxD,
            Set.indicator_of_notMem hxB]
          simp
  rw [densityLaw, densityLaw, hlat, hsort,
    withDensity_smul _ (measurable_one.indicator hI),
    withDensity_smul _ ((measurable_one.indicator (hI.diff hA)).add
      (measurable_one.indicator hB)), Measure.map_smul _ measurable_sortingMap.aemeasurable,
    map_sortingMap_indicator]

/-- The latent law is a probability measure: the uniform law on `(-1, 1)`. -/
instance isProbabilityMeasure_latent : IsProbabilityMeasure (densityLaw sortingLatentDensity) := by
  constructor
  rw [densityLaw, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
  have : (fun x => ENNReal.ofReal (sortingLatentDensity x)) =
      (Set.Ioo (-1 : ℝ) 1).indicator fun _ => 2⁻¹ := by
    funext x
    by_cases hx : x ∈ Set.Ioo (-1 : ℝ) 1 <;> simp [sortingLatentDensity, hx]
  rw [this, lintegral_indicator_const measurableSet_Ioo, Real.volume_Ioo]
  norm_num
  rw [ENNReal.inv_mul_cancel two_ne_zero ENNReal.ofNat_ne_top]

/-- The law of the low types after sorting is a probability measure. -/
instance isProbabilityMeasure_sorted : IsProbabilityMeasure (densityLaw sortedLowDensity) := by
  rw [← map_sortingMap_latent]
  infer_instance

/-- The untreated mean function of the sorting model when the high types (untreated outcome
`1`) have running-variable density `sortingLatentDensity` and the low types (untreated outcome
`0`) have density `fLow`, each type with probability `1 / 2`: by Bayes' formula,
`E[Y(0) | X = x] = fHigh x / (fHigh x + fLow x)` (the common type probability cancels). The
denominator is positive on `(-1, 1)`, which contains every neighborhood used below;
`sortingUntreatedMean_condExp` proves that it is a conditional expectation under the joint law
`sortingJoint fLow`. -/
noncomputable def sortingUntreatedMean (fLow : ℝ → ℝ) (x : ℝ) : ℝ :=
  sortingLatentDensity x / (sortingLatentDensity x + fLow x)

/-- The joint law of (type, running variable) in the sorting model: with probability `1 / 2`
a high type (`true`, untreated outcome `1`) with running variable of density
`sortingLatentDensity`, and with probability `1 / 2` a low type (`false`, untreated outcome
`0`) with running variable of density `fLow`. -/
noncomputable def sortingJoint (fLow : ℝ → ℝ) : Measure (Bool × ℝ) :=
  (2⁻¹ : ℝ≥0) • (densityLaw sortingLatentDensity).map (Prod.mk true) +
    (2⁻¹ : ℝ≥0) • (densityLaw fLow).map (Prod.mk false)

instance {fLow : ℝ → ℝ} [IsFiniteMeasure (densityLaw fLow)] :
    IsFiniteMeasure (sortingJoint fLow) := by
  unfold sortingJoint; infer_instance

/-- The joint law is a probability measure when the law of the low types is. -/
theorem isProbabilityMeasure_sortingJoint {fLow : ℝ → ℝ}
    [IsProbabilityMeasure (densityLaw fLow)] : IsProbabilityMeasure (sortingJoint fLow) := by
  constructor
  rw [sortingJoint, add_apply, smul_apply, smul_apply, measure_univ,
    measure_univ]
  simp only [ENNReal.smul_def, smul_eq_mul, mul_one, ENNReal.coe_inv two_ne_zero]
  simp [ENNReal.inv_two_add_inv_two]

/-- Integrals over `{X ∈ A}` against the joint law split over the two types. -/
theorem setIntegral_sortingJoint {fLow : ℝ → ℝ} [IsFiniteMeasure (densityLaw fLow)]
    {g : Bool × ℝ → ℝ} (hg : Measurable g) (C : ℝ) (hC : ∀ p, |g p| ≤ C) {A : Set ℝ}
    (hA : MeasurableSet A) :
    ∫ p in Prod.snd ⁻¹' A, g p ∂sortingJoint fLow =
      2⁻¹ * ∫ x in A, g (true, x) ∂densityLaw sortingLatentDensity +
        2⁻¹ * ∫ x in A, g (false, x) ∂densityLaw fLow := by
  have hs : MeasurableSet (Prod.snd ⁻¹' A : Set (Bool × ℝ)) := measurable_snd hA
  have hint : ∀ (ν : Measure (Bool × ℝ)) [IsFiniteMeasure ν], Integrable g ν := fun ν _ =>
    Integrable.of_bound hg.aestronglyMeasurable C
      (ae_of_all _ fun p => by simpa [Real.norm_eq_abs] using hC p)
  rw [sortingJoint, Measure.restrict_add, Measure.restrict_smul, Measure.restrict_smul,
    integral_add_measure (hint _) (hint _), integral_smul_nnreal_measure,
    integral_smul_nnreal_measure,
    setIntegral_map hs hg.aestronglyMeasurable (measurable_prodMk_left).aemeasurable,
    setIntegral_map hs hg.aestronglyMeasurable (measurable_prodMk_left).aemeasurable]
  simp [NNReal.smul_def]
  rfl

/-- Bayes' formula in integrated form: integrating the untreated mean over `A` against the
sum of the two type laws gives the mass of `A` under the high type law. -/
theorem untreated_mass {fLow : ℝ → ℝ} (hfL : Measurable fLow) (hnn : ∀ x, 0 ≤ fLow x)
    [IsFiniteMeasure (densityLaw fLow)] {A : Set ℝ} (hA : MeasurableSet A) :
    ∫ x in A, sortingUntreatedMean fLow x ∂densityLaw sortingLatentDensity +
        ∫ x in A, sortingUntreatedMean fLow x ∂densityLaw fLow =
      (densityLaw sortingLatentDensity).real A := by
  have hm : Measurable (sortingUntreatedMean fLow) :=
    measurable_sortingLatentDensity.div (measurable_sortingLatentDensity.add hfL)
  have hm0 : ∀ x, 0 ≤ sortingUntreatedMean fLow x := fun x =>
    div_nonneg (sortingLatentDensity_nonneg x) (add_nonneg (sortingLatentDensity_nonneg x) (hnn x))
  have hm1 : ∀ x, sortingUntreatedMean fLow x ≤ 1 := fun x =>
    div_le_one_of_le₀ (le_add_of_nonneg_right (hnn x))
      (add_nonneg (sortingLatentDensity_nonneg x) (hnn x))
  have hint : ∀ (ν : Measure ℝ) [IsFiniteMeasure ν], Integrable (sortingUntreatedMean fLow) ν :=
    fun ν _ => Integrable.of_bound hm.aestronglyMeasurable 1 (ae_of_all _ fun x => by
      rw [Real.norm_eq_abs, abs_of_nonneg (hm0 x)]; exact hm1 x)
  have hrel : densityLaw sortingLatentDensity =
      (densityLaw sortingLatentDensity + densityLaw fLow).withDensity
        (fun x => ENNReal.ofReal (sortingUntreatedMean fLow x)) := by
    rw [densityLaw, densityLaw,
      ← withDensity_add_left measurable_sortingLatentDensity.ennreal_ofReal,
      ← withDensity_mul _ (measurable_sortingLatentDensity.ennreal_ofReal.add hfL.ennreal_ofReal)
        hm.ennreal_ofReal]
    congr 1
    funext x
    simp only [Pi.add_apply, Pi.mul_apply]
    rw [← ENNReal.ofReal_add (sortingLatentDensity_nonneg x) (hnn x),
      ← ENNReal.ofReal_mul (add_nonneg (sortingLatentDensity_nonneg x) (hnn x))]
    congr 1
    unfold sortingUntreatedMean
    by_cases h : sortingLatentDensity x + fLow x = 0
    · have h0 : sortingLatentDensity x = 0 := by
        linarith [sortingLatentDensity_nonneg x, hnn x]
      simp [h0]
    · field_simp
  rw [← integral_add_measure (hint _) (hint _), ← Measure.restrict_add,
    integral_eq_lintegral_of_nonneg_ae (ae_of_all _ hm0) hm.aestronglyMeasurable,
    Measure.real]
  conv_rhs => rw [hrel]
  rw [withDensity_apply _ hA]

/-- **The untreated mean is a conditional expectation.** For a measurable nonnegative density
`fLow` of the low types with finite total mass, `sortingUntreatedMean fLow` applied to the
running variable is a version of `E[Y(0) | σ(X)]` under the joint law `sortingJoint fLow`,
where `Y(0) = 1` for the high types and `0` for the low types and `X` is the second
coordinate. It applies before sorting (`fLow = sortingLatentDensity`) and after sorting
(`fLow = sortedLowDensity`); both joint laws are probability measures. -/
theorem sortingUntreatedMean_condExp {fLow : ℝ → ℝ} (hfL : Measurable fLow)
    (hnn : ∀ x, 0 ≤ fLow x) [IsFiniteMeasure (densityLaw fLow)] :
    (fun p : Bool × ℝ => sortingUntreatedMean fLow p.2) =ᵐ[sortingJoint fLow]
      (sortingJoint fLow)[fun p => if p.1 then (1 : ℝ) else 0 |
        MeasurableSpace.comap Prod.snd inferInstance] := by
  have hm : Measurable (sortingUntreatedMean fLow) :=
    measurable_sortingLatentDensity.div (measurable_sortingLatentDensity.add hfL)
  have hm0 : ∀ x, 0 ≤ sortingUntreatedMean fLow x := fun x =>
    div_nonneg (sortingLatentDensity_nonneg x) (add_nonneg (sortingLatentDensity_nonneg x) (hnn x))
  have hm1 : ∀ x, sortingUntreatedMean fLow x ≤ 1 := fun x =>
    div_le_one_of_le₀ (le_add_of_nonneg_right (hnn x))
      (add_nonneg (sortingLatentDensity_nonneg x) (hnn x))
  have hmb : ∀ p : Bool × ℝ, |sortingUntreatedMean fLow p.2| ≤ 1 := fun p => by
    rw [abs_of_nonneg (hm0 _)]; exact hm1 _
  have hY : Measurable fun p : Bool × ℝ => if p.1 then (1 : ℝ) else 0 :=
    (measurable_of_countable (fun b : Bool => if b then (1 : ℝ) else 0)).comp measurable_fst
  have hYb : ∀ p : Bool × ℝ, |(if p.1 then (1 : ℝ) else 0)| ≤ 1 := fun p => by
    split_ifs <;> simp
  refine ae_eq_condExp_of_forall_setIntegral_eq measurable_snd.comap_le
    (Integrable.of_bound hY.aestronglyMeasurable 1
      (ae_of_all _ fun p => by simpa [Real.norm_eq_abs] using hYb p))
    (fun s _ _ => (Integrable.of_bound (hm.comp measurable_snd).aestronglyMeasurable 1
      (ae_of_all _ fun p => by simpa [Real.norm_eq_abs] using hmb p)).integrableOn)
    (fun s hs _ => ?_)
    ((hm.comp (comap_measurable Prod.snd)).aestronglyMeasurable)
  obtain ⟨A, hA, rfl⟩ := hs
  rw [setIntegral_sortingJoint (g := fun p : Bool × ℝ => sortingUntreatedMean fLow p.2)
      (hm.comp measurable_snd) 1 hmb hA,
    setIntegral_sortingJoint (g := fun p : Bool × ℝ => if p.1 then (1 : ℝ) else 0) hY 1 hYb hA,
    ← mul_add, untreated_mass hfL hnn hA]
  simp

/-- **The sorting model on a probability space**, before and after sorting. Both joint laws of
(type, running variable) are probability measures, and in each the untreated mean function of
`sorting_counterexample` (`sortingUntreatedMean sortingLatentDensity` before sorting,
`sortingUntreatedMean sortedLowDensity` after) is a version of `E[Y(0) | σ(X)]`. -/
theorem sorting_condExp :
    IsProbabilityMeasure (sortingJoint sortingLatentDensity) ∧
      IsProbabilityMeasure (sortingJoint sortedLowDensity) ∧
      (fun p : Bool × ℝ => sortingUntreatedMean sortingLatentDensity p.2)
        =ᵐ[sortingJoint sortingLatentDensity]
        (sortingJoint sortingLatentDensity)[fun p => if p.1 then (1 : ℝ) else 0 |
          MeasurableSpace.comap Prod.snd inferInstance] ∧
      (fun p : Bool × ℝ => sortingUntreatedMean sortedLowDensity p.2)
        =ᵐ[sortingJoint sortedLowDensity]
        (sortingJoint sortedLowDensity)[fun p => if p.1 then (1 : ℝ) else 0 |
          MeasurableSpace.comap Prod.snd inferInstance] :=
  ⟨isProbabilityMeasure_sortingJoint, isProbabilityMeasure_sortingJoint,
    sortingUntreatedMean_condExp measurable_sortingLatentDensity sortingLatentDensity_nonneg,
    sortingUntreatedMean_condExp measurable_sortedLowDensity sortedLowDensity_nonneg⟩

/-- **Counterexample: sorting on the untreated outcome breaks regression discontinuity** (TSD 17,
Section 2.5.2 and Question 25). Two types of units, in equal numbers, have untreated outcome
`0` (low) or `1` (high) and a constant unit effect `τ`, so `E[Y(1) | X = x] = E[Y(0) | X = x] + τ`
for every law of the running variable. Before sorting both types are uniform on `(-1, 1)`, the
untreated mean `sortingUntreatedMean sortingLatentDensity` is continuous at the cutoff `0`, and
the sharp jump equals `τ`. The low types just below the cutoff then sort just above it
(`sortedLowDensity`). After sorting the untreated mean has left limit `1` and right limit `1/3`
at `0`; the observed regression of the sharp design has right limit `1/3 + τ` and left limit
`1`, so every observed jump equals `τ - 2/3`, which differs from the effect `τ` at every value
of the running variable. The untreated mean functions are given by Bayes' formula from the type
densities (`sortingUntreatedMean`); `sortingUntreatedMean_condExp` proves that each is a version
of `E[Y(0) | σ(X)]` under the joint probability law `sortingJoint` of type and running variable
(types of probability `1 / 2`, probability densities `sortingLatentDensity` and
`sortedLowDensity`), and `map_sortingMap_latent` checks that `sortedLowDensity` is the density
of the pushforward of the latent law by the sorting map. -/
theorem sorting_counterexample (τ : ℝ) :
    ContinuousAt (sortingUntreatedMean sortingLatentDensity) 0 ∧
    Tendsto (observedRegression 0 (fun x => sortingUntreatedMean sortingLatentDensity x + τ)
      (sortingUntreatedMean sortingLatentDensity)) (𝓝[>] 0) (𝓝 (1 / 2 + τ)) ∧
    Tendsto (observedRegression 0 (fun x => sortingUntreatedMean sortingLatentDensity x + τ)
      (sortingUntreatedMean sortingLatentDensity)) (𝓝[<] 0) (𝓝 (1 / 2)) ∧
    (∀ yPlus yMinus : ℝ,
      Tendsto (observedRegression 0 (fun x => sortingUntreatedMean sortingLatentDensity x + τ)
        (sortingUntreatedMean sortingLatentDensity)) (𝓝[>] 0) (𝓝 yPlus) →
      Tendsto (observedRegression 0 (fun x => sortingUntreatedMean sortingLatentDensity x + τ)
        (sortingUntreatedMean sortingLatentDensity)) (𝓝[<] 0) (𝓝 yMinus) →
      yPlus - yMinus = τ) ∧
    Tendsto (sortingUntreatedMean sortedLowDensity) (𝓝[<] 0) (𝓝 1) ∧
    Tendsto (sortingUntreatedMean sortedLowDensity) (𝓝[>] 0) (𝓝 (1 / 3)) ∧
    Tendsto (observedRegression 0 (fun x => sortingUntreatedMean sortedLowDensity x + τ)
      (sortingUntreatedMean sortedLowDensity)) (𝓝[>] 0) (𝓝 (1 / 3 + τ)) ∧
    Tendsto (observedRegression 0 (fun x => sortingUntreatedMean sortedLowDensity x + τ)
      (sortingUntreatedMean sortedLowDensity)) (𝓝[<] 0) (𝓝 1) ∧
    (∀ yPlus yMinus : ℝ,
      Tendsto (observedRegression 0 (fun x => sortingUntreatedMean sortedLowDensity x + τ)
        (sortingUntreatedMean sortedLowDensity)) (𝓝[>] 0) (𝓝 yPlus) →
      Tendsto (observedRegression 0 (fun x => sortingUntreatedMean sortedLowDensity x + τ)
        (sortingUntreatedMean sortedLowDensity)) (𝓝[<] 0) (𝓝 yMinus) →
      yPlus - yMinus = τ - 2 / 3 ∧ yPlus - yMinus ≠ τ) := by
  -- Values of the densities near the cutoff.
  have hpre : ∀ x ∈ Set.Ioo (-1 / 2 : ℝ) (1 / 2), sortingUntreatedMean sortingLatentDensity x =
      1 / 2 := by
    intro x hx
    have : sortingLatentDensity x = 1 / 2 := by
      simp [sortingLatentDensity, Set.indicator, Set.mem_Ioo]
      constructor <;> linarith [hx.1, hx.2]
    rw [sortingUntreatedMean, this]
    norm_num
  have hleft : ∀ x ∈ Set.Ioo (-1 / 2 : ℝ) 0, sortingUntreatedMean sortedLowDensity x = 1 := by
    intro x hx
    have h1 : sortingLatentDensity x = 1 / 2 := by
      simp [sortingLatentDensity, Set.indicator, Set.mem_Ioo]
      constructor <;> linarith [hx.1, hx.2]
    have h2 : sortedLowDensity x = 0 := by
      simp [sortedLowDensity, Set.mem_Ico, le_of_lt hx.1, hx.2, not_le.mpr hx.2]
    rw [sortingUntreatedMean, h1, h2]
    norm_num
  have hright : ∀ x ∈ Set.Ioo (0 : ℝ) (1 / 2), sortingUntreatedMean sortedLowDensity x =
      1 / 3 := by
    intro x hx
    have h1 : sortingLatentDensity x = 1 / 2 := by
      simp [sortingLatentDensity, Set.indicator, Set.mem_Ioo]
      constructor <;> linarith [hx.1, hx.2]
    have h1' : sortingLatentDensity (x - 1 / 2) = 1 / 2 := by
      simp [sortingLatentDensity, Set.indicator, Set.mem_Ioo]
      constructor <;> linarith [hx.1, hx.2]
    have h2 : sortedLowDensity x = 1 := by
      simp only [sortedLowDensity, Set.mem_Ico, h1, h1', not_lt.mpr (le_of_lt hx.1),
        and_false, ite_false, le_of_lt hx.1, hx.2, and_self, ite_true]
      norm_num
    rw [sortingUntreatedMean, h1, h2]
    norm_num
  -- Limits.
  have hpreC : Tendsto (sortingUntreatedMean sortingLatentDensity) (𝓝 0) (𝓝 (1 / 2)) :=
    tendsto_const_nhds.congr' (Filter.eventually_of_mem (Ioo_mem_nhds (by norm_num)
      (by norm_num)) fun x hx => (hpre x hx).symm)
  have hpre0 : sortingUntreatedMean sortingLatentDensity 0 = 1 / 2 :=
    hpre 0 ⟨by norm_num, by norm_num⟩
  have hL : Tendsto (sortingUntreatedMean sortedLowDensity) (𝓝[<] 0) (𝓝 1) :=
    tendsto_const_nhds.congr' (Filter.eventually_of_mem (Ioo_mem_nhdsLT (by norm_num))
      fun x hx => (hleft x hx).symm)
  have hR : Tendsto (sortingUntreatedMean sortedLowDensity) (𝓝[>] 0) (𝓝 (1 / 3)) :=
    tendsto_const_nhds.congr' (Filter.eventually_of_mem (Ioo_mem_nhdsGT (by norm_num))
      fun x hx => (hright x hx).symm)
  have hc : Tendsto (sortingUntreatedMean sortingLatentDensity) (𝓝 0)
      (𝓝 (sortingUntreatedMean sortingLatentDensity 0)) := by
    rw [hpre0]
    exact hpreC
  have preR : Tendsto (observedRegression 0
      (fun x => sortingUntreatedMean sortingLatentDensity x + τ)
      (sortingUntreatedMean sortingLatentDensity)) (𝓝[>] 0) (𝓝 (1 / 2 + τ)) :=
    tendsto_nhdsWithin_congr (fun x hx =>
      (observedRegression_of_le _ _ (le_of_lt (Set.mem_Ioi.mp hx))).symm)
      ((hpreC.add tendsto_const_nhds).mono_left nhdsWithin_le_nhds)
  have preL : Tendsto (observedRegression 0
      (fun x => sortingUntreatedMean sortingLatentDensity x + τ)
      (sortingUntreatedMean sortingLatentDensity)) (𝓝[<] 0) (𝓝 (1 / 2)) :=
    tendsto_nhdsWithin_congr (fun x hx =>
      (observedRegression_of_lt _ _ (Set.mem_Iio.mp hx)).symm)
      (hpreC.mono_left nhdsWithin_le_nhds)
  have postR : Tendsto (observedRegression 0
      (fun x => sortingUntreatedMean sortedLowDensity x + τ)
      (sortingUntreatedMean sortedLowDensity)) (𝓝[>] 0) (𝓝 (1 / 3 + τ)) :=
    tendsto_nhdsWithin_congr (fun x hx =>
      (observedRegression_of_le _ _ (le_of_lt (Set.mem_Ioi.mp hx))).symm)
      (hR.add tendsto_const_nhds)
  have postL : Tendsto (observedRegression 0
      (fun x => sortingUntreatedMean sortedLowDensity x + τ)
      (sortingUntreatedMean sortedLowDensity)) (𝓝[<] 0) (𝓝 1) :=
    tendsto_nhdsWithin_congr (fun x hx =>
      (observedRegression_of_lt _ _ (Set.mem_Iio.mp hx)).symm) hL
  refine ⟨hc, preR, preL, fun yPlus yMinus hPlus hMinus => ?_, hL, hR, postR, postL,
    fun yPlus yMinus hPlus hMinus => ?_⟩
  · have h := sharp_rd_identification
      ((hc.add tendsto_const_nhds).mono_left nhdsWithin_le_nhds)
      (hc.mono_left nhdsWithin_le_nhds) hPlus hMinus
    rw [h]
    ring
  · rw [tendsto_nhds_unique hPlus postR, tendsto_nhds_unique hMinus postL]
    constructor
    · ring
    · intro h
      linarith

end RD

end CausalInference
