module

public import CausalInference.LinearSEM.SingleDoor
public import CausalInference.InstrumentalVariables.LinearIV

/-!
# The instrumental variable formula of a linear SEM as a linear IV model

`CausalInference.LinearSEM.iv_ratio` is a statement about the matrix `Σ = T Ω Tᵀ` implied by a
linear SEM, and `CausalInference.LinearIVModel.beta_eq_covRatio` is a statement about random
variables on a probability space. This file joins the two. A realization of the errors of a
linear SEM `M` is a family of square integrable random variables `ε v` on a probability space
whose covariance matrix is `Ω`; the variables of the model are then `X = T ε`, the unique
solution of `X = B X + ε`, and their covariance matrix is `Σ`. For a treatment `x`, an outcome
`y` and an instrument `z`, the realized variables form a `LinearIVModel` with treatment `X x`,
instrument `X z`, outcome `X y` and error `X y - β X x`.

## Main definitions

* `LinearSEM.ErrorRealization M μ ε`: the errors `ε v` are square integrable under `μ` and
  `cov[ε a, ε b; μ] = Ω a b`.
* `LinearSEM.realize M ε`: the variables `X v = ∑ a, T v a ε a`.
* `LinearSEM.toLinearIVModel M ε x y z β`: the linear IV model `X y = β X x + U` with
  `U = X y - β X x`, treatment `X x` and instrument `X z`.

## Main results

* `LinearSEM.realize_eq_structural`: the realized variables solve `X = B X + ε` pointwise.
* `LinearSEM.covariance_realize`, `LinearSEM.covariance_realize_error`: `cov[X v, X w] = Σ v w`
  and `cov[X v, ε w] = (T Ω) v w`.
* `LinearSEM.toLinearIVModel_covRatio`: the covariance ratio of the IV model is the matrix ratio
  `Σ z y / Σ z x`, for every `β`; `LinearSEM.toLinearIVModel_relevance_iff`: relevance of the IV
  model is the nonzero first stage `Σ z x ≠ 0`; `LinearSEM.toLinearIVModel_exogeneity_iff`:
  exogeneity is `Σ z y = β Σ z x`.
* `LinearSEM.iv_ratio_eq_linearIV`: under the hypotheses of `LinearSEM.iv_ratio` (`x` is the
  only variable in the equation for `y`, with coefficient `α`; `z` uncorrelated with `ε y`; a
  nonzero first stage `Σ z x ≠ 0`), the IV model with `β = α` has finite second moments, is
  exogenous and relevant, its error is `ε y`, and the matrix ratio `Σ z y / Σ z x`, the
  probabilistic covariance ratio `Cov(Z, Y) / Cov(Z, D)` and `α` coincide.
* `LinearSEM.iv_ratio_eq_linearIV_of_isDiag`: the same with the exogeneity hypothesis derived
  from the graph: diagonal `Ω` and `z` not a descendant of `y`.
* `LinearSEM.IVExample.iv_identifies`: the chain `Z → X → Y` with errors realized on two fair
  coins satisfies all these hypotheses together.

The nonzero first stage is a hypothesis on the particular parameters: a directed path from `z`
to `x` does not imply `Σ z x ≠ 0` (coefficients along different paths can cancel).

Source: J. Pearl (2009), *Causality*, 2nd edition, Section 3.5 (the instrumental variable
formula) and Section 5.3.1.
-/

@[expose] public section

namespace CausalInference

namespace LinearSEM

open MeasureTheory ProbabilityTheory Matrix Relation

variable {V : Type*} [Fintype V] [DecidableEq V] (M : LinearSEM V)
variable {S : Type*}

/-- A realization of the errors of the linear SEM `M` on the measure space `(S, μ)`: random
variables `ε v`, one for each vertex, that are square integrable and whose covariance matrix is
the error covariance `Ω` of `M`. -/
structure ErrorRealization [MeasurableSpace S] (μ : Measure S) (ε : V → S → ℝ) : Prop where
  /-- Every error is square integrable. -/
  memLp : ∀ v, MemLp (ε v) 2 μ
  /-- The covariance matrix of the errors is `Ω`. -/
  cov_eq : ∀ a b, cov[ε a, ε b; μ] = M.Ω a b

/-- The variables of `M` generated by the errors `ε`: `X v = ∑ a, T v a ε a`, that is, `X = T ε`
at every sample point. -/
def realize (ε : V → S → ℝ) (v : V) (ω : S) : ℝ := ∑ a, M.T v a * ε a ω

/-- The realized variables solve the structural equations `X = B X + ε` at every sample point;
by `LinearSEM.solution_iff` they are the unique solution. -/
theorem realize_eq_structural (ε : V → S → ℝ) (ω : S) :
    (fun v => M.realize ε v ω) = M.B *ᵥ (fun v => M.realize ε v ω) + fun v => ε v ω :=
  (M.solution_iff _ _).2 rfl

/-- The structural equation of `y` for the realized variables. -/
theorem realize_apply_eq (ε : V → S → ℝ) (y : V) (ω : S) :
    M.realize ε y ω = ∑ p, M.B y p * M.realize ε p ω + ε y ω := by
  have h := congrFun (M.realize_eq_structural ε ω) y
  simpa [Matrix.mulVec, dotProduct] using h

variable [MeasurableSpace S] {M} {μ : Measure S} {ε : V → S → ℝ}

/-- The realized variables are square integrable. -/
theorem ErrorRealization.memLp_realize (h : M.ErrorRealization μ ε) (v : V) :
    MemLp (M.realize ε v) 2 μ := by
  have : M.realize ε v = ∑ a, fun ω => M.T v a * ε a ω := by
    funext ω; simp [realize]
  rw [this]
  exact memLp_finsetSum' _ fun a _ => (h.memLp a).const_mul _

/-- The covariance of a realized variable with an error: `cov[X v, ε w] = (T Ω) v w`. -/
theorem ErrorRealization.covariance_realize_error [IsFiniteMeasure μ]
    (h : M.ErrorRealization μ ε) (v w : V) :
    cov[M.realize ε v, ε w; μ] = (M.T * M.Ω) v w := by
  have : M.realize ε v = fun ω => ∑ a, (fun ω => M.T v a * ε a ω) ω := rfl
  rw [this, covariance_fun_sum_left (fun a => (h.memLp a).const_mul _) (h.memLp w),
    Matrix.mul_apply]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [covariance_const_mul_left, h.cov_eq]

/-- The covariance matrix of the realized variables is the implied covariance matrix:
`cov[X v, X w] = Σ v w`. -/
theorem ErrorRealization.covariance_realize [IsFiniteMeasure μ] (h : M.ErrorRealization μ ε)
    (v w : V) : cov[M.realize ε v, M.realize ε w; μ] = M.cov v w := by
  have : M.realize ε w = fun ω => ∑ b, (fun ω => M.T w b * ε b ω) ω := rfl
  rw [this, covariance_fun_sum_right (fun b => (h.memLp b).const_mul _) (h.memLp_realize v),
    cov_apply]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun b _ => ?_
  rw [covariance_const_mul_right, h.covariance_realize_error, Matrix.mul_apply, Finset.mul_sum]
  exact Finset.sum_congr rfl fun a _ => by ring

variable (M ε)

/-- The linear IV model of the realized SEM for treatment `x`, outcome `y`, instrument `z` and
slope `β`: treatment `D = X x`, instrument `Z = X z`, intercept `0`, and error
`U = X y - β X x`, so that its outcome `Y = β D + U` is `X y`. -/
noncomputable def toLinearIVModel (x y z : V) (β : ℝ) : LinearIVModel S where
  α := 0
  β := β
  D := M.realize ε x
  Z := M.realize ε z
  U ω := M.realize ε y ω - β * M.realize ε x ω

omit [MeasurableSpace S] in
/-- The outcome of the IV model is the realized outcome `X y`. -/
theorem toLinearIVModel_Y (x y z : V) (β : ℝ) :
    (M.toLinearIVModel ε x y z β).Y = M.realize ε y := by
  funext ω
  simp only [LinearIVModel.Y, toLinearIVModel]
  ring

variable {M ε}

/-- The IV model of a realization has finite second moments. -/
theorem ErrorRealization.toLinearIVModel_secondMoments (h : M.ErrorRealization μ ε)
    (x y z : V) (β : ℝ) : (M.toLinearIVModel ε x y z β).SecondMoments μ where
  memLp_D := h.memLp_realize x
  memLp_Z := h.memLp_realize z
  memLp_U := (h.memLp_realize y).sub ((h.memLp_realize x).const_mul β)

/-- The covariance ratio of the IV model is the matrix covariance ratio `Σ z y / Σ z x`, for
every slope `β` and without further hypotheses (both sides use Lean's convention `t / 0 = 0`;
the relevant reading needs `Σ z x ≠ 0`, see `toLinearIVModel_relevance_iff`). -/
theorem ErrorRealization.toLinearIVModel_covRatio [IsFiniteMeasure μ]
    (h : M.ErrorRealization μ ε) (x y z : V) (β : ℝ) :
    cov[(M.toLinearIVModel ε x y z β).Z, (M.toLinearIVModel ε x y z β).Y; μ] /
        cov[(M.toLinearIVModel ε x y z β).Z, (M.toLinearIVModel ε x y z β).D; μ] =
      M.cov z y / M.cov z x := by
  rw [toLinearIVModel_Y]
  exact congrArg₂ (· / ·) (h.covariance_realize z y) (h.covariance_realize z x)

/-- Relevance of the IV model is the nonzero first stage `Σ z x ≠ 0` of the SEM. -/
theorem ErrorRealization.toLinearIVModel_relevance_iff [IsFiniteMeasure μ]
    (h : M.ErrorRealization μ ε) (x y z : V) (β : ℝ) :
    (M.toLinearIVModel ε x y z β).Relevance μ ↔ M.cov z x ≠ 0 := by
  rw [LinearIVModel.Relevance]
  exact iff_of_eq (congrArg (· ≠ 0) (h.covariance_realize z x))

/-- Exogeneity of the IV model with slope `β` is the moment condition `Σ z y = β Σ z x`. -/
theorem ErrorRealization.toLinearIVModel_exogeneity_iff [IsFiniteMeasure μ]
    (h : M.ErrorRealization μ ε) (x y z : V) (β : ℝ) :
    (M.toLinearIVModel ε x y z β).Exogeneity μ ↔ M.cov z y = β * M.cov z x := by
  have hU : (M.toLinearIVModel ε x y z β).U =
      M.realize ε y - fun ω => β * M.realize ε x ω := rfl
  have hZ : (M.toLinearIVModel ε x y z β).Z = M.realize ε z := rfl
  rw [LinearIVModel.Exogeneity, hU, hZ, covariance_sub_right (h.memLp_realize z) (h.memLp_realize y)
    ((h.memLp_realize x).const_mul β), covariance_const_mul_right, h.covariance_realize,
    h.covariance_realize, sub_eq_zero]

omit [MeasurableSpace S] in
/-- If `x` is the only variable in the equation for `y`, with coefficient `α`, the error of the
IV model with slope `α` is the structural error `ε y`. -/
theorem toLinearIVModel_U_eq_error {x y : V} {α : ℝ}
    (hB : ∀ p, M.B y p = if p = x then α else 0) (z : V) :
    (M.toLinearIVModel ε x y z α).U = ε y := by
  funext ω
  simp only [toLinearIVModel]
  rw [M.realize_apply_eq ε y ω]
  simp [hB]

/-- **The linear SEM instrumental variable formula as a linear IV model.** Let the errors of `M`
be realized on a probability space with covariance `Ω`. Suppose that `x` is the only variable in
the equation for `y`, with coefficient `α`, that the instrument `z` is uncorrelated with the
error `ε y` (`(T Ω) z y = 0`), and that the first stage is nonzero (`Σ z x ≠ 0`). Then the IV
model with treatment `X x`, instrument `X z`, outcome `X y` and slope `α` has finite second
moments, its error is `ε y`, it satisfies exogeneity and relevance, and the matrix covariance
ratio of `LinearSEM.iv_ratio`, the covariance ratio of `LinearIVModel.beta_eq_covRatio` and `α`
coincide. -/
theorem iv_ratio_eq_linearIV [IsProbabilityMeasure μ] (h : M.ErrorRealization μ ε)
    {x y z : V} {α : ℝ} (hB : ∀ p, M.B y p = if p = x then α else 0)
    (hz : (M.T * M.Ω) z y = 0) (hzx : M.cov z x ≠ 0) :
    (M.toLinearIVModel ε x y z α).SecondMoments μ ∧
      (M.toLinearIVModel ε x y z α).U = ε y ∧
      (M.toLinearIVModel ε x y z α).Exogeneity μ ∧
      (M.toLinearIVModel ε x y z α).Relevance μ ∧
      M.cov z y / M.cov z x =
        cov[(M.toLinearIVModel ε x y z α).Z, (M.toLinearIVModel ε x y z α).Y; μ] /
          cov[(M.toLinearIVModel ε x y z α).Z, (M.toLinearIVModel ε x y z α).D; μ] ∧
      M.cov z y / M.cov z x = α := by
  have hmom := h.toLinearIVModel_secondMoments x y z α
  have hE : (M.toLinearIVModel ε x y z α).Exogeneity μ :=
    (h.toLinearIVModel_exogeneity_iff x y z α).2 (M.cov_instrument hB hz)
  have hR := (h.toLinearIVModel_relevance_iff x y z α).2 hzx
  refine ⟨hmom, toLinearIVModel_U_eq_error hB z, hE, hR,
    (h.toLinearIVModel_covRatio x y z α).symm, ?_⟩
  rw [← h.toLinearIVModel_covRatio x y z α, ← LinearIVModel.beta_eq_covRatio hmom hE hR]
  rfl

/-- The same with exogeneity derived from the graph: with uncorrelated errors (diagonal `Ω`) and
an instrument `z` that is not a descendant of `y` (`z ≠ y` and no directed path from `y` to `z`),
`z` is uncorrelated with `ε y`. With `x` the only variable in the equation for `y` (coefficient
`α`) and a nonzero first stage `Σ z x ≠ 0`, the IV model with slope `α` is exogenous and relevant
and its covariance ratio is `α`. The first stage is a separate hypothesis: no graphical condition
on `z` and `x` alone makes it nonzero for every choice of parameters. -/
theorem iv_ratio_eq_linearIV_of_isDiag [IsProbabilityMeasure μ] (h : M.ErrorRealization μ ε)
    (hΩ : M.Ω.IsDiag) {x y z : V} {α : ℝ} (hB : ∀ p, M.B y p = if p = x then α else 0)
    (hzy : ¬ ReflTransGen M.G.Adj y z) (hzx : M.cov z x ≠ 0) :
    (M.toLinearIVModel ε x y z α).Exogeneity μ ∧
      (M.toLinearIVModel ε x y z α).Relevance μ ∧
      cov[(M.toLinearIVModel ε x y z α).Z, (M.toLinearIVModel ε x y z α).Y; μ] /
          cov[(M.toLinearIVModel ε x y z α).Z, (M.toLinearIVModel ε x y z α).D; μ] = α := by
  have hz : (M.T * M.Ω) z y = 0 := by
    rw [M.T_mul_Ω_apply_of_isDiag hΩ, M.T_apply_eq_zero hzy, zero_mul]
  obtain ⟨-, -, hE, hR, h1, h2⟩ := iv_ratio_eq_linearIV h hB hz hzx
  exact ⟨hE, hR, h1 ▸ h2⟩

/-! ### A realization in which every hypothesis holds -/

namespace IVExample

open LinearIVExample

/-- The sign coding of a fair coin: `1` for `true`, `-1` for `false`. -/
def sgn (b : Bool) : ℝ := if b then 1 else -1

/-- Errors for the chain `0 → 1 → 2` of `DescendantExample.model`, on two independent fair coins:
the sign of the first coin, the sign of the second, and their product. They are pairwise
uncorrelated with variance one (they are not independent as a triple). -/
noncomputable def errors : Fin 3 → Bool × Bool → ℝ :=
  ![fun p => sgn p.1, fun p => sgn p.2, fun p => sgn p.1 * sgn p.2]

/-- The errors realize the identity error covariance of `DescendantExample.model`. -/
theorem errorRealization : DescendantExample.model.ErrorRealization coins errors where
  memLp v := memLp_coins fun ⟨a, b⟩ => by
    fin_cases v <;> cases a <;> cases b <;> norm_num [errors, sgn]
  cov_eq a b := by
    fin_cases a <;> fin_cases b <;>
      simp [covariance, integral_coins, errors, sgn, DescendantExample.model] <;> norm_num

/-- In the chain `Z → X → Y` (`0 → 1 → 2`, unit coefficients, uncorrelated unit errors) realized
by `errors`, the instrument `Z` for the effect of `X` on `Y` satisfies every hypothesis of
`iv_ratio_eq_linearIV_of_isDiag`: the IV model is exogenous and relevant, and its covariance
ratio is the path coefficient `1`. -/
theorem iv_identifies :
    (DescendantExample.model.toLinearIVModel errors 1 2 0 1).Exogeneity coins ∧
      (DescendantExample.model.toLinearIVModel errors 1 2 0 1).Relevance coins ∧
      cov[(DescendantExample.model.toLinearIVModel errors 1 2 0 1).Z,
          (DescendantExample.model.toLinearIVModel errors 1 2 0 1).Y; coins] /
        cov[(DescendantExample.model.toLinearIVModel errors 1 2 0 1).Z,
          (DescendantExample.model.toLinearIVModel errors 1 2 0 1).D; coins] = 1 := by
  refine iv_ratio_eq_linearIV_of_isDiag errorRealization Matrix.isDiag_one
    (fun p => by fin_cases p <;> simp [DescendantExample.model]) ?_ ?_
  · intro h
    rcases ReflTransGen.cases_head h with h | ⟨w, hw, -⟩
    · exact absurd h (by decide)
    · simp [DescendantExample.model, DescendantExample.G] at hw
  · rw [cov_apply, DescendantExample.T_eq]
    simp [Fin.sum_univ_three, DescendantExample.model, Matrix.one_apply]

end IVExample

end LinearSEM

end CausalInference
