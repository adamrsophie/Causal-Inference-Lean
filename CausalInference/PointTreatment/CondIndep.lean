module

public import CausalInference.MissingData.Mechanisms

/-!
# Conditional independence of a binary variable: three equivalent forms

For a binary variable `R : Ω → Bool`, a variable `U : Ω → β` with values in an arbitrary
measurable space and a conditioning variable `X : Ω → 𝒳`, under a finite measure, the
conditional independence `R ⫫ U | X` (Mathlib's `ProbabilityTheory.CondIndepFun` given the
σ-algebra generated by `X`) has two equivalent forms:

* the product rule for bounded test functions,
  `E[f(R) g(U) | X] = E[f(R) | X] E[g(U) | X]` for every `f : Bool → ℝ` and every bounded
  measurable `g`;
* the mean independence of the indicator, `E[1{R} | X, U] = E[1{R} | X]`.

This generalizes `MissingData.marMean_iff_mar`, which is the case `β = ℝ`, to an arbitrary value
space, for instance the pair `(Y(0), Y(1))` of potential outcomes. The file also proves that the
indicator form gives mean independence of every integrable function `Z` of `(X, U)` from `R`:
`E[Z | X, R] = E[Z | X]`.

## Main results

* `condExp_respInd_eq_of_condIndepFun`: conditional independence gives the indicator form.
* `condExp_mul_eq_of_condExp_respInd_eq`: the indicator form gives the product rule for bounded
  test functions.
* `condIndepFun_of_condExp_mul_eq`: the product rule gives conditional independence.
* `condIndepFun_iff_condExp_respInd_eq`, `condIndepFun_iff_condExp_mul_eq`: the equivalences
  (`StandardBorelSpace Ω`, which Mathlib's `CondIndepFun` needs).
* `condExp_eq_of_condExp_respInd_eq`: the indicator form gives `E[Z | X, R] = E[Z | X]` for every
  integrable `σ(X, U)` measurable `Z`.

## References

* A. P. Dawid, *Conditional independence in statistical theory*, Journal of the Royal Statistical
  Society B 41 (1979).
-/

@[expose] public section

namespace CausalInference

namespace PointTreatment

open MeasureTheory ProbabilityTheory MissingData

variable {Ω 𝒳 β : Type*} {mΩ : MeasurableSpace Ω} [MeasurableSpace 𝒳] [MeasurableSpace β]
  {μ : Measure Ω} {X : Ω → 𝒳} {U : Ω → β} {R : Ω → Bool}

omit [MeasurableSpace β] in
/-- The σ-algebra generated by `X` is contained in the one generated by a pair `(X, V)`. -/
theorem comap_le_comap_prodMk {γ : Type*} [MeasurableSpace γ] (X : Ω → 𝒳) (V : Ω → γ) :
    MeasurableSpace.comap X inferInstance ≤
      MeasurableSpace.comap (fun ω => (X ω, V ω)) inferInstance :=
  (measurable_fst.comp (comap_measurable (fun ω => (X ω, V ω)))).comap_le

omit [MeasurableSpace 𝒳] [MeasurableSpace β] in
theorem integrable_respInd [IsFiniteMeasure μ] (hR : Measurable R) : Integrable (respInd R) μ :=
  (integrable_const 1).indicator (hR (measurableSet_singleton true))

omit [MeasurableSpace 𝒳] [MeasurableSpace β] in
/-- A function of a binary variable is affine in its indicator, and so is its conditional
expectation: `E[f(R) | m] = f(0) + (f(1) - f(0)) E[1{R} | m]`. -/
theorem condExp_comp_bool [IsFiniteMeasure μ] {m : MeasurableSpace Ω} (hm : m ≤ mΩ)
    (hR : Measurable[mΩ] R) (f : Bool → ℝ) :
    μ[fun ω => f (R ω) | m] =ᵐ[μ]
      fun ω => f false + (f true - f false) * μ[respInd R | m] ω := by
  have hdec : (fun ω => f (R ω)) = (fun _ => f false) + (f true - f false) • respInd R := by
    funext ω
    cases h : R ω <;> simp [respInd_apply, h]
  have hri : Integrable (respInd R) μ := integrable_respInd hR
  have h1 : μ[(fun _ => f false) + (f true - f false) • respInd R | m] =ᵐ[μ]
      μ[fun _ => f false | m] + μ[(f true - f false) • respInd R | m] :=
    condExp_add (integrable_const (f false)) (hri.smul (f true - f false)) m
  have h2 : μ[(f true - f false) • respInd R | m] =ᵐ[μ]
      (f true - f false) • μ[respInd R | m] :=
    condExp_smul (f true - f false) (respInd R) m
  rw [hdec]
  filter_upwards [h1, h2] with ω h1 h2
  rw [h1, Pi.add_apply, condExp_const hm, h2]
  simp [smul_eq_mul]

/-- **Conditional independence gives the indicator form.** If `R ⫫ U | X`, then
`E[1{R} | X, U] = E[1{R} | X]` almost everywhere. -/
theorem condExp_respInd_eq_of_condIndepFun [StandardBorelSpace Ω] [IsFiniteMeasure μ]
    (hX : Measurable X) (hU : Measurable U) (hR : Measurable R)
    (h : CondIndepFun (MeasurableSpace.comap X inferInstance) hX.comap_le R U μ) :
    μ[respInd R | MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance] =ᵐ[μ]
      μ[respInd R | MeasurableSpace.comap X inferInstance] := by
  have hXU : Measurable fun ω => (X ω, U ω) := hX.prodMk hU
  have hri : Integrable (respInd R) μ := integrable_respInd hR
  have hπint : Integrable (μ[respInd R | MeasurableSpace.comap X inferInstance]) μ :=
    integrable_condExp
  have hπm : StronglyMeasurable[MeasurableSpace.comap X inferInstance]
      (μ[respInd R | MeasurableSpace.comap X inferInstance]) := stronglyMeasurable_condExp
  have hbd : ∀ᵐ ω ∂μ,
      ‖(μ[respInd R | MeasurableSpace.comap X inferInstance]) ω‖ ≤ (1 : ℝ) := by
    have h1 : ∀ᵐ ω ∂μ, |respInd R ω| ≤ (1 : ℝ) :=
      Filter.Eventually.of_forall fun ω => by
        rw [abs_of_nonneg (respInd_nonneg R ω)]; exact respInd_le_one R ω
    filter_upwards [ae_bdd_abs_condExp_of_ae_bdd_abs
      (m := MeasurableSpace.comap X inferInstance) h1] with ω hω
    rwa [Real.norm_eq_abs]
  rw [condIndepFun_iff_condExp_inter_preimage_eq_mul hR hU] at h
  have hrect : ∀ (A : Set 𝒳) (B : Set β), MeasurableSet A → MeasurableSet B →
      ∫ ω in X ⁻¹' A ∩ U ⁻¹' B,
          (μ[respInd R | MeasurableSpace.comap X inferInstance]) ω ∂μ =
        ∫ ω in X ⁻¹' A ∩ U ⁻¹' B, respInd R ω ∂μ := by
    intro A B hA hB
    have hXA : MeasurableSet[MeasurableSpace.comap X inferInstance] (X ⁻¹' A) := ⟨A, hA, rfl⟩
    have hUB : MeasurableSet (U ⁻¹' B) := hU hB
    have hgi : Integrable ((U ⁻¹' B).indicator fun _ => (1 : ℝ)) μ :=
      (integrable_const 1).indicator hUB
    have hfun : (μ[respInd R | MeasurableSpace.comap X inferInstance]) *
        (U ⁻¹' B).indicator (fun _ => (1 : ℝ)) =
        (U ⁻¹' B).indicator (μ[respInd R | MeasurableSpace.comap X inferInstance]) := by
      ext ω
      by_cases hω : ω ∈ U ⁻¹' B <;> simp [Set.indicator, hω]
    have hfun' : (R ⁻¹' {true} ∩ U ⁻¹' B).indicator (fun _ => (1 : ℝ)) =
        (U ⁻¹' B).indicator (respInd R) := by
      ext ω
      by_cases h1 : ω ∈ R ⁻¹' {true} <;> by_cases h2 : ω ∈ U ⁻¹' B <;>
        simp_all [Set.indicator, respInd]
    have hpull := condExp_stronglyMeasurable_mul_of_bound hX.comap_le hπm hgi 1 hbd
    have hci := h {true} B (measurableSet_singleton true) hB
    rw [← setIntegral_indicator hUB, ← setIntegral_indicator hUB, ← hfun, ← hfun',
      ← setIntegral_condExp hX.comap_le (hfun ▸ hπint.indicator hUB) hXA,
      ← setIntegral_condExp hX.comap_le ((integrable_const 1).indicator
        ((hR (measurableSet_singleton true)).inter hUB)) hXA]
    refine setIntegral_congr_ae (hX hA) ?_
    filter_upwards [hpull, hci] with ω h1 h2 _
    rw [h1, h2]
    rfl
  have key : ∀ s
      (hs : MeasurableSet[MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance] s),
      ∫ ω in s, (μ[respInd R | MeasurableSpace.comap X inferInstance]) ω ∂μ =
        ∫ ω in s, respInd R ω ∂μ := by
    have h_eq : MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance =
        MeasurableSpace.generateFrom (Set.preimage (fun ω => (X ω, U ω)) ''
          Set.image2 (· ×ˢ ·) {A : Set 𝒳 | MeasurableSet A}
            {B : Set β | MeasurableSet B}) := by
      rw [← generateFrom_prod, MeasurableSpace.comap_generateFrom]
    intro s hs
    induction s, hs using MeasurableSpace.induction_on_inter h_eq
      (isPiSystem_prod.comap (fun ω => (X ω, U ω))) with
    | empty => simp
    | basic t ht =>
      obtain ⟨_, ⟨A, hA, B, hB, rfl⟩, rfl⟩ := ht
      exact hrect A B hA hB
    | compl t htm ht =>
      rw [setIntegral_compl (hXU.comap_le _ htm) hπint, setIntegral_compl (hXU.comap_le _ htm) hri,
        ht, integral_condExp hX.comap_le]
    | iUnion f hf hfm heq =>
      rw [integral_iUnion (fun n => hXU.comap_le _ (hfm n)) hf hπint.integrableOn,
        integral_iUnion (fun n => hXU.comap_le _ (hfm n)) hf hri.integrableOn]
      exact tsum_congr heq
  exact (ae_eq_condExp_of_forall_setIntegral_eq hXU.comap_le hri
    (fun s _ _ => hπint.integrableOn) (fun s hs _ => key s hs)
    (hπm.mono (comap_le_comap_prodMk X U)).aestronglyMeasurable).symm

/-- **The indicator form gives the product rule for bounded test functions.** If
`E[1{R} | X, U] = E[1{R} | X]`, then for every `f : Bool → ℝ` and every bounded measurable
`g : β → ℝ`, `E[f(R) g(U) | X] = E[f(R) | X] E[g(U) | X]` almost everywhere. The proof
conditions on `(X, U)` first, where `g(U)` pulls out and `E[f(R) | X, U] = E[f(R) | X]` because
`f(R)` is affine in the indicator. -/
theorem condExp_mul_eq_of_condExp_respInd_eq [IsFiniteMeasure μ] (hX : Measurable X)
    (hU : Measurable U) (hR : Measurable R)
    (H : μ[respInd R | MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance] =ᵐ[μ]
      μ[respInd R | MeasurableSpace.comap X inferInstance])
    (f : Bool → ℝ) {g : β → ℝ} (hg : Measurable g) {C : ℝ} (hC : ∀ b, |g b| ≤ C) :
    μ[fun ω => f (R ω) * g (U ω) | MeasurableSpace.comap X inferInstance] =ᵐ[μ]
      μ[fun ω => f (R ω) | MeasurableSpace.comap X inferInstance] *
        μ[fun ω => g (U ω) | MeasurableSpace.comap X inferInstance] := by
  have hmX : (MeasurableSpace.comap X inferInstance) ≤ mΩ := hX.comap_le
  have hmXU : (MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance) ≤ mΩ :=
    (hX.prodMk hU).comap_le
  have hle : (MeasurableSpace.comap X inferInstance) ≤
      (MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance) :=
    comap_le_comap_prodMk X U
  have hfRm : Measurable[mΩ] fun ω => f (R ω) := (Measurable.of_discrete (f := f)).comp hR
  have hfRb : ∀ᵐ ω ∂μ, ‖f (R ω)‖ ≤ |f true| + |f false| :=
    Filter.Eventually.of_forall fun ω => by
      rw [Real.norm_eq_abs]
      cases R ω
      · exact le_add_of_nonneg_left (abs_nonneg _)
      · exact le_add_of_nonneg_right (abs_nonneg _)
  have hfR : Integrable (fun ω => f (R ω)) μ :=
    (integrable_const (|f true| + |f false|)).mono' hfRm.aestronglyMeasurable hfRb
  have hgUm : Measurable[mΩ] fun ω => g (U ω) := hg.comp hU
  have hgUb : ∀ᵐ ω ∂μ, ‖g (U ω)‖ ≤ C :=
    Filter.Eventually.of_forall fun ω => by rw [Real.norm_eq_abs]; exact hC (U ω)
  have hgU : Integrable (fun ω => g (U ω)) μ :=
    (integrable_const C).mono' hgUm.aestronglyMeasurable hgUb
  have hfg : Integrable (fun ω => f (R ω) * g (U ω)) μ :=
    hgU.bdd_mul hfRm.aestronglyMeasurable hfRb
  have hgU_XU : StronglyMeasurable[(MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance)]
      (fun ω => g (U ω)) :=
    (hg.comp (measurable_snd.comp (comap_measurable (fun ω => (X ω, U ω))))).stronglyMeasurable
  have hH' : μ[fun ω => f (R ω) |
        (MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance)] =ᵐ[μ]
      μ[fun ω => f (R ω) | (MeasurableSpace.comap X inferInstance)] := by
    filter_upwards [condExp_comp_bool hmXU hR f, condExp_comp_bool hmX hR f, H]
      with ω h1 h2 h3
    rw [h1, h2, h3]
  have h2 : μ[fun ω => f (R ω) * g (U ω) |
        (MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance)] =ᵐ[μ]
      μ[fun ω => f (R ω) | (MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance)] *
        fun ω => g (U ω) :=
    condExp_mul_of_stronglyMeasurable_right hgU_XU hfg hfR
  have hfc : Integrable
      (fun ω => μ[fun ω => f (R ω) | (MeasurableSpace.comap X inferInstance)] ω *
        g (U ω)) μ :=
    (integrable_condExp.bdd_mul hgUm.aestronglyMeasurable hgUb).congr
      (Filter.Eventually.of_forall fun ω => mul_comm _ _)
  have h4 : μ[μ[fun ω => f (R ω) | (MeasurableSpace.comap X inferInstance)] *
        (fun ω => g (U ω)) |
        (MeasurableSpace.comap X inferInstance)] =ᵐ[μ]
      μ[fun ω => f (R ω) | (MeasurableSpace.comap X inferInstance)] *
        μ[fun ω => g (U ω) | (MeasurableSpace.comap X inferInstance)] :=
    condExp_mul_of_stronglyMeasurable_left stronglyMeasurable_condExp hfc hgU
  have h1 := condExp_condExp_of_le (μ := μ) (f := fun ω => f (R ω) * g (U ω)) hle hmXU
  have h3 : μ[fun ω => f (R ω) * g (U ω) |
        (MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance)] =ᵐ[μ]
      μ[fun ω => f (R ω) | (MeasurableSpace.comap X inferInstance)] * fun ω => g (U ω) := by
    filter_upwards [h2, hH'] with ω ha hb
    rw [ha, Pi.mul_apply, Pi.mul_apply, hb]
  exact h1.symm.trans ((condExp_congr_ae h3).trans h4)

/-- **The product rule gives conditional independence.** If
`E[f(R) g(U) | X] = E[f(R) | X] E[g(U) | X]` for all indicator functions `f`, `g` of measurable
sets, then `R ⫫ U | X`. -/
theorem condIndepFun_of_condExp_mul_eq [StandardBorelSpace Ω] [IsFiniteMeasure μ]
    (hX : Measurable X) (hU : Measurable U) (hR : Measurable R)
    (H : ∀ (s : Set Bool) (t : Set β), MeasurableSet t →
      μ[fun ω => s.indicator 1 (R ω) * t.indicator 1 (U ω) |
          MeasurableSpace.comap X inferInstance] =ᵐ[μ]
        μ[fun ω => s.indicator 1 (R ω) | MeasurableSpace.comap X inferInstance] *
          μ[fun ω => t.indicator (1 : β → ℝ) (U ω) |
            MeasurableSpace.comap X inferInstance]) :
    CondIndepFun (MeasurableSpace.comap X inferInstance) hX.comap_le R U μ := by
  rw [condIndepFun_iff_condExp_inter_preimage_eq_mul hR hU]
  intro s t _ ht
  have hinter : (R ⁻¹' s ∩ U ⁻¹' t).indicator (fun _ => (1 : ℝ)) =
      fun ω => s.indicator 1 (R ω) * t.indicator (1 : β → ℝ) (U ω) := by
    funext ω
    by_cases h : R ω ∈ s <;> by_cases h' : U ω ∈ t <;> simp [Set.indicator, h, h']
  have hR' : (R ⁻¹' s).indicator (fun _ => (1 : ℝ)) = fun ω => s.indicator 1 (R ω) := by
    funext ω; by_cases h : R ω ∈ s <;> simp [Set.indicator, h]
  have hU' : (U ⁻¹' t).indicator (fun _ => (1 : ℝ)) =
      fun ω => t.indicator (1 : β → ℝ) (U ω) := by
    funext ω; by_cases h : U ω ∈ t <;> simp [Set.indicator, h]
  rw [hinter, hR', hU']
  exact H s t ht

/-- **Conditional independence of a binary variable and its indicator form.** For measurable
variables on a finite measure (`Ω` standard Borel), `R ⫫ U | X` if and only if
`E[1{R} | X, U] = E[1{R} | X]` almost everywhere. -/
theorem condIndepFun_iff_condExp_respInd_eq [StandardBorelSpace Ω] [IsFiniteMeasure μ]
    (hX : Measurable X) (hU : Measurable U) (hR : Measurable R) :
    CondIndepFun (MeasurableSpace.comap X inferInstance) hX.comap_le R U μ ↔
      μ[respInd R | MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance] =ᵐ[μ]
        μ[respInd R | MeasurableSpace.comap X inferInstance] := by
  refine ⟨condExp_respInd_eq_of_condIndepFun hX hU hR, fun H => ?_⟩
  refine condIndepFun_of_condExp_mul_eq hX hU hR fun s t ht => ?_
  exact condExp_mul_eq_of_condExp_respInd_eq hX hU hR H _ (measurable_one.indicator ht)
    (C := 1) fun b => by by_cases h : b ∈ t <;> simp [Set.indicator, h]

/-- **Conditional independence of a binary variable and the product rule.** For measurable
variables on a finite measure (`Ω` standard Borel), `R ⫫ U | X` if and only if
`E[f(R) g(U) | X] = E[f(R) | X] E[g(U) | X]` almost everywhere for every `f : Bool → ℝ` (every
such function is bounded and measurable) and every bounded measurable `g : β → ℝ`. -/
theorem condIndepFun_iff_condExp_mul_eq [StandardBorelSpace Ω] [IsFiniteMeasure μ]
    (hX : Measurable X) (hU : Measurable U) (hR : Measurable R) :
    CondIndepFun (MeasurableSpace.comap X inferInstance) hX.comap_le R U μ ↔
      ∀ (f : Bool → ℝ) (g : β → ℝ), Measurable g → (∃ C, ∀ b, |g b| ≤ C) →
        μ[fun ω => f (R ω) * g (U ω) | MeasurableSpace.comap X inferInstance] =ᵐ[μ]
          μ[fun ω => f (R ω) | MeasurableSpace.comap X inferInstance] *
            μ[fun ω => g (U ω) | MeasurableSpace.comap X inferInstance] := by
  refine ⟨fun h f g hg ⟨C, hC⟩ =>
    condExp_mul_eq_of_condExp_respInd_eq hX hU hR
      (condExp_respInd_eq_of_condIndepFun hX hU hR h) f hg hC, fun H => ?_⟩
  refine condIndepFun_of_condExp_mul_eq hX hU hR fun s t ht => ?_
  exact H _ _ (measurable_one.indicator ht)
    ⟨1, fun b => by by_cases h : b ∈ t <;> simp [Set.indicator, h]⟩

/-- **The indicator form gives mean independence.** If `E[1{R} | X, U] = E[1{R} | X]`, then
`E[Z | X, R] = E[Z | X]` almost everywhere for every integrable `Z` that is measurable for the
σ-algebra of `(X, U)`. The defining set integrals of `E[Z | X]` are checked on the events of
`σ(X, R)`, each of which splits through `R` into two covariate events; on a covariate event,
`E[1{R} Z] = E[1{R} E[Z | X]]` by conditioning on `(X, U)` first. -/
theorem condExp_eq_of_condExp_respInd_eq [IsFiniteMeasure μ] (hX : Measurable X)
    (hU : Measurable U) (hR : Measurable R) {Z : Ω → ℝ}
    (hZm : Measurable[MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance] Z)
    (hZ : Integrable Z μ)
    (H : μ[respInd R | MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance] =ᵐ[μ]
      μ[respInd R | MeasurableSpace.comap X inferInstance]) :
    μ[Z | MeasurableSpace.comap (fun ω => (X ω, R ω)) inferInstance] =ᵐ[μ]
      μ[Z | MeasurableSpace.comap X inferInstance] := by
  have hXΩ : (MeasurableSpace.comap X inferInstance) ≤ mΩ := hX.comap_le
  have hXUΩ : (MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance) ≤ mΩ :=
    (hX.prodMk hU).comap_le
  have hXRΩ : MeasurableSpace.comap (fun ω => (X ω, R ω)) inferInstance ≤ mΩ :=
    (hX.prodMk hR).comap_le
  have hXXU : (MeasurableSpace.comap X inferInstance) ≤
      (MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance) :=
    comap_le_comap_prodMk X U
  set bR : Ω → ℝ := respInd R
  have hbRm : Measurable[mΩ] bR := measurable_respInd hR
  have hbR : Integrable bR μ := integrable_respInd hR
  have hbd : ∀ᵐ ω ∂μ, ‖bR ω‖ ≤ 1 :=
    Filter.Eventually.of_forall fun ω => by
      rw [Real.norm_eq_abs, abs_of_nonneg (respInd_nonneg R ω)]; exact respInd_le_one R ω
  set c := μ[bR | (MeasurableSpace.comap X inferInstance)]
  set g := μ[Z | (MeasurableSpace.comap X inferInstance)]
  have key : ∀ A : Set Ω, MeasurableSet[(MeasurableSpace.comap X inferInstance)] A →
      ∫ ω in A, bR ω * Z ω ∂μ = ∫ ω in A, bR ω * g ω ∂μ := by
    intro A hA
    have hbY : Integrable (fun ω => bR ω * Z ω) μ := hZ.bdd_mul hbRm.aestronglyMeasurable hbd
    have hbg : Integrable (fun ω => bR ω * g ω) μ :=
      (integrable_condExp (m := (MeasurableSpace.comap X inferInstance)) (f := Z)
        (μ := μ)).bdd_mul
        hbRm.aestronglyMeasurable hbd
    have p1 : μ[bR * Z | (MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance)] =ᵐ[μ]
        c * Z :=
      (condExp_mul_of_aestronglyMeasurable_right hZm.stronglyMeasurable.aestronglyMeasurable
        hbY hbR).trans (H.mul (Filter.EventuallyEq.refl _ _))
    have hcY : Integrable (c * Z) μ := integrable_condExp.congr p1
    have p2 : μ[c * Z | (MeasurableSpace.comap X inferInstance)] =ᵐ[μ] c * g :=
      condExp_mul_of_stronglyMeasurable_left stronglyMeasurable_condExp hcY hZ
    have p3 : μ[bR * g | (MeasurableSpace.comap X inferInstance)] =ᵐ[μ] c * g :=
      condExp_mul_of_stronglyMeasurable_right stronglyMeasurable_condExp hbg hbR
    calc ∫ ω in A, bR ω * Z ω ∂μ
        = ∫ ω in A, μ[bR * Z |
            (MeasurableSpace.comap (fun ω => (X ω, U ω)) inferInstance)] ω ∂μ :=
          (setIntegral_condExp hXUΩ hbY (hXXU A hA)).symm
      _ = ∫ ω in A, (c * Z) ω ∂μ := integral_congr_ae (ae_restrict_of_ae p1)
      _ = ∫ ω in A, μ[c * Z | (MeasurableSpace.comap X inferInstance)] ω ∂μ :=
          (setIntegral_condExp hXΩ hcY hA).symm
      _ = ∫ ω in A, μ[bR * g | (MeasurableSpace.comap X inferInstance)] ω ∂μ :=
          integral_congr_ae (ae_restrict_of_ae (p2.trans p3.symm))
      _ = ∫ ω in A, bR ω * g ω ∂μ := setIntegral_condExp hXΩ hbg hA
  refine (ae_eq_condExp_of_forall_setIntegral_eq hXRΩ hZ
    (fun s _ _ => integrable_condExp.integrableOn) (fun s hs _ => ?_)
    ((stronglyMeasurable_condExp.mono (comap_le_comap_prodMk X R)).aestronglyMeasurable)).symm
  obtain ⟨S, hS, rfl⟩ := hs
  set A : Set Ω := X ⁻¹' ((fun x => (x, true)) ⁻¹' S)
  set B : Set Ω := X ⁻¹' ((fun x => (x, false)) ⁻¹' S)
  have hA : MeasurableSet[(MeasurableSpace.comap X inferInstance)] A :=
    ⟨_, measurable_prodMk_right hS, rfl⟩
  have hB : MeasurableSet[(MeasurableSpace.comap X inferInstance)] B :=
    ⟨_, measurable_prodMk_right hS, rfl⟩
  have split : ∀ F : Ω → ℝ, Integrable F μ →
      ∫ ω in (fun ω => (X ω, R ω)) ⁻¹' S, F ω ∂μ =
        ∫ ω in A, bR ω * F ω ∂μ +
          (∫ ω in B, F ω ∂μ - ∫ ω in B, bR ω * F ω ∂μ) := by
    intro F hF
    have hBI : ∫ ω in B, F ω ∂μ - ∫ ω in B, bR ω * F ω ∂μ =
        ∫ ω in B, (1 - bR ω) * F ω ∂μ := by
      rw [← integral_sub hF.integrableOn
        ((hF.bdd_mul hbRm.aestronglyMeasurable hbd).integrableOn)]
      congr 1; funext ω; ring
    rw [hBI, ← integral_indicator (hXΩ _ hA), ← integral_indicator (hXΩ _ hB),
      ← integral_indicator ((hX.prodMk hR) hS), ← integral_add]
    · congr 1; funext ω
      simp only [Set.indicator, A, B, bR, respInd_apply]
      rcases hRω : R ω with _ | _ <;> split_ifs <;> simp_all
    · exact (hF.bdd_mul hbRm.aestronglyMeasurable hbd).indicator (hXΩ _ hA)
    · exact ((hF.bdd_mul (hbRm.const_sub 1).aestronglyMeasurable
        (Filter.Eventually.of_forall fun ω => (by
          rw [Real.norm_eq_abs, abs_of_nonneg (sub_nonneg.2 (respInd_le_one R ω))]
          linarith [respInd_nonneg R ω] : ‖1 - bR ω‖ ≤ 1)))).indicator (hXΩ _ hB)
  rw [split _ integrable_condExp, split _ hZ, key A hA, key B hB,
    setIntegral_condExp hXΩ hZ hB]

end PointTreatment

end CausalInference
