module

public import CausalInference.PointTreatment.Assumptions
public import CausalInference.MissingData.Weighting

/-!
# Point treatment: identification of the arm means and of the average effect

Under consistency (built into `obsOutcome`), ignorability given `W`, positivity and
integrability, the mean `E[Y(a)]` of each arm and the average treatment effect are functionals
of the law of the observed data `(W, A, Y)`. Two formulas are proved.

* **The g-formula (standardization).** The observed regression of the outcome on `(W, A)`,
  evaluated at the arm `a`, is a version of the potential outcome regression `E[Y(a) | W]`;
  averaging it over `W` gives `E[Y(a)]`.
* **The weighting identity.** `E[1{A = a} Y / P(A = a | W)] = E[Y(a)]`.

Each formula is first proved under the mean form of ignorability, `E[Y(a) | W, A] =
E[Y(a) | W]`, and then under the indicator form `E[1{A} | W, Y(0), Y(1)] = E[1{A} | W]` and the
full form `A ⫫ (Y(0), Y(1)) | W`. Under the mean form the weighting identity assumes that the
weighted outcome is integrable; under the full form this integrability is a consequence, so only
almost sure positivity `0 < e(W) < 1` is needed.

## Main results

* `IsOutcomeRegression.ae_eq_condExp`: the observed regression at the arm `a` is a version of
  `E[Y(a) | W]` (mean ignorability and positivity of the arm).
* `armMean_eq_integral_regression`, `ate_eq_integral_regression`: the g-formula for an arm mean
  and for the average effect, with full form corollaries `Ignorable.armMean_eq_integral_regression`
  and `Ignorable.ate_eq_integral_regression`.
* `armMean_eq_ipw_of_meanIgnorable`, `ate_eq_ipw_of_meanIgnorable`: the weighting identity
  under mean ignorability.
* `IndicatorIgnorable.integrable_ipw`, `IndicatorIgnorable.armMean_eq_ipw`,
  `Ignorable.armMean_eq_ipw`, `Ignorable.ate_eq_ipw`: the weighting identity under the indicator
  and full forms, with integrability of the weighted outcome as a conclusion.

## References

* J. M. Robins, *A new approach to causal inference in mortality studies with a sustained
  exposure period*, Mathematical Modelling 7 (1986) (the g-formula).
* P. R. Rosenbaum and D. B. Rubin, *The central role of the propensity score in observational
  studies for causal effects*, Biometrika 70 (1983).
* D. G. Horvitz and D. J. Thompson, *A generalization of sampling without replacement from a
  finite universe*, Journal of the American Statistical Association 47 (1952).
-/

@[expose] public section

namespace CausalInference

namespace PointTreatment

open MeasureTheory ProbabilityTheory MissingData

variable {Ω 𝒲 : Type*} {mΩ : MeasurableSpace Ω} [MeasurableSpace 𝒲] {μ : Measure Ω}
  {A : Ω → Bool} {W : Ω → 𝒲} {Y : Bool → Ω → ℝ} {e : 𝒲 → ℝ} {m : Bool → 𝒲 → ℝ}

omit mΩ [MeasurableSpace 𝒲] in
/-- On the arm `{A = a}` the observed outcome is the potential outcome `Y(a)`. -/
theorem respInd_arm_mul_obsOutcome (A : Ω → Bool) (Y : Bool → Ω → ℝ) (a : Bool) (ω : Ω) :
    respInd (arm A a) ω * obsOutcome A Y ω = respInd (arm A a) ω * Y a ω := by
  rw [respInd_arm_apply]
  by_cases h : A ω = a
  · simp [h, obsOutcome]
  · simp [h]

omit mΩ [MeasurableSpace 𝒲] in
/-- On the arm `{A = a}` a function of the treatment received is its value at `a`. -/
theorem respInd_arm_mul_apply {β : Type*} (A : Ω → Bool) (f : Bool → β → ℝ) (a : Bool) (ω : Ω)
    (x : β) : respInd (arm A a) ω * f (A ω) x = respInd (arm A a) ω * f a x := by
  rw [respInd_arm_apply]
  by_cases h : A ω = a
  · simp [h]
  · simp [h]

omit mΩ in
/-- The indicator of an arm is measurable for the σ-algebra generated by `(W, A)`. -/
theorem measurable_respInd_arm_comap (W : Ω → 𝒲) (A : Ω → Bool) (a : Bool) :
    Measurable[MeasurableSpace.comap (fun ω => (W ω, A ω)) inferInstance]
      (respInd (arm A a)) := by
  have h : respInd (arm A a) = (fun b : Bool => if b = a then (1 : ℝ) else 0) ∘
      (Prod.snd ∘ fun ω => (W ω, A ω)) := funext fun ω => respInd_arm_apply A a ω
  rw [h]
  exact Measurable.of_discrete.comp (measurable_snd.comp (comap_measurable _))

/-! ### The g-formula -/

/-- **The observed regression is the potential outcome regression on each arm.** Let `m(A, W)` be
a version of `E[Y | W, A]` for the observed outcome `Y = Y(A)`, let `e(W)` be a version of the
propensity score, and assume mean ignorability for the arm `a` and positivity of that arm,
`P(A = a | W) > 0` almost surely. Then `m(a, W)` is a version of `E[Y(a) | W]`. -/
theorem IsOutcomeRegression.ae_eq_condExp [IsFiniteMeasure μ] (hW : Measurable W)
    (hA : Measurable A) (hYi : ∀ a, Integrable (Y a) μ)
    (hreg : IsOutcomeRegression μ A W (obsOutcome A Y) m) (hps : IsPropensityScore μ A W e)
    (a : Bool) (hmi : MeanIgnorable μ A W Y a) (hpos : ∀ᵐ ω ∂μ, 0 < armProb e a (W ω)) :
    (fun ω => m a (W ω)) =ᵐ[μ] μ[Y a | MeasurableSpace.comap W inferInstance] := by
  have hWA : MeasurableSpace.comap (fun ω => (W ω, A ω)) inferInstance ≤ mΩ :=
    (hW.prodMk hA).comap_le
  have hbm : Measurable (respInd (arm A a)) := measurable_respInd (measurable_arm hA a)
  have hb : StronglyMeasurable[MeasurableSpace.comap (fun ω => (W ω, A ω)) inferInstance]
      (respInd (arm A a)) := (measurable_respInd_arm_comap W A a).stronglyMeasurable
  have hbd : ∀ᵐ ω ∂μ, ‖respInd (arm A a) ω‖ ≤ 1 := Filter.Eventually.of_forall fun ω => by
    rw [Real.norm_eq_abs, abs_of_nonneg (respInd_nonneg _ ω)]; exact respInd_le_one _ ω
  have hYo : Integrable (obsOutcome A Y) μ := integrable_obsOutcome hA hYi
  have c1 := condExp_mul_of_stronglyMeasurable_left hb
    (hYo.bdd_mul hbm.aestronglyMeasurable hbd) hYo
  have c2 := condExp_mul_of_stronglyMeasurable_left hb
    ((hYi a).bdd_mul hbm.aestronglyMeasurable hbd) (hYi a)
  have heq : respInd (arm A a) * obsOutcome A Y = respInd (arm A a) * Y a :=
    funext fun ω => respInd_arm_mul_obsOutcome A Y a ω
  -- on the arm, `m(a, W)` agrees with `E[Y(a) | W]`
  have hD0 : (fun ω => respInd (arm A a) ω * (m a (W ω) -
      μ[Y a | MeasurableSpace.comap W inferInstance] ω)) =ᵐ[μ] 0 := by
    filter_upwards [c1, c2, hreg.2, hmi] with ω h1 h2 h3 h4
    have h5 : respInd (arm A a) ω * m a (W ω) =
        respInd (arm A a) ω * μ[Y a | MeasurableSpace.comap W inferInstance] ω := by
      rw [← respInd_arm_mul_apply A m a ω (W ω), ← h3, ← Pi.mul_apply, ← h1, heq, h2,
        Pi.mul_apply, h4]
    rw [Pi.zero_apply, mul_sub, h5, sub_self]
  -- positivity spreads the equality to all units
  have hDm : StronglyMeasurable[MeasurableSpace.comap W inferInstance]
      (fun ω => m a (W ω) - μ[Y a | MeasurableSpace.comap W inferInstance] ω) :=
    (((hreg.1 a).comp (comap_measurable W)).sub
      stronglyMeasurable_condExp.measurable).stronglyMeasurable
  have hint : Integrable (fun ω => respInd (arm A a) ω * (m a (W ω) -
      μ[Y a | MeasurableSpace.comap W inferInstance] ω)) μ :=
    (integrable_zero Ω ℝ μ).congr hD0.symm
  have c3 := condExp_mul_of_stronglyMeasurable_right hDm hint
    (integrable_respInd (measurable_arm hA a))
  have c4 := condExp_congr_ae (m := MeasurableSpace.comap W inferInstance) hD0
  rw [condExp_zero] at c4
  filter_upwards [c3, c4, hps.condExp_arm hW hA a, hpos] with ω h3 h4 h5 h6
  have h7 : armProb e a (W ω) *
      (m a (W ω) - μ[Y a | MeasurableSpace.comap W inferInstance] ω) = 0 := by
    rw [← h5]
    exact (h3.symm.trans h4 :)
  exact sub_eq_zero.1 ((mul_eq_zero.1 h7).resolve_left h6.ne')

/-- **The g-formula for an arm mean** under mean ignorability: `E[Y(a)] = E[m(a, W)]`, where
`m(A, W)` is a version of the observed regression `E[Y | W, A]`. -/
theorem armMean_eq_integral_regression [IsFiniteMeasure μ] (hW : Measurable W)
    (hA : Measurable A) (hYi : ∀ a, Integrable (Y a) μ)
    (hreg : IsOutcomeRegression μ A W (obsOutcome A Y) m) (hps : IsPropensityScore μ A W e)
    (a : Bool) (hmi : MeanIgnorable μ A W Y a) (hpos : ∀ᵐ ω ∂μ, 0 < armProb e a (W ω)) :
    armMean μ Y a = ∫ ω, m a (W ω) ∂μ := by
  rw [integral_congr_ae (hreg.ae_eq_condExp hW hA hYi hps a hmi hpos),
    integral_condExp hW.comap_le, armMean]

/-- The regression at each arm is integrable under the hypotheses of the g-formula. -/
theorem integrable_regression [IsFiniteMeasure μ] (hW : Measurable W) (hA : Measurable A)
    (hYi : ∀ a, Integrable (Y a) μ) (hreg : IsOutcomeRegression μ A W (obsOutcome A Y) m)
    (hps : IsPropensityScore μ A W e) (a : Bool) (hmi : MeanIgnorable μ A W Y a)
    (hpos : ∀ᵐ ω ∂μ, 0 < armProb e a (W ω)) : Integrable (fun ω => m a (W ω)) μ :=
  integrable_condExp.congr (hreg.ae_eq_condExp hW hA hYi hps a hmi hpos).symm

/-- **The g-formula for the average effect** under mean ignorability of both arms and positivity
`0 < e(W) < 1` almost surely: `E[Y(1) - Y(0)] = E[m(1, W) - m(0, W)]`. -/
theorem ate_eq_integral_regression [IsFiniteMeasure μ] (hW : Measurable W) (hA : Measurable A)
    (hYi : ∀ a, Integrable (Y a) μ) (hreg : IsOutcomeRegression μ A W (obsOutcome A Y) m)
    (hps : IsPropensityScore μ A W e) (hmi : ∀ a, MeanIgnorable μ A W Y a)
    (hov : OverlapAE e (μ.map W)) :
    ate μ Y = ∫ ω, (m true (W ω) - m false (W ω)) ∂μ := by
  have hpos := armProb_pos_of_ae (hov.ae_comp hW.aemeasurable)
  rw [ate_eq_armMean_sub (hYi true) (hYi false),
    armMean_eq_integral_regression hW hA hYi hreg hps true (hmi true) (hpos true),
    armMean_eq_integral_regression hW hA hYi hreg hps false (hmi false) (hpos false),
    integral_sub (integrable_regression hW hA hYi hreg hps true (hmi true) (hpos true))
      (integrable_regression hW hA hYi hreg hps false (hmi false) (hpos false))]

/-- The g-formula for an arm mean under the indicator form of ignorability. -/
theorem IndicatorIgnorable.armMean_eq_integral_regression [IsFiniteMeasure μ]
    (hW : Measurable W) (hA : Measurable A) (hY : ∀ a, Measurable (Y a))
    (hYi : ∀ a, Integrable (Y a) μ) (hign : IndicatorIgnorable μ A W Y)
    (hreg : IsOutcomeRegression μ A W (obsOutcome A Y) m) (hps : IsPropensityScore μ A W e)
    (a : Bool) (hpos : ∀ᵐ ω ∂μ, 0 < armProb e a (W ω)) :
    armMean μ Y a = ∫ ω, m a (W ω) ∂μ :=
  PointTreatment.armMean_eq_integral_regression hW hA hYi hreg hps a
    (hign.meanIgnorable hW hA hY a (hYi a)) hpos

/-- **The g-formula for an arm mean under ignorability** `A ⫫ (Y(0), Y(1)) | W`. -/
theorem Ignorable.armMean_eq_integral_regression [StandardBorelSpace Ω] [IsFiniteMeasure μ]
    (hW : Measurable W) (hA : Measurable A) (hY : ∀ a, Measurable (Y a))
    (hYi : ∀ a, Integrable (Y a) μ) (hign : Ignorable μ A hW Y)
    (hreg : IsOutcomeRegression μ A W (obsOutcome A Y) m) (hps : IsPropensityScore μ A W e)
    (a : Bool) (hpos : ∀ᵐ ω ∂μ, 0 < armProb e a (W ω)) :
    armMean μ Y a = ∫ ω, m a (W ω) ∂μ :=
  PointTreatment.armMean_eq_integral_regression hW hA hYi hreg hps a
    (hign.meanIgnorable hW hA hY a (hYi a)) hpos

/-- **The g-formula for the average effect under ignorability** and positivity. -/
theorem Ignorable.ate_eq_integral_regression [StandardBorelSpace Ω] [IsFiniteMeasure μ]
    (hW : Measurable W) (hA : Measurable A) (hY : ∀ a, Measurable (Y a))
    (hYi : ∀ a, Integrable (Y a) μ) (hign : Ignorable μ A hW Y)
    (hreg : IsOutcomeRegression μ A W (obsOutcome A Y) m) (hps : IsPropensityScore μ A W e)
    (hov : OverlapAE e (μ.map W)) :
    ate μ Y = ∫ ω, (m true (W ω) - m false (W ω)) ∂μ :=
  PointTreatment.ate_eq_integral_regression hW hA hYi hreg hps
    (fun a => hign.meanIgnorable hW hA hY a (hYi a)) hov

/-! ### The weighting identity -/

/-- **The weighting identity under mean ignorability.** If `e(W)` is a version of the propensity
score, the arm `a` is mean ignorable and positive, `Y(a)` is integrable and the weighted outcome
`1{A = a} Y / P(A = a | W)` is integrable, then `E[1{A = a} Y / P(A = a | W)] = E[Y(a)]`. The
proof conditions first on `(W, A)`, where mean ignorability replaces `Y(a)` by `E[Y(a) | W]`,
and then on `W`, where `1{A = a}` is replaced by its conditional mean. -/
theorem armMean_eq_ipw_of_meanIgnorable [IsFiniteMeasure μ] (hW : Measurable W)
    (hA : Measurable A) (hps : IsPropensityScore μ A W e) (a : Bool)
    (hmi : MeanIgnorable μ A W Y a) (hpos : ∀ᵐ ω ∂μ, 0 < armProb e a (W ω))
    (hYi : Integrable (Y a) μ)
    (hint : Integrable (fun ω => respInd (arm A a) ω * obsOutcome A Y ω / armProb e a (W ω)) μ) :
    armMean μ Y a = ∫ ω, respInd (arm A a) ω * obsOutcome A Y ω / armProb e a (W ω) ∂μ := by
  have hWA : MeasurableSpace.comap (fun ω => (W ω, A ω)) inferInstance ≤ mΩ :=
    (hW.prodMk hA).comap_le
  have hp : Measurable (armProb e a) := measurable_armProb hps.1 a
  have hobs : (fun ω => respInd (arm A a) ω * obsOutcome A Y ω / armProb e a (W ω)) =
      fun ω => Y a ω * (respInd (arm A a) ω / armProb e a (W ω)) := by
    funext ω; rw [respInd_arm_mul_obsOutcome]; ring
  have hg1 : StronglyMeasurable[MeasurableSpace.comap (fun ω => (W ω, A ω)) inferInstance]
      (fun ω => respInd (arm A a) ω / armProb e a (W ω)) :=
    ((measurable_respInd_arm_comap W A a).div
      (hp.comp (measurable_fst.comp (comap_measurable _)))).stronglyMeasurable
  rw [hobs] at hint ⊢
  obtain ⟨hint2, e1⟩ := integral_mul_eq_of_condExp_eq hWA hYi hg1 hint hmi
  have hg2 : StronglyMeasurable[MeasurableSpace.comap W inferInstance]
      (fun ω => μ[Y a | MeasurableSpace.comap W inferInstance] ω / armProb e a (W ω)) :=
    (stronglyMeasurable_condExp.measurable.div (hp.comp (comap_measurable W))).stronglyMeasurable
  have hrw : (fun ω => μ[Y a | MeasurableSpace.comap W inferInstance] ω *
      (respInd (arm A a) ω / armProb e a (W ω))) = fun ω => respInd (arm A a) ω *
        (μ[Y a | MeasurableSpace.comap W inferInstance] ω / armProb e a (W ω)) := by
    funext ω; ring
  rw [hrw] at hint2
  have e2 := (integral_mul_eq_of_condExp_eq hW.comap_le
    (integrable_respInd (measurable_arm hA a)) hg2 hint2 (hps.condExp_arm hW hA a)).2
  rw [e1, hrw, e2, armMean, ← integral_condExp hW.comap_le]
  refine integral_congr_ae ?_
  filter_upwards [hpos] with ω hω
  field_simp

/-- **The weighting identity for the average effect under mean ignorability** of both arms and
positivity `0 < e(W) < 1` almost surely, when both weighted outcomes are integrable:
`E[Y(1) - Y(0)] = E[1{A = 1} Y / e(W) - 1{A = 0} Y / (1 - e(W))]`. -/
theorem ate_eq_ipw_of_meanIgnorable [IsFiniteMeasure μ] (hW : Measurable W) (hA : Measurable A)
    (hYi : ∀ a, Integrable (Y a) μ) (hps : IsPropensityScore μ A W e)
    (hmi : ∀ a, MeanIgnorable μ A W Y a) (hov : OverlapAE e (μ.map W))
    (hint : ∀ a, Integrable
      (fun ω => respInd (arm A a) ω * obsOutcome A Y ω / armProb e a (W ω)) μ) :
    ate μ Y = ∫ ω, (respInd (arm A true) ω * obsOutcome A Y ω / armProb e true (W ω) -
      respInd (arm A false) ω * obsOutcome A Y ω / armProb e false (W ω)) ∂μ := by
  have hpos := armProb_pos_of_ae (hov.ae_comp hW.aemeasurable)
  rw [ate_eq_armMean_sub (hYi true) (hYi false),
    armMean_eq_ipw_of_meanIgnorable hW hA hps true (hmi true) (hpos true) (hYi true) (hint true),
    armMean_eq_ipw_of_meanIgnorable hW hA hps false (hmi false) (hpos false) (hYi false)
      (hint false),
    integral_sub (hint true) (hint false)]

/-- Under the indicator form of ignorability, positivity of the arm and integrability of
`Y(a)`, the weighted outcome `1{A = a} Y / P(A = a | W)` is integrable. -/
theorem IndicatorIgnorable.integrable_ipw [IsFiniteMeasure μ] (hW : Measurable W)
    (hA : Measurable A) (hY : ∀ a, Measurable (Y a)) (hign : IndicatorIgnorable μ A W Y)
    (hps : IsPropensityScore μ A W e) (a : Bool) (hpos : ∀ᵐ ω ∂μ, 0 < armProb e a (W ω))
    (hYi : Integrable (Y a) μ) :
    Integrable (fun ω => respInd (arm A a) ω * obsOutcome A Y ω / armProb e a (W ω)) μ := by
  have h := MissingData.integrable_ipw hW (hY a) (measurable_arm hA a)
    (measurable_armProb hps.1 a) (hps.condExp_arm hW hA a) (hign.marMean hW hA hY a) hpos hYi
  refine h.congr (Filter.Eventually.of_forall fun ω => ?_)
  simp only [respInd_arm_mul_obsOutcome]

/-- **The weighting identity under the indicator form of ignorability.** Only positivity of the
arm and integrability of `Y(a)` are assumed: `E[1{A = a} Y / P(A = a | W)] = E[Y(a)]`. -/
theorem IndicatorIgnorable.armMean_eq_ipw [IsFiniteMeasure μ] (hW : Measurable W)
    (hA : Measurable A) (hY : ∀ a, Measurable (Y a)) (hign : IndicatorIgnorable μ A W Y)
    (hps : IsPropensityScore μ A W e) (a : Bool) (hpos : ∀ᵐ ω ∂μ, 0 < armProb e a (W ω))
    (hYi : Integrable (Y a) μ) :
    armMean μ Y a = ∫ ω, respInd (arm A a) ω * obsOutcome A Y ω / armProb e a (W ω) ∂μ :=
  armMean_eq_ipw_of_meanIgnorable hW hA hps a (hign.meanIgnorable hW hA hY a hYi) hpos hYi
    (hign.integrable_ipw hW hA hY hps a hpos hYi)

/-- **The weighting identity under ignorability** `A ⫫ (Y(0), Y(1)) | W`, with positivity of
the arm and integrability of `Y(a)`. -/
theorem Ignorable.armMean_eq_ipw [StandardBorelSpace Ω] [IsFiniteMeasure μ] (hW : Measurable W)
    (hA : Measurable A) (hY : ∀ a, Measurable (Y a)) (hign : Ignorable μ A hW Y)
    (hps : IsPropensityScore μ A W e) (a : Bool) (hpos : ∀ᵐ ω ∂μ, 0 < armProb e a (W ω))
    (hYi : Integrable (Y a) μ) :
    armMean μ Y a = ∫ ω, respInd (arm A a) ω * obsOutcome A Y ω / armProb e a (W ω) ∂μ :=
  ((ignorable_iff_indicatorIgnorable hW hA hY).1 hign).armMean_eq_ipw hW hA hY hps a hpos hYi

/-- **The weighting identity for the average effect under ignorability** and positivity
`0 < e(W) < 1` almost surely:
`E[Y(1) - Y(0)] = E[1{A = 1} Y / e(W) - 1{A = 0} Y / (1 - e(W))]`. -/
theorem Ignorable.ate_eq_ipw [StandardBorelSpace Ω] [IsFiniteMeasure μ] (hW : Measurable W)
    (hA : Measurable A) (hY : ∀ a, Measurable (Y a)) (hYi : ∀ a, Integrable (Y a) μ)
    (hign : Ignorable μ A hW Y) (hps : IsPropensityScore μ A W e)
    (hov : OverlapAE e (μ.map W)) :
    ate μ Y = ∫ ω, (respInd (arm A true) ω * obsOutcome A Y ω / armProb e true (W ω) -
      respInd (arm A false) ω * obsOutcome A Y ω / armProb e false (W ω)) ∂μ := by
  have hpos := armProb_pos_of_ae (hov.ae_comp hW.aemeasurable)
  have hii := (ignorable_iff_indicatorIgnorable hW hA hY).1 hign
  rw [ate_eq_armMean_sub (hYi true) (hYi false),
    hii.armMean_eq_ipw hW hA hY hps true (hpos true) (hYi true),
    hii.armMean_eq_ipw hW hA hY hps false (hpos false) (hYi false),
    integral_sub (hii.integrable_ipw hW hA hY hps true (hpos true) (hYi true))
      (hii.integrable_ipw hW hA hY hps false (hpos false) (hYi false))]

end PointTreatment

end CausalInference
